+    always_ff @(posedge clk_i or negedge rst_ni) begin
+        if (!rst_ni) begin
+            phase_q <= OFF;
+            error_q <= 0;
+            target_q <= 0;
+            expected_q <= 0;
+            segment_q <= 0;
+            index_q <= 0;
+            victim_q <= 0;
+            aggressor_q <= 0;
+            has_a_q <= 0;
+            batch_q <= 0;
+            path_q <= 0;
+            track_bad_q <= 0;
+            for (int i = 0; i < Count; i++) count_q[i] <= 0;
+            for (int i = 0; i < NumPorts; i++) begin reads_q[i] <= 0; writes_q[i] <= 0; end
+        end else begin
+            phase_q <= phase_n;
+            error_q <= error_n;
+            target_q <= target_n;
+            expected_q <= expected_n;
+            segment_q <= segment_n;
+            index_q <= index_n;
+            victim_q <= victim_n;
+            aggressor_q <= aggressor_n;
+            has_a_q <= has_a_n;
+            batch_q <= batch_n;
+            path_q <= path_n;
+            track_bad_q <= track_bad_n;
+            for (int i = 0; i < Count; i++) count_q[i] <= count_n[i];
+            for (int i = 0; i < NumPorts; i++) begin reads_q[i] <= reads_n[i]; writes_q[i] <= writes_n[i]; end
+        end
+    end
+endmodule
