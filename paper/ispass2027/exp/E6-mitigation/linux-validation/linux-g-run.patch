+/* Called after the actual drain and collection. An inconsistent live/issued
+ * inventory cannot establish quiet and therefore retains the lane buffers.
+ * An early but fully drained STOP may be quiet; it still cannot be valid G.
+ */
+static int idma_g_check_lanes(struct idma_stream *v, struct idma_stream *a,
+			    struct idma_g_context *g)
+{
+	struct idma_stream *lanes[] = { v, a };
+	unsigned int lane, nr = a ? 2 : 1;
+	int ret = 0;
+
+	for (lane = 0; lane < nr; lane++) {
+		struct idma_stream *s = lanes[lane];
+		u64 control = s->batch_configured ?
+			readq(s->idma->reg + IDMA_BATCH_CONTROL_OFFSET) : 0;
+
+		if (s->retain || s->in_flight || (control & 2) ||
+		    s->stats->submitted != s->stats->completed) {
+			if (!s->retain)
+				idma_quarantine(s);
+			g->request.retained_lane_mask |= BIT(lane);
+			ret = -EIO;
+			continue;
+		}
+		g->request.quiet_lane_mask |= BIT(lane);
+		if (control != 9 || s->stats->submitted != IDMA_G_TRANSFERS ||
+		    s->stats->completed != IDMA_G_TRANSFERS ||
+		    s->stats->completed_bytes != (u64)IDMA_G_TRANSFERS * IDMA_G_CHUNK_BYTES)
+			ret = -EIO;
+	}
+	return ret;
+}
