+/* Independent G warmup: exactly256 software COPY completions per lane. No
+ * autonomous batch or configured gap is active, and no measured counter moves.
+ */
+static int idma_g_warmup(struct idma_stream *v, struct idma_stream *a,
+			 u64 deadline, struct idma_g_context *g)
+{
+	struct idma_stream *lanes[] = { v, a };
+	unsigned int lane, nr = a ? 2 : 1;
+	int ret;
+
+	for (lane = 0; lane < nr; lane++) {
+		writeq(0, lanes[lane]->idma->reg + IDMA_BATCH_CONTROL_OFFSET);
+		if (readq(lanes[lane]->idma->reg + IDMA_BATCH_CONTROL_OFFSET) ||
+		    readq(lanes[lane]->idma->reg + IDMA_GAP_CYCLES_OFFSET))
+			return -EIO;
+	}
+	for (lane = 0; lane < nr; lane++) {
+		if (ktime_get_ns() >= deadline)
+			return -ETIMEDOUT;
+		if (signal_pending(current))
+			return -EINTR;
+		ret = idma_submit(lanes[lane], false);
+		if (ret)
+			return ret;
+	}
+	for (;;) {
+		if (ktime_get_ns() >= deadline)
+			return -ETIMEDOUT;
+		if (signal_pending(current))
+			return -EINTR;
+		for (lane = 0; lane < nr; lane++) {
+			if (g->request.warmup_completed[lane] == IDMA_G_WARMUP_TRANSFERS)
+				continue;
+			ret = idma_poll(lanes[lane], false);
+			if (ret < 0)
+				return ret;
+			if (ret == 1) {
+				g->request.warmup_completed[lane]++;
+				g->request.warmup_bytes[lane] += IDMA_G_CHUNK_BYTES;
+				if (g->request.warmup_completed[lane] < IDMA_G_WARMUP_TRANSFERS) {
+					ret = idma_submit(lanes[lane], false);
+					if (ret)
+						return ret;
+				}
+			}
+		}
+		if (g->request.warmup_completed[0] == IDMA_G_WARMUP_TRANSFERS &&
+		    (!a || g->request.warmup_completed[1] == IDMA_G_WARMUP_TRANSFERS))
+			return 0;
+		cond_resched();
+		cpu_relax();
+	}
+}
+
+/* Preserve A-before-V launch and V-first observation. Only G's new loop uses
+ * an unconditional cooperative scheduling point while V is unfinished.
+ */
+static int idma_g_batch_window(struct idma_stream *v, struct idma_stream *a,
+			 u64 deadline, u64 *end_ns, struct idma_g_context *g)
+{
+	struct idma_stream *lanes[] = { a, v };
+	unsigned int lane;
+	int ret;
+
+	g->start_ns = ktime_get_ns();
+	for (lane = a ? 0 : 1; lane < 2; lane++) {
+		if (ktime_get_ns() >= deadline) { ret = -ETIMEDOUT; goto out; }
+		if (signal_pending(current)) { ret = -EINTR; goto out; }
+		lanes[lane]->batch_started = true;
+		ret = idma_submit(lanes[lane], false);
+		if (ret)
+			goto out;
+		lanes[lane]->deadline_ns = deadline;
+	}
+	for (;;) {
+		if (ktime_get_ns() >= deadline) { ret = -ETIMEDOUT; break; }
+		if (signal_pending(current)) { ret = -EINTR; break; }
+		ret = idma_poll(v, false);
+		if (ret < 0)
+			break;
+		if (ret == 1) {
+			*end_ns = v->last_complete_ns;
+			return 0;
+		}
+		cond_resched();
+		cpu_relax();
+	}
+out:
+	*end_ns = ktime_get_ns();
+	return ret;
+}
+
+static int idma_g_wait_a(struct idma_stream *a, u64 deadline)
+{
+	int ret;
+
+	if (!a)
+		return 0;
+	for (;;) {
+		if (ktime_get_ns() >= deadline)
+			return -ETIMEDOUT;
+		if (signal_pending(current))
+			return -EINTR;
+		ret = idma_poll(a, false);
+		if (ret)
+			return ret == 1 ? 0 : ret;
+		cond_resched();
+		cpu_relax();
+	}
+}
