+/* Error cleanup only. Abort observation before STOP; neither action cancels
+ * DMA/AXI. Preserve actual counters and later establish quiet by real drain.
+ */
+static void idma_g_fail(struct idma_g_context *g, struct idma_observation *o,
+		       struct idma_stream *v, struct idma_stream *a)
+{
+	if (!g)
+		return;
+	if (o->control && o->armed && !g->abort_sent) {
+		writeq(2, o->control->reg + IDMA_OBS_CONTROL_OFFSET);
+		g->abort_sent = true;
+	}
+	if (!g->stop_sent) {
+		idma_batch_stop(v);
+		idma_batch_stop(a);
+		g->stop_sent = true;
+	}
+}
