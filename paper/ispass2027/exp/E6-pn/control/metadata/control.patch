From ad56c8a835724370d151ac5789b6c7cf1ba52a1a Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sun, 18 Oct 2026 03:33:24 +0900
Subject: [PATCH] Add standalone optional PN policy control bank

---
 corev_apu/fpga/src/dma_pn_control.sv | 81 ++++++++++++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 corev_apu/fpga/src/dma_pn_control.sv

diff --git a/corev_apu/fpga/src/dma_pn_control.sv b/corev_apu/fpga/src/dma_pn_control.sv
new file mode 100644
index 00000000..5a29ae37
--- /dev/null
+++ b/corev_apu/fpga/src/dma_pn_control.sv
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: Solderpad-0.51
+// Standalone PN bank. External facts establish eligibility; no data-path control.
+module dma_pn_control #(
+    parameter bit Enable = 0,
+    parameter bit HistoryControlEnable = 0
+) (
+    input logic clk_i, rst_ni,
+    input logic cfg_valid_i, cfg_write_i,
+    input logic [6:0] cfg_addr_i,
+    input logic [63:0] cfg_wdata_i,
+    input logic [7:0] cfg_wstrb_i, index_i,
+    input logic dataflow_quiet_i, obs_armed_i, obs_busy_i,
+    input logic capture_busy_i, certificate_fault_i, arm_accepted_i,
+    input logic [31:0] n_did10_i, n_did11_i,
+    input logic [63:0] aown_cycles_i, union_cycles_i,
+    input logic [7:0] capture_flags_i,
+    output logic [2:0] mode_word_o,
+    output logic policy_clear_o,
+    output logic [63:0] bank_rdata_o,
+    output logic bank_selected_o
+);
+    if (Enable) begin : gen_enabled
+        logic [2:0] mode_word_q;
+        logic last_rejected_q;
+        logic write_intent, legal_word, eligible, accepted_write;
+
+        assign write_intent = cfg_valid_i && cfg_write_i &&
+                              cfg_addr_i == 7'h78 && index_i == 8'd193;
+        assign legal_word = cfg_wdata_i <= 64'd3 ||
+                            (HistoryControlEnable && cfg_wdata_i == 64'd6);
+        // Never feed policy_clear or capture_busy back into dataflow_quiet.
+        assign eligible = dataflow_quiet_i && !obs_armed_i && !obs_busy_i &&
+                          !capture_busy_i && !certificate_fault_i && !arm_accepted_i;
+        assign accepted_write = write_intent && (&cfg_wstrb_i) && legal_word && eligible;
+        assign policy_clear_o = rst_ni && accepted_write;
+        assign mode_word_o = mode_word_q;
+        assign bank_selected_o = index_i >= 8'd192 && index_i <= 8'd199;
+
+        always_comb begin
+            bank_rdata_o = '0;
+            case (index_i)
+                8'd192: bank_rdata_o = 64'h49444d41504e0001;
+                8'd193: bank_rdata_o = {61'b0, mode_word_q};
+                8'd194: begin
+                    bank_rdata_o[0] = eligible;
+                    bank_rdata_o[1] = last_rejected_q;
+                    bank_rdata_o[2] = certificate_fault_i;
+                    bank_rdata_o[3] = capture_busy_i;
+                    bank_rdata_o[4] = dataflow_quiet_i;
+                    bank_rdata_o[5] = obs_busy_i;
+                    bank_rdata_o[63] = HistoryControlEnable;
+                end
+                8'd195: bank_rdata_o = {32'b0, n_did10_i};
+                8'd196: bank_rdata_o = {32'b0, n_did11_i};
+                8'd197: bank_rdata_o = aown_cycles_i;
+                8'd198: bank_rdata_o = union_cycles_i;
+                8'd199: bank_rdata_o = {56'b0, capture_flags_i};
+                default: ;
+            endcase
+        end
+
+        always_ff @(posedge clk_i or negedge rst_ni) begin
+            if (!rst_ni) begin
+                mode_word_q <= '0;
+                last_rejected_q <= 1'b0;
+            end else if (write_intent) begin
+                if (accepted_write) begin
+                    mode_word_q <= cfg_wdata_i[2:0];
+                    last_rejected_q <= 1'b0;
+                end else begin
+                    last_rejected_q <= 1'b1;
+                end
+            end
+        end
+    end else begin : gen_disabled
+        assign mode_word_o = '0;
+        assign policy_clear_o = 1'b0;
+        assign bank_rdata_o = '0;
+        assign bank_selected_o = 1'b0;
+    end
+endmodule
