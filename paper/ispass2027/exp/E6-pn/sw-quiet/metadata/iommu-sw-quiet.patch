     input  logic                rst_ni,
@@ -41,7 +42,8 @@ import rv_iommu_reg_pkg::*;
     // Response port
     input  dbg_resp_t       resp_data_i,
     input  logic            resp_valid_i,
-    output logic            resp_ready_o
+    output logic            resp_ready_o,
+    output logic pn_idle_o
 );
 
     typedef enum logic { 
@@ -121,4 +123,13 @@ import rv_iommu_reg_pkg::*;
         end
     end
     
+
+    // Passive PN eligibility tap; never feeds the original functional logic.
+    if (PnEnable) begin : gen_pn_idle
+        assign pn_idle_o = rst_ni && ((state_q == IDLE) && !dbg_ctl_i.go.q
+        && !req_valid_o && !resp_valid_i);
+    end else begin : gen_pn_idle_disabled
+        assign pn_idle_o = 1'b0;
+    end
+
 endmodule
