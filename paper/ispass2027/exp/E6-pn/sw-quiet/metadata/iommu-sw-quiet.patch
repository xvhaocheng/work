From 0dbd526040326d3076a3689e469041429c7a530f Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sun, 18 Oct 2026 04:00:15 +0900
Subject: [PATCH] iommu: export passive SW and program quiet facts

---
 rtl/ext_interfaces/rv_iommu_prog_if.sv        | 23 ++++-
 .../regmap/rv_iommu_regmap.sv                 | 14 +++-
 rtl/software_interface/rv_iommu_cq_handler.sv | 21 ++++-
 rtl/software_interface/rv_iommu_dbg_if_ctl.sv | 15 +++-
 .../rv_iommu_fault_arbiter.sv                 | 15 +++-
 rtl/software_interface/rv_iommu_fq_handler.sv | 16 +++-
 rtl/software_interface/rv_iommu_msi_ig.sv     | 17 +++-
 rtl/software_interface/rv_iommu_pq_handler.sv | 16 +++-
 rtl/software_interface/rv_iommu_sw_if_wrap.sv | 84 +++++++++++++++----
 vendor/modified/rv_iommu_axi2apb_64_32.sv     | 17 +++-
 10 files changed, 202 insertions(+), 36 deletions(-)

diff --git a/rtl/ext_interfaces/rv_iommu_prog_if.sv b/rtl/ext_interfaces/rv_iommu_prog_if.sv
index 7c13841..1f05ebb 100644
--- a/rtl/ext_interfaces/rv_iommu_prog_if.sv
+++ b/rtl/ext_interfaces/rv_iommu_prog_if.sv
@@ -31,7 +31,8 @@ module rv_iommu_prog_if #(
     parameter type axi_resp_t       = logic,
     /// Register data types
     parameter type iommu_reg_req_t  = logic,
-    parameter type iommu_reg_rsp_t  = logic
+    parameter type iommu_reg_rsp_t  = logic,
+    parameter bit PnEnable = 1'b0
 ) (
     input  logic     clk_i,
     input  logic     rst_ni,
@@ -42,7 +43,8 @@ module rv_iommu_prog_if #(
 
     // To register map
     output iommu_reg_req_t  regmap_req_o,
-    input  iommu_reg_rsp_t  regmap_resp_i
+    input  iommu_reg_rsp_t  regmap_resp_i,
+    output logic pn_idle_o
 );
 
     logic                                   penable;
@@ -62,7 +64,8 @@ module rv_iommu_prog_if #(
         .AXI4_ID_WIDTH      (RVIOMMUCfg.AxiProgIdWidth),
         .AXI4_USER_WIDTH    (RVIOMMUCfg.AxiUserWidth),
         .BUFF_DEPTH_SLAVE   (2),
-        .APB_ADDR_WIDTH     (RVIOMMUCfg.AxiAddrWidth)
+        .APB_ADDR_WIDTH     (RVIOMMUCfg.AxiAddrWidth),
+        .PnEnable (PnEnable)
     ) i_axi2apb_64_32_iommu (
         .clk_i     (clk_i),
         .rst_ni    (rst_ni),
@@ -124,7 +127,8 @@ module rv_iommu_prog_if #(
         .PWDATA    (pwdata),
         .PRDATA    (prdata),
         .PREADY    (pready),
-        .PSLVERR   (pslverr)
+        .PSLVERR   (pslverr),
+        .pn_idle_o (pn_bridge_idle)
     );
 
     // Reg req
@@ -298,4 +302,15 @@ module rv_iommu_prog_if #(
     `REG_BUS_ASSIGN_TO_REQ(regmap_req_o, iommu_reg_bus)
     `REG_BUS_ASSIGN_FROM_RSP(iommu_reg_bus, regmap_resp_i)
 */
+
+    // Passive PN eligibility tap; never feeds the original functional logic.
+    logic pn_bridge_idle;
+    if (PnEnable) begin : gen_pn_idle
+        assign pn_idle_o = rst_ni && (pn_bridge_idle && !regmap_req_o.valid
+        && !prog_req_i.aw_valid && !prog_req_i.w_valid && !prog_req_i.ar_valid
+        && !prog_resp_o.r_valid && !prog_resp_o.b_valid);
+    end else begin : gen_pn_idle_disabled
+        assign pn_idle_o = 1'b0;
+    end
+
 endmodule
diff --git a/rtl/software_interface/regmap/rv_iommu_regmap.sv b/rtl/software_interface/regmap/rv_iommu_regmap.sv
index cbe5997..1ef4662 100644
--- a/rtl/software_interface/regmap/rv_iommu_regmap.sv
+++ b/rtl/software_interface/regmap/rv_iommu_regmap.sv
@@ -28,7 +28,8 @@ module rv_iommu_regmap #(
 
   /// Register data types
   parameter type iommu_reg_req_t  = logic,
-  parameter type iommu_reg_rsp_t  = logic
+  parameter type iommu_reg_rsp_t  = logic,
+  parameter bit PnEnable = 1'b0
   ) (
   input  logic      clk_i,
   input  logic      rst_ni,
@@ -40,7 +41,8 @@ module rv_iommu_regmap #(
   input  rv_iommu_reg_pkg::iommu_hw2reg_t hw2reg_i,
 
   input  logic devmode_i,   // If 1, explicit error return for unmapped register access
-  input  logic in_flight_i  // The IOMMU is currently processing a translation
+  input  logic in_flight_i, // The IOMMU is currently processing a translation
+  output logic pn_idle_o
 );
 
   import rv_iommu_reg_pkg::* ;
@@ -3944,4 +3946,12 @@ module rv_iommu_regmap #(
   // Assertions for Register Interface
   `ASSERT(en2addrHit, (reg_we || reg_re) |-> $onehot0(addr_hit))
 
+
+  // Passive tap includes deferred DDTP writes, after the program response retires.
+  if (PnEnable) begin : gen_pn_idle
+    assign pn_idle_o = rst_ni && !write_l_q && !write_h_q && !reg_req_i.valid;
+  end else begin : gen_pn_idle_disabled
+    assign pn_idle_o = 1'b0;
+  end
+
 endmodule
diff --git a/rtl/software_interface/rv_iommu_cq_handler.sv b/rtl/software_interface/rv_iommu_cq_handler.sv
index cee8a1c..e4b53b6 100644
--- a/rtl/software_interface/rv_iommu_cq_handler.sv
+++ b/rtl/software_interface/rv_iommu_cq_handler.sv
@@ -31,7 +31,8 @@ module rv_iommu_cq_handler
 
     /// AXI data types
     parameter type axi_req_t    = logic,
-    parameter type axi_resp_t   = logic
+    parameter type axi_resp_t   = logic,
+    parameter bit PnEnable = 1'b0
 ) (
     input  logic clk_i,
     input  logic rst_ni,
@@ -99,7 +100,8 @@ module rv_iommu_cq_handler
 
     // Memory Bus
     input  axi_resp_t   mem_resp_i,
-    output axi_req_t    mem_req_o
+    output axi_req_t    mem_req_o,
+    output logic pn_idle_o
 );
 
     localparam int unsigned PLEN = RVIOMMUCfg.PAddrWidth;
@@ -526,4 +528,19 @@ module rv_iommu_cq_handler
         end
     end
 
+
+    // Passive PN eligibility tap; never feeds the original functional logic.
+    if (PnEnable) begin : gen_pn_idle
+        assign pn_idle_o = rst_ni && ((state_q == IDLE) && (cqcsr_en_i == cq_en_q)
+        && ((cq_tail_i & idx_mask) == cq_head_i)
+        && !mem_req_o.ar_valid && !mem_req_o.aw_valid && !mem_req_o.w_valid
+        && !mem_resp_i.r_valid && !mem_resp_i.b_valid
+        && !iotinval_o.inval_vma && !iotinval_o.inval_gvma
+        && !iodirinval_o.inval_ddtc && !iodirinval_o.inval_pdtc
+        && !atsinval_valid_o && !atsprgr_valid_o && !ats_fence_valid_o
+        && !atsinval_inflight_i);
+    end else begin : gen_pn_idle_disabled
+        assign pn_idle_o = 1'b0;
+    end
+
 endmodule
diff --git a/rtl/software_interface/rv_iommu_dbg_if_ctl.sv b/rtl/software_interface/rv_iommu_dbg_if_ctl.sv
index 6df2399..52172d5 100644
