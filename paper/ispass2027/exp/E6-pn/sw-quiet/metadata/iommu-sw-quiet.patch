@@ -37,7 +38,8 @@ module rv_iommu_fault_arbiter #(
     // Output FQ record port
     output rv_iommu::fq_record_t                fq_data_o,
     output logic                                fq_valid_o,
-    input  logic                                fq_ready_i
+    input  logic                                fq_ready_i,
+    output logic pn_idle_o
 );
 
     fault_data_t [(NumFaultPorts-1):0]  fault_data_q;
@@ -137,4 +139,13 @@ module rv_iommu_fault_arbiter #(
         end
     end
 
+
+    // Passive PN eligibility tap; never feeds the original functional logic.
+    if (PnEnable) begin : gen_pn_idle
+        assign pn_idle_o = rst_ni && (!(|fault_valid_i) && !(|fault_valid_q)
+        && !arbited_valid_d && !arbited_valid_q && !fq_valid_o);
+    end else begin : gen_pn_idle_disabled
+        assign pn_idle_o = 1'b0;
+    end
+
