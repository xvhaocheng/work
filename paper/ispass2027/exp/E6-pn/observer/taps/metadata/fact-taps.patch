From e36194cbff516a1ee803ddc2fa97cd1043403f09 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sun, 18 Oct 2026 03:23:12 +0900
Subject: [PATCH] Expose optional passive observer and frontend fact taps

---
 corev_apu/fpga/src/dma_observer.sv            | 22 +++++++++++++++++--
 .../register_64bit/idma_reg64_frontend.sv     | 10 +++++++--
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/corev_apu/fpga/src/dma_observer.sv b/corev_apu/fpga/src/dma_observer.sv
index 8b777369..c4a0cd36 100644
--- a/corev_apu/fpga/src/dma_observer.sv
+++ b/corev_apu/fpga/src/dma_observer.sv
@@ -5,7 +5,8 @@ module dma_observer #(
     parameter int unsigned CounterWidth = 64,
     parameter int unsigned OutstandingWidth = 8,
     parameter bit PathEnable = 0,
-    parameter int AxiIdWidth = 4
+    parameter int AxiIdWidth = 4,
+    parameter bit PnTapEnable = 1'b0
 ) (
     input logic clk_i, rst_ni,
     input logic cfg_valid_i, cfg_write_i,
@@ -23,7 +24,10 @@ module dma_observer #(
     input logic shared_ar_valid_i, shared_aw_valid_i,
     input logic shared_ar_ready_i, shared_aw_ready_i,
     input logic [AxiIdWidth-1:0] tr_id_i [2], out_id_i [2], return_id_i [2],
-    input logic [1:0] out_valid_i, out_ready_i, return_i
+    input logic [1:0] out_valid_i, out_ready_i, return_i,
+    output logic pn_arm_accepted_o,
+    output logic [1:0] pn_victim_o, pn_aggressor_o,
+    output logic pn_has_a_o, pn_active_o, pn_v_target_done_o, pn_armed_o, pn_busy_o
 );
     // Low byte is interface version; a missing observer must never look valid.
     localparam logic [63:0] Magic = PathEnable ? 64'h49444d414f425303 : 64'h49444d414f425302;
@@ -45,6 +49,16 @@ module dma_observer #(
     logic active, v_pending, a_pending;
     logic path_q, path_n, path_arm, path_clear, path_error, path_idle;
     logic [63:0] path_data;
+    logic pn_arm_accepted, pn_v_target_done;
+    // Facts only: none of these taps feed the original observer or DMA path.
+    assign pn_arm_accepted_o = PnTapEnable && pn_arm_accepted;
+    assign pn_victim_o = PnTapEnable ? victim_n : 2'b00;
+    assign pn_aggressor_o = PnTapEnable ? aggressor_n : 2'b00;
+    assign pn_has_a_o = PnTapEnable && has_a_n;
+    assign pn_active_o = PnTapEnable && active;
+    assign pn_v_target_done_o = PnTapEnable && pn_v_target_done;
+    assign pn_armed_o = PnTapEnable && phase_q == ARMED;
+    assign pn_busy_o = PnTapEnable && busy;
     assign path_idle = !(|reads_q[victim_n] || |writes_q[victim_n] ||
         ar_valid_i[victim_n] || aw_valid_i[victim_n] ||
         (has_a_n && (|reads_q[aggressor_n] || |writes_q[aggressor_n] ||
@@ -115,6 +129,8 @@ module dma_observer #(
         path_n = path_q;
         path_arm = 0;
         path_clear = 0;
+        pn_arm_accepted = 0;
+        pn_v_target_done = 0;
         track_bad_n = track_bad_q;
         // Track continuously, including warmup and drain, never reset on ARM.
         for (int i = 0; i < NumPorts; i++) begin
@@ -198,6 +214,7 @@ module dma_observer #(
                         segment_n = 0;
                         if (batch_q) begin
                             if (64'(count_n[8]) == target_q) begin
+                                pn_v_target_done = 1;
                                 phase_n = BATCH_READ;
                                 count_n[32] = CounterWidth'((CounterWidth'(reads_n[victim_q]) << 16) | CounterWidth'(writes_n[victim_q]));
                                 count_n[33] = has_a_q ? CounterWidth'((CounterWidth'(reads_n[aggressor_q]) << 16) | CounterWidth'(writes_n[aggressor_q])) : '0;
@@ -258,6 +275,7 @@ module dma_observer #(
                                  int'(cfg_wdata_i[9:8]) < NumPorts && int'(cfg_wdata_i[17:16]) < NumPorts &&
                                  (!cfg_wdata_i[24] || cfg_wdata_i[9:8] != cfg_wdata_i[17:16])) begin
                         phase_n = ARMED;
+                        pn_arm_accepted = 1;
                         error_n = 0;
                         victim_n = cfg_wdata_i[9:8];
                         aggressor_n = cfg_wdata_i[17:16];
diff --git a/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv b/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
index b2b718fb..1ed32eeb 100644
--- a/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
+++ b/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
@@ -23,7 +23,8 @@ module idma_reg64_frontend #(
     parameter int unsigned  AxiIdWidth       = 32'd0,
     /// AXI AxID
     parameter logic [(AxiIdWidth-1):0] AxID  = 0,
-    parameter bit PnGapEnable = 1'b0
+    parameter bit PnGapEnable = 1'b0,
+    parameter bit PnTapEnable = 1'b0
 ) (
     input  logic          clk_i,
     input  logic          rst_ni,
@@ -49,7 +50,8 @@ module idma_reg64_frontend #(
     output logic [1:0]    ttype_o,
     output logic [63:0]   wdata_o,
     input  logic [63:0]   rdata_i,
-    input  logic          rdata_valid_i
+    input  logic          rdata_valid_i,
+    output logic          pn_stop_accepted_o, pn_frontend_quiet_o
 );
 
     localparam int unsigned DmaRegisterWidth = 64;
@@ -106,6 +108,10 @@ module idma_reg64_frontend #(
     assign batch_task_done = batch_active_o && state_q == WAIT && trans_complete_i;
     assign batch_stop_request = batch_access && dma_ctrl_req_i.write &&
         dma_ctrl_req_i.wstrb == 8'hff && full_addr == 8'h88 && dma_ctrl_req_i.wdata == 2;
+    // Per-port accepted STOP; selected-role filtering belongs to the caller.
+    assign pn_stop_accepted_o = PnTapEnable && batch_stop_request;
+    assign pn_frontend_quiet_o = PnTapEnable && state_q == IDLE &&
+        !valid_o && !issue && !batch_active_o;
 
     // The high 128-byte bank is explicitly decoded; the old register file remains 7-bit.
     // Configuration is immutable while active. STOP drains the currently offered task.
