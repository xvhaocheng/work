From b44dc2d283b370f70c46ef53b631d1cb13b3b547 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sun, 18 Oct 2026 04:08:07 +0900
Subject: [PATCH] Forward optional frontend tap and gap ports through AXI
 interface wrapper

---
 corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv b/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv
index 03807dc9..08d68bfc 100644
--- a/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv
+++ b/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv
@@ -488,7 +488,9 @@ module dma_core_wrap_intf #(
   parameter logic [23:0]               DEVICE_ID          = 24'd1,
   parameter logic [19:0]               PROCESS_ID         = 20'd0,
   parameter logic [(AXI_ID_WIDTH-1):0] AxID               =     0,
-  parameter bit PnEnable = 1'b0
+  parameter bit PnEnable = 1'b0,
+  parameter bit PnTapEnable = 1'b0,
+  parameter bit PnGapEnable = 1'b0
 ) (
   input  logic         clk_i,
   input  logic         rst_ni,
@@ -506,7 +508,8 @@ module dma_core_wrap_intf #(
   AXI_BUS.Slave        axi_slave,
   input logic pn_nonblock_enable_i = 1'b0,
   output logic pn_fullbuffer_permit_o, pn_backend_job_quiet_o,
-  output logic pn_certificate_pending_o, pn_certificate_fault_o
+  output logic pn_certificate_pending_o, pn_certificate_fault_o,
+  output logic pn_stop_accepted_o, pn_frontend_quiet_o
 );
 
   typedef logic [AXI_ADDR_WIDTH-1:0]     addr_t;
@@ -554,7 +557,9 @@ module dma_core_wrap_intf #(
     .DEVICE_ID        ( DEVICE_ID          ),
     .PROCESS_ID       ( PROCESS_ID         ),
     .AxID             ( AxID               ),
-    .PnEnable         ( PnEnable           )
+    .PnEnable         ( PnEnable           ),
+    .PnTapEnable      ( PnTapEnable        ),
+    .PnGapEnable      ( PnGapEnable        )
   ) i_dma_core_wrap (
       .obs_issue_o, .obs_done_o, .obs_poll_o, .batch_active_o,
       .obs_issue_id_o, .obs_done_id_o, .obs_poll_id_o,
@@ -565,6 +570,7 @@ module dma_core_wrap_intf #(
     .testmode_i,
     .pn_nonblock_enable_i, .pn_fullbuffer_permit_o, .pn_backend_job_quiet_o,
     .pn_certificate_pending_o, .pn_certificate_fault_o,
+    .pn_stop_accepted_o, .pn_frontend_quiet_o,
     .axi_mst_req_o ( axi_mst_req  ),
     .axi_mst_rsp_i ( axi_mst_resp ),
     .axi_slv_req_i ( axi_slv_req  ),
-- 
2.34.1

