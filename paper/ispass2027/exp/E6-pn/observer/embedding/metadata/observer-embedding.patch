From a3242fb96145f6807241482acdde659aa2ab5612 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sun, 18 Oct 2026 03:48:40 +0900
Subject: [PATCH] Embed optional PN capture and control in original observer

---
 corev_apu/fpga/src/dma_observer.sv | 50 +++++++++++++++++++++++++++---
 1 file changed, 46 insertions(+), 4 deletions(-)

diff --git a/corev_apu/fpga/src/dma_observer.sv b/corev_apu/fpga/src/dma_observer.sv
index c4a0cd36..b1397b04 100644
--- a/corev_apu/fpga/src/dma_observer.sv
+++ b/corev_apu/fpga/src/dma_observer.sv
@@ -6,7 +6,9 @@ module dma_observer #(
     parameter int unsigned OutstandingWidth = 8,
     parameter bit PathEnable = 0,
     parameter int AxiIdWidth = 4,
-    parameter bit PnTapEnable = 1'b0
+    parameter bit PnTapEnable = 1'b0,
+    parameter bit PnEnable = 1'b0,
+    parameter bit HistoryControlEnable = 1'b0
 ) (
     input logic clk_i, rst_ni,
     input logic cfg_valid_i, cfg_write_i,
@@ -27,7 +29,13 @@ module dma_observer #(
     input logic [1:0] out_valid_i, out_ready_i, return_i,
     output logic pn_arm_accepted_o,
     output logic [1:0] pn_victim_o, pn_aggressor_o,
-    output logic pn_has_a_o, pn_active_o, pn_v_target_done_o, pn_armed_o, pn_busy_o
+    output logic pn_has_a_o, pn_active_o, pn_v_target_done_o, pn_armed_o, pn_busy_o,
+    input logic pn_dataflow_quiet_i, pn_certificate_fault_i,
+    input logic [NumPorts-1:0] pn_stop_accepted_i,
+    input logic pn_n_accept_i,
+    input logic [23:0] pn_n_did_i,
+    output logic [2:0] pn_mode_word_o,
+    output logic pn_policy_clear_o, pn_private_quiet_o, pn_capture_busy_o
 );
     // Low byte is interface version; a missing observer must never look valid.
     localparam logic [63:0] Magic = PathEnable ? 64'h49444d414f425303 : 64'h49444d414f425302;
@@ -59,6 +67,36 @@ module dma_observer #(
     assign pn_v_target_done_o = PnTapEnable && pn_v_target_done;
     assign pn_armed_o = PnTapEnable && phase_q == ARMED;
     assign pn_busy_o = PnTapEnable && busy;
+    logic [63:0] pn_bank_data, pn_aown, pn_union, pn_status;
+    logic [31:0] pn_n10, pn_n11;
+    logic pn_bank_selected, pn_selected_stop;
+    assign pn_selected_stop = pn_stop_accepted_i[victim_q] ||
+                             (has_a_q && pn_stop_accepted_i[aggressor_q]);
+    always_comb begin
+        pn_private_quiet_o = PnEnable && !(|track_bad_q) &&
+                             !(|ar_valid_i) && !(|aw_valid_i);
+        for (int i = 0; i < NumPorts; i++)
+            pn_private_quiet_o = pn_private_quiet_o && !(|reads_q[i]) && !(|writes_q[i]);
+    end
+    dma_pn_observer #(.Enable(PnEnable), .NumPorts(NumPorts)) i_pn_capture (
+        .clk_i, .rst_ni, .accepted_arm_i(pn_arm_accepted),
+        .has_a_i(has_a_n), .victim_i(victim_n), .aggressor_i(aggressor_n),
+        .issue_i, .done_i, .batch_active_i, .accepted_stop_i(pn_selected_stop),
+        .obs_active_i(active), .v_target_done_i(pn_v_target_done),
+        .all_quiet_i(pn_dataflow_quiet_i), .n_accept_i(pn_n_accept_i), .n_did_i(pn_n_did_i),
+        .aown_cycles_o(pn_aown), .union_cycles_o(pn_union), .status_o(pn_status),
+        .n_did10_o(pn_n10), .n_did11_o(pn_n11), .capture_busy_o(pn_capture_busy_o)
+    );
+    dma_pn_control #(.Enable(PnEnable), .HistoryControlEnable(HistoryControlEnable)) i_pn_control (
+        .clk_i, .rst_ni, .cfg_valid_i, .cfg_write_i, .cfg_addr_i, .cfg_wdata_i, .cfg_wstrb_i,
+        .index_i(index_q), .dataflow_quiet_i(pn_dataflow_quiet_i),
+        .obs_armed_i(phase_q == ARMED), .obs_busy_i(busy), .capture_busy_i(pn_capture_busy_o),
+        .certificate_fault_i(pn_certificate_fault_i), .arm_accepted_i(pn_arm_accepted),
+        .n_did10_i(pn_n10), .n_did11_i(pn_n11), .aown_cycles_i(pn_aown),
+        .union_cycles_i(pn_union), .capture_flags_i(pn_status[7:0]),
+        .mode_word_o(pn_mode_word_o), .policy_clear_o(pn_policy_clear_o),
+        .bank_rdata_o(pn_bank_data), .bank_selected_o(pn_bank_selected)
+    );
     assign path_idle = !(|reads_q[victim_n] || |writes_q[victim_n] ||
         ar_valid_i[victim_n] || aw_valid_i[victim_n] ||
         (has_a_n && (|reads_q[aggressor_n] || |writes_q[aggressor_n] ||
@@ -110,6 +148,7 @@ module dma_observer #(
             7'h70: cfg_rdata_o = 64'(index_q);
             7'h78: if (int'(index_q) < Count) cfg_rdata_o = 64'(count_q[index_q]);
                    else if (PathEnable && index_q >= 64 && index_q < 192) cfg_rdata_o = path_data;
+                   else if (PnEnable && pn_bank_selected) cfg_rdata_o = pn_bank_data;
             default: ;
         endcase
     end
@@ -252,13 +291,16 @@ module dma_observer #(
             endcase
         end
 
-        if (cfg_valid_i && cfg_write_i) begin
+        // PN DATA writes belong only to the independent bank. Read-only PN
+        // words ignore any strobe; MODE rejection never alters old OBS errors.
+        if (cfg_valid_i && cfg_write_i && !(PnEnable && cfg_addr_i == 7'h78 && pn_bank_selected)) begin
             if (cfg_wstrb_i != 8'hff) error_n[0] = 1'b1;
             else case (cfg_addr_i)
                 7'h68: if (!busy && phase_q != ARMED) target_n = cfg_wdata_i;
                          else error_n[0] = 1'b1;
                 7'h70: if (cfg_wdata_i < 64'(Count) ||
-                          (PathEnable && cfg_wdata_i >= 64 && cfg_wdata_i < 192)) index_n = cfg_wdata_i[7:0];
+                          (PathEnable && cfg_wdata_i >= 64 && cfg_wdata_i < 192) ||
+                          (PnEnable && cfg_wdata_i >= 192 && cfg_wdata_i < 200)) index_n = cfg_wdata_i[7:0];
                          else error_n[0] = 1'b1;
                 7'h60: begin
                     if (cfg_wdata_i == 2) begin // Abort observation, never DMA.
