     localparam int unsigned PLEN = RVIOMMUCfg.PAddrWidth;
@@ -98,6 +100,7 @@ module rv_iommu_msiptw #(
 
     // Trigger MRIF-MSI FSM
     logic init_msi_mrif;
+    logic pn_mrif_idle;
 
     // Registers to propagate first-stage data
     logic [(rv_iommu::GPPNW39-1):0]   vpn_q,         vpn_n;
@@ -359,6 +362,7 @@ module rv_iommu_msiptw #(
     if (RVIOMMUCfg.MSITrans == rv_iommu_cfg::MSI_BT_MRIF) begin : gen_mrif_support
 
         state_mrif_t mrif_state_q, mrif_state_n;
+        assign pn_mrif_idle = (mrif_state_q == MRIF_PTE);
 
         // Read ports
         rv_iommu::msi_pte_mrif_t msi_pte_mrif;
@@ -493,6 +497,7 @@ module rv_iommu_msiptw #(
 
     // MRIF support disabled
     else begin : gen_mrif_support_disabled
+        assign pn_mrif_idle = 1'b1;
 
         assign mrifc_update_o   = '0;
         assign ignore_o         = 1'b0;
@@ -502,4 +507,16 @@ module rv_iommu_msiptw #(
     end
     endgenerate
 
+    if (PnEnable) begin : gen_pn_idle
+        // Successful BT/ignored MRIF can be locally idle before RLAST returns.
+        // The separate DS transport guard must still cover that external debt.
+        assign pn_idle_o = (bt_state_q == IDLE) && pn_mrif_idle &&
+            !(init_msi_ptw_i || init_msi_mrif || iotlb_update_o.update ||
+              mrifc_update_o.update || error_o || ignore_o ||
+              mem_req_o.aw_valid || mem_req_o.ar_valid || mem_req_o.w_valid ||
+              mem_resp_i.b_valid || mem_resp_i.r_valid);
+    end else begin : gen_no_pn_idle
+        assign pn_idle_o = 1'b0;
+    end
+
 endmodule
