From 0d0ff6b3794853c57ed241ca5303e434995e8167 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sun, 18 Oct 2026 03:03:31 +0900
Subject: [PATCH] observer: isolate depth64 timestamp storage for distributed
 RAM

---
 corev_apu/fpga/src/dma_path_observer.sv | 26 +++++++++++++++++++++----
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/corev_apu/fpga/src/dma_path_observer.sv b/corev_apu/fpga/src/dma_path_observer.sv
index 2ba49c24..cb71da33 100644
--- a/corev_apu/fpga/src/dma_path_observer.sv
+++ b/corev_apu/fpga/src/dma_path_observer.sv
@@ -27,6 +27,22 @@ module dma_path_stage #(
     logic [PtrWidth:0] opening_q, closing_q;
     logic matched, whole, bad;
     logic [SumWidth:0] sum_next, area_next;
+    logic [TimeWidth-1:0] head_stamp;
+    logic head_born;
+
+    if (Depth == 64) begin : gen_queue_ram
+        // Independent write address and asynchronous old-head read. This
+        // passive storage has no reset; reset/clear invalidate the pointers.
+        (* ram_style = "distributed" *) logic [TimeWidth:0] entries [Depth];
+        always_ff @(posedge clk_i) begin
+            if (rst_ni && !clear_i && run_i && !bad && enter_i)
+                entries[tail_q] <= {active_i, time_i};
+        end
+        assign {head_born, head_stamp} = entries[head_q];
+    end else begin : gen_queue_registers
+        assign head_stamp = stamps[head_q];
+        assign head_born = born_in_window[head_q];
+    end
 
     // Scheme 1: 0, 1, [2,3], [4,7], ...; the final bin includes both
     // [2^30,2^31-1] and [2^31,2^32-1]. It is never an exact tail quantile.
@@ -62,8 +78,8 @@ module dma_path_stage #(
         bad = (leave_i && !matched) || (enter_i && count_q == Depth && !leave_i);
         if (enter_i && !leave_i) count_next = count_q + 1'b1;
         if (leave_i && !enter_i) count_next = count_q - 1'b1;
-        age = count_q == 0 ? '0 : time_i - stamps[head_q];
-        whole = count_q == 0 ? active_i : born_in_window[head_q];
+        age = count_q == 0 ? '0 : time_i - head_stamp;
+        whole = count_q == 0 ? active_i : head_born;
         sum_next = {1'b0, sum_q} + (SumWidth+1)'(age);
         area_next = {1'b0, area_q} + (SumWidth+1)'(count_q);
         data_o[0] = 64'(entered_q);
@@ -92,8 +108,10 @@ module dma_path_stage #(
             if (!bad) begin
                 count_q <= count_next;
                 if (enter_i) begin
-                    stamps[tail_q] <= time_i;
-                    born_in_window[tail_q] <= active_i;
+                    if (Depth != 64) begin
+                        stamps[tail_q] <= time_i;
+                        born_in_window[tail_q] <= active_i;
+                    end
                     tail_q <= tail_q + 1'b1;
                 end
                 if (leave_i) head_q <= head_q + 1'b1;
-- 
2.34.1

