tage #(\n             if (!bad) begin\n                 count_q <= count_next;\n                 if (enter_i) begin\n-                    stamps[tail_q] <= time_i;\n-                    born_in_window[tail_q] <= active_i;\n+                    if (Depth != 64) begin\n+                        stamps[tail_q] <= time_i;\n+                        born_in_window[tail_q] <= active_i;\n+                    end\n                     tail_q <= tail_q + 1'b1;\n                 end\n                 if (leave_i) head_q <= head_q + 1'b1;\n",
