 #define IDMA_OBS_MAGIC_V4 0x49444d414f425304ULL
+#define IDMA_OBS_MAGIC_V5 0x49444d414f425305ULL
 #define IDMA_OBS_VALUES 34
 #define IDMA_BATCH_MAGIC_OFFSET 0x80
