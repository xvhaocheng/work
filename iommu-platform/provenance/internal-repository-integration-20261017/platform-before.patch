+        except UnicodeDecodeError as exc:
+            raise RuntimeError(f'Workspace overlay source is not UTF-8 text: {raw}') from exc
+        overlay.append({'path': rel_str, 'sha256': hashlib.sha256(raw_bytes).hexdigest(), 'size': len(raw_bytes)})
