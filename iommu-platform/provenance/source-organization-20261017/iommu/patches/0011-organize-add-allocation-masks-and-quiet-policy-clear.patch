From b35d23078036e4ce6e22c728b303b68a3fe9d56f Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:50:27 +0900
Subject: [PATCH 11/12] organize: add allocation masks and quiet policy clear

---
 rtl/rv_iommu_top.sv                       | 19 +++++++++-
 rtl/translation_logic/rv_iommu_iotlb.sv   | 42 +++++++++++++++++------
 rtl/translation_logic/rv_iommu_tl_wrap.sv | 29 ++++++++++++++++
 3 files changed, 79 insertions(+), 11 deletions(-)

diff --git a/rtl/rv_iommu_top.sv b/rtl/rv_iommu_top.sv
index e98eb2c8bb62ad1cd8d57bd9f1ecaaa6b5713dce..559225bc4439b012dc7ab3d851cc0089ba95035b 100644
--- a/rtl/rv_iommu_top.sv
+++ b/rtl/rv_iommu_top.sv
@@ -27,6 +27,7 @@ module rv_iommu_top
     parameter bit E3Enable = 0,
     parameter bit BankedEnable = 0,
     parameter bit NonblockEnable = 0,
+    parameter bit PolicyEnable = 0,
     parameter int BankIdBit = 0,
 
     /*** Translation Request Interface ***/
@@ -75,6 +76,9 @@ module rv_iommu_top
     input  logic clk_i,
     input  logic rst_ni,
     input  logic nonblock_enable_i,
+    input  logic policy_partition_i, policy_clear_i,
+    input  rv_iommu::device_id_t policy_did_i,
+    output logic policy_quiet_o,
     input  logic [1:0] fullbuffer_jobs_i,
 
     // Translation Request Interface (Slave)
@@ -273,7 +277,14 @@ module rv_iommu_top
     logic           mrif_fault_valid;
     logic           mrif_fault_ready;
 
-    logic in_flight;
+    logic in_flight, policy_tl_quiet;
+    assign policy_quiet_o = policy_tl_quiet && !in_flight &&
+        !tr_req_i.ar_valid && !tr_req_i.aw_valid && !tr_req_i.w_valid &&
+        !tr_resp_o.r_valid && !tr_resp_o.b_valid &&
+        !comp_req_o.ar_valid && !comp_req_o.aw_valid && !comp_req_o.w_valid &&
+        !comp_resp_i.r_valid && !comp_resp_i.b_valid &&
+        !ds_req_o.ar_valid && !ds_req_o.aw_valid && !ds_req_o.w_valid &&
+        !ds_resp_i.r_valid && !ds_resp_i.b_valid;
 
     logic atsinval_to, atsinval_inflight;
 
@@ -472,6 +483,7 @@ module rv_iommu_top
         rv_iommu_tl_wrap #(
             .RVIOMMUCfg         (RVIOMMUCfg),
             .NonblockEnable    (NonblockEnable),
+            .PolicyEnable(PolicyEnable),
             .E3Enable          (E3Enable),
 
             .addr_t             (addr_t),
@@ -540,6 +552,8 @@ module rv_iommu_top
             .fault_valid_o          (fault_valid),
             .fault_ready_i          (fault_ready),
             .nonblock_enable_i(nonblock_enable_i),
+            .policy_partition_i, .policy_clear_i, .policy_did_i,
+            .policy_quiet_o(policy_tl_quiet),
             .nonblock_fire_o(nonblock_fire_o),
             .nonblock_diag_o(nonblock_diag_o),
             .e3_enable_i, .e3_arm_i, .e3_active_i, .e3_delay128_i,
@@ -551,6 +565,7 @@ module rv_iommu_top
         rv_iommu_tl_wrap #(
             .RVIOMMUCfg         (RVIOMMUCfg),
             .NonblockEnable    (NonblockEnable),
+            .PolicyEnable(PolicyEnable),
             .E3Enable          (E3Enable),
 
             .addr_t             (addr_t),
@@ -619,6 +634,8 @@ module rv_iommu_top
             .fault_valid_o          (fault_valid),
             .fault_ready_i          (fault_ready),
             .nonblock_enable_i(nonblock_enable_i),
+            .policy_partition_i, .policy_clear_i, .policy_did_i,
+            .policy_quiet_o(policy_tl_quiet),
             .nonblock_fire_o(nonblock_fire_o),
             .nonblock_diag_o(nonblock_diag_o),
             .e3_enable_i, .e3_arm_i, .e3_active_i, .e3_delay128_i,
diff --git a/rtl/translation_logic/rv_iommu_iotlb.sv b/rtl/translation_logic/rv_iommu_iotlb.sv
index f59cf0d6a0fc596ca36ea4976a618436b01870a7..3c34b5d52f008ffabd6d79f380f698758d38e9b3 100644
--- a/rtl/translation_logic/rv_iommu_iotlb.sv
+++ b/rtl/translation_logic/rv_iommu_iotlb.sv
@@ -23,7 +23,8 @@
 module rv_iommu_iotlb #(
     /// RISC-V IOMMU configuration struct
     parameter rv_iommu_cfg::rv_iommu_cfg_t RVIOMMUCfg = rv_iommu_cfg::NullCfg,
-    parameter bit TouchEnable = 0
+    parameter bit TouchEnable = 0,
+    parameter bit PolicyEnable = 0
 )(
     input  logic                        clk_i,
     input  logic                        rst_ni,
@@ -31,6 +32,10 @@ module rv_iommu_iotlb #(
     // Flush
     input  rv_iommu::iotlb_inval_t      inval_i,
 
+    // Experimental replacement allocation only; no lookup/permission change.
+    input logic policy_clear_i,
+    input logic [RVIOMMUCfg.NumIotlbEntries-1:0] policy_mask_i,
+
     // Update
     input  rv_iommu::iotlb_up_t         update_i,
 
@@ -204,7 +209,9 @@ module rv_iommu_iotlb #(
                 |1 |1 |0   |    Invalidate all entries corresponding to the IOVA in ADDR field, associated to the VM identified by GSCID, including those with G=1
                 |1 |1 |1   |    Invalidate all entries corresponding to the IOVA in ADDR field, for the VM address space identified by GSCID and PSCID.
             */
-            if(inval_i.inval_vma) begin
+            if (PolicyEnable && policy_clear_i) begin
+                tags_n[i].valid = 1'b0;
+            end else if(inval_i.inval_vma) begin
                 unique case ({inval_i.gv, inval_i.av, inval_i.pscv})
                     3'b000: begin
                         // all host address space entries are flushed
@@ -328,6 +335,17 @@ module rv_iommu_iotlb #(
     //-----------------------------------------------
     logic[(RVIOMMUCfg.NumIotlbEntries-2):0] plru_tree_q, plru_tree_n;
 
+    logic [2*RVIOMMUCfg.NumIotlbEntries-2:0] eligible_nodes;
+    logic [RVIOMMUCfg.NumIotlbEntries-1:0] allocation_mask;
+    assign allocation_mask = PolicyEnable ? policy_mask_i : '1;
+    always_comb begin
+        eligible_nodes = '0;
+        for (int i = 0; i < RVIOMMUCfg.NumIotlbEntries; i++)
+            eligible_nodes[RVIOMMUCfg.NumIotlbEntries-1+i] = allocation_mask[i];
+        for (int i = RVIOMMUCfg.NumIotlbEntries-2; i >= 0; i--)
+            eligible_nodes[i] = eligible_nodes[2*i+1] | eligible_nodes[2*i+2];
+    end
+
     always_comb begin : plru_replacement
         plru_tree_n = plru_tree_q;
         
@@ -348,7 +366,7 @@ module rv_iommu_iotlb #(
         end
 
         for (int unsigned i = 0; i < RVIOMMUCfg.NumIotlbEntries; i += 1) begin
-            automatic logic en;
+            automatic logic en, choose_right;
             automatic int unsigned idx_base, shift, new_index;
             en = 1'b1;
 
@@ -356,14 +374,17 @@ module rv_iommu_iotlb #(
                 idx_base = $unsigned((2**lvl)-1);
                 shift = $clog2(RVIOMMUCfg.NumIotlbEntries) - lvl;
                 new_index =  (i >> (shift-1)) & 32'b1;
-                if (new_index[0]) begin
-                    en &= plru_tree_q[idx_base + (i>>shift)];
-                end else begin
-                    en &= ~plru_tree_q[idx_base + (i>>shift)];
-                end
+                // Follow tree-PLRU whenever that child has eligible leaves.
+                // A full mask reproduces the original victim bit for bit.
+                choose_right = eligible_nodes[2*(idx_base + (i>>shift))+2] &&
+                    (!eligible_nodes[2*(idx_base + (i>>shift))+1] ||
+                     plru_tree_q[idx_base + (i>>shift)]);
+                if (new_index[0]) en &= choose_right;
+                else en &= ~choose_right;
             end
-            replace_en[i] = en;
+            replace_en[i] = en && allocation_mask[i];
         end
+        if (PolicyEnable && policy_clear_i) plru_tree_n = '0;
     end
 
     // Only read the actual pre-edge and next state. Snapshot readers must
@@ -373,7 +394,8 @@ module rv_iommu_iotlb #(
         research_o.supported = RVIOMMUCfg.NumIotlbEntries == 16;
         research_o.plru = 32'(plru_tree_q);
         research_o.invalidate = inval_i.inval_vma || inval_i.inval_gvma;
-        research_o.update = update_i.update && !research_o.invalidate;
+        research_o.update = update_i.update && !research_o.invalidate &&
+                            !(PolicyEnable && policy_clear_i);
         for (int i = 0; i < RVIOMMUCfg.NumIotlbEntries && i < 16; i++) begin
             research_o.replace_mask[i] = replace_en[i];
             research_o.entries[i][28:0] = {tags_q[i].vpn2, tags_q[i].vpn1, tags_q[i].vpn0};
diff --git a/rtl/translation_logic/rv_iommu_tl_wrap.sv b/rtl/translation_logic/rv_iommu_tl_wrap.sv
index 5bdc34b5c7c11d34888c670abf99683c3bb4220c..e7900820a46f8c2465d2e275f7106ba550c6661f 100644
--- a/rtl/translation_logic/rv_iommu_tl_wrap.sv
+++ b/rtl/translation_logic/rv_iommu_tl_wrap.sv
@@ -27,6 +27,7 @@ module rv_iommu_tl_wrap
     parameter rv_iommu_cfg::rv_iommu_cfg_t RVIOMMUCfg = rv_iommu_cfg::NullCfg,
     parameter bit E3Enable = 0,
     parameter bit NonblockEnable = 0,
+    parameter bit PolicyEnable = 0,
 
     /// Address data type
     parameter type addr_t = logic,
@@ -124,11 +125,18 @@ module rv_iommu_tl_wrap
     output rv_iommu::e3_tl_t e3_o,
     output rv_iommu::research_t research_o,
     input logic nonblock_enable_i,
+    input logic policy_partition_i, policy_clear_i,
+    input rv_iommu::device_id_t policy_did_i,
+    output logic policy_quiet_o,
     output logic nonblock_fire_o,
     output logic nonblock_busy_o,
     output logic [15:0] nonblock_diag_o
 );
 
+    initial begin
+        if (PolicyEnable && (!NonblockEnable || RVIOMMUCfg.NumIotlbEntries != 16))
+            $fatal(1, "Composition requires nonblocking-capable 16-entry IOTLB");
+    end
     localparam int unsigned PLEN = RVIOMMUCfg.PAddrWidth;
     localparam int unsigned PPNW = PLEN-12;
 
@@ -278,6 +286,20 @@ module rv_iommu_tl_wrap
     assign trans_req_ready_o = n_intercept ? n_accept : (normal_trans_ready && normal_gate);
     assign nonblock_fire_o = n_accept;
     assign nonblock_busy_o = n_busy;
+    // All lifecycle storage must be empty; incoming VALID also excludes a
+    // same-edge configuration. Never reset or discard a pending response.
+    assign policy_quiet_o = state_q == IDLE && !req_valid && !arb_req_valid &&
+        !trans_req_valid_i && !ats_trans_req_valid_i && !debug_req_valid_i &&
+        !ats_ddtc_valid_i && !n_busy && !n_intercept && !n_accept &&
+        !fast_resp_valid && !slow_resp_valid && !ats_trans_resp_valid_o &&
+        !debug_resp_valid_o && !fault_valid_o && !e3_ptw_active &&
+        !ddtw_axi_req_o.ar_valid && !pdtw_axi_req_o.ar_valid &&
+        !ptw_axi_req_o.ar_valid && !msiptw_axi_req_o.ar_valid &&
+        !ddtw_axi_resp_i.r_valid && !pdtw_axi_resp_i.r_valid &&
+        !ptw_axi_resp_i.r_valid && !msiptw_axi_resp_i.r_valid &&
+        !iotlb_update.update && !ddtc_update.update &&
+        !iotinval_i.inval_vma && !iotinval_i.inval_gvma &&
+        !iodirinval_i.inval_ddtc && !iodirinval_i.inval_pdtc;
     assign n_window = state_q == PT && e3_ptw_active && en_1S_q &&
                       !en_2S_q && !ddt_imp_trans_q && !pdt_imp_trans_q &&
                       !req_data.is_debug && trans_req_data_i.bank != req_data.bank &&
@@ -634,6 +656,7 @@ module rv_iommu_tl_wrap
     //----------------------------------
     rv_iommu_iotlb #(
         .TouchEnable(NonblockEnable),
+        .PolicyEnable(PolicyEnable),
         .RVIOMMUCfg     (RVIOMMUCfg)
     ) i_rv_iommu_iotlb (
         .clk_i          (clk_i),
@@ -641,6 +664,12 @@ module rv_iommu_tl_wrap
 
         .update_i       (iotlb_update),
         .inval_i        (iotinval_i),
+        .policy_clear_i (PolicyEnable && policy_clear_i),
+        // Owner is the stable main PTW/MSI request, never a fast probe DID.
+        .policy_mask_i  (PolicyEnable && policy_partition_i ?
+            (req_data.did == policy_did_i ?
+             RVIOMMUCfg.NumIotlbEntries'(16'h0003) :
+             RVIOMMUCfg.NumIotlbEntries'(16'hfffc)) : '1),
 
         .lookup_i       (iotlb_lu),
         .touch_i        (!n_iotlb_lu || n_iotlb_touch),
