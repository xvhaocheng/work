From 09fb4dea583a14848b8fb6676b63b67a1775bba5 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:48:57 +0900
Subject: [PATCH 02/12] organize: select AW before AR for DMA write progress

---
 .../rv_iommu_trans_ctl_wrap.sv                | 43 ++++++++++---------
 1 file changed, 22 insertions(+), 21 deletions(-)

diff --git a/rtl/transaction_controller/rv_iommu_trans_ctl_wrap.sv b/rtl/transaction_controller/rv_iommu_trans_ctl_wrap.sv
index 191e4c8468d1b223b18d28589015fad8efe2cd4f..cd59deb95f0ba5a8f59844a30331c912681bdbd1 100644
--- a/rtl/transaction_controller/rv_iommu_trans_ctl_wrap.sv
+++ b/rtl/transaction_controller/rv_iommu_trans_ctl_wrap.sv
@@ -574,10 +574,30 @@ module rv_iommu_trans_ctl_wrap #(
         unique case (state_q)
 
             // Monitor incoming requests
-            // Priority is given to read requests
+            // Forward AW before AR so read-to-write DMA can open the W drain
+            // before source read data fills the write-data FIFO.
             IDLE: begin
+                // Write request received
+                // Stall writes if W FIFO is full
+                if (aw_valid && !w_cnt_ovf) begin
+
+                    // Tags
+                    trans_req_data_n.iova       = aw_data.addr;
+                    trans_req_data_n.did        = aw_data.stream_id;
+                    trans_req_data_n.pid_valid  = aw_data.ss_id_valid;
+                    trans_req_data_n.pid        = aw_data.substream_id;
+                    trans_req_data_n.ttype      = aw_data.mmu_atst && !aw_data.mmu_valid ?
+                                                  rv_iommu::TRANSLATED_W :
+                                                  rv_iommu::UNTRANSLATED_W;
+                    // AxPROT[0] indicates privileged transaction when set
+                    trans_req_data_n.priv       = aw_data.prot[0];
+                    trans_req_data_n.is_debug   = 1'b0;
+
+                    state_n = REQ_TRANS;
+                end
+
                 // Read request received
-                if (ar_valid) begin
+                else if (ar_valid) begin
                     // Tags
                     trans_req_data_n.iova       = ar_data.addr;
                     trans_req_data_n.did        = ar_data.stream_id;
@@ -600,25 +620,6 @@ module rv_iommu_trans_ctl_wrap #(
 
                     state_n = REQ_TRANS;
                 end
-
-                // Write request received
-                // Stall writes if W FIFO is full
-                else if (aw_valid && !w_cnt_ovf) begin
-
-                    // Tags
-                    trans_req_data_n.iova       = aw_data.addr;
-                    trans_req_data_n.did        = aw_data.stream_id;
-                    trans_req_data_n.pid_valid  = aw_data.ss_id_valid;
-                    trans_req_data_n.pid        = aw_data.substream_id;
-                    trans_req_data_n.ttype      = aw_data.mmu_atst && !aw_data.mmu_valid ?
-                                                  rv_iommu::TRANSLATED_W :
-                                                  rv_iommu::UNTRANSLATED_W;
-                    // AxPROT[0] indicates privileged transaction when set
-                    trans_req_data_n.priv       = aw_data.prot[0];
-                    trans_req_data_n.is_debug   = 1'b0;
-
-                    state_n = REQ_TRANS;
-                end
             end
 
             // Perform BC check
