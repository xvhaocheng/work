From 0b7939445298a23ea3e131ffd4e003cebb15ac59 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:50:27 +0900
Subject: [PATCH 12/12] organize: isolate replacement history for fixed 2 and
 14 way partitions

---
 rtl/translation_logic/rv_iommu_iotlb.sv   | 41 +++++++++++++++++++++--
 rtl/translation_logic/rv_iommu_tl_wrap.sv |  1 +
 2 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/rtl/translation_logic/rv_iommu_iotlb.sv b/rtl/translation_logic/rv_iommu_iotlb.sv
index 3c34b5d52f008ffabd6d79f380f698758d38e9b3..0668310519fbfbdb9e4b4fe5be66e8f7756c9797 100644
--- a/rtl/translation_logic/rv_iommu_iotlb.sv
+++ b/rtl/translation_logic/rv_iommu_iotlb.sv
@@ -24,7 +24,10 @@ module rv_iommu_iotlb #(
     /// RISC-V IOMMU configuration struct
     parameter rv_iommu_cfg::rv_iommu_cfg_t RVIOMMUCfg = rv_iommu_cfg::NullCfg,
     parameter bit TouchEnable = 0,
-    parameter bit PolicyEnable = 0
+    parameter bit PolicyEnable = 0,
+    // Composition experiment: independent history for fixed ways 0-1 / 2-15.
+    // Other geometries/masks and the default instance retain shared PLRU.
+    parameter bit PartitionLocalHistory = 0
 )(
     input  logic                        clk_i,
     input  logic                        rst_ni,
@@ -335,6 +338,29 @@ module rv_iommu_iotlb #(
     //-----------------------------------------------
     logic[(RVIOMMUCfg.NumIotlbEntries-2):0] plru_tree_q, plru_tree_n;
 
+    function automatic logic [2*RVIOMMUCfg.NumIotlbEntries-2:0] history_nodes(
+        input logic [RVIOMMUCfg.NumIotlbEntries-1:0] owners
+    );
+        logic [2*RVIOMMUCfg.NumIotlbEntries-2:0] nodes;
+        nodes = '0;
+        for (int i = 0; i < RVIOMMUCfg.NumIotlbEntries; i++)
+            nodes[RVIOMMUCfg.NumIotlbEntries-1+i] = owners[i];
+        for (int i = RVIOMMUCfg.NumIotlbEntries-2; i >= 0; i--)
+            nodes[i] = nodes[2*i+1] | nodes[2*i+2];
+        return nodes;
+    endfunction
+
+    localparam logic [RVIOMMUCfg.NumIotlbEntries-1:0] ProtectedWays =
+        RVIOMMUCfg.NumIotlbEntries'(16'h0003);
+    localparam logic [2*RVIOMMUCfg.NumIotlbEntries-2:0] ProtectedNodes =
+        history_nodes(ProtectedWays);
+    localparam logic [2*RVIOMMUCfg.NumIotlbEntries-2:0] BackgroundNodes =
+        history_nodes(~ProtectedWays);
+    logic partition_local_active;
+    assign partition_local_active = PartitionLocalHistory && PolicyEnable &&
+        RVIOMMUCfg.NumIotlbEntries == 16 &&
+        ((policy_mask_i == ProtectedWays) || (policy_mask_i == ~ProtectedWays));
+
     logic [2*RVIOMMUCfg.NumIotlbEntries-2:0] eligible_nodes;
     logic [RVIOMMUCfg.NumIotlbEntries-1:0] allocation_mask;
     assign allocation_mask = PolicyEnable ? policy_mask_i : '1;
@@ -360,7 +386,18 @@ module rv_iommu_iotlb #(
                     idx_base = $unsigned((2**lvl)-1);
                     shift = $clog2(RVIOMMUCfg.NumIotlbEntries) - lvl;
                     new_index =  ~((i >> (shift-1)) & 32'b1);
-                    plru_tree_n[idx_base + (i >> shift)] = new_index[0];
+                    // Fill ownership belongs to the main request, but a hit
+                    // may belong to a different fast request. Derive touch
+                    // ownership from the resident way, never policy_mask_i.
+                    // A branch used by only one child of this partition is
+                    // forced by the allocation mask and needs no history.
+                    if (!partition_local_active ||
+                        (i < 2 ?
+                         (ProtectedNodes[2*(idx_base + (i >> shift))+1] &&
+                          ProtectedNodes[2*(idx_base + (i >> shift))+2]) :
+                         (BackgroundNodes[2*(idx_base + (i >> shift))+1] &&
+                          BackgroundNodes[2*(idx_base + (i >> shift))+2])))
+                        plru_tree_n[idx_base + (i >> shift)] = new_index[0];
                 end
             end
         end
diff --git a/rtl/translation_logic/rv_iommu_tl_wrap.sv b/rtl/translation_logic/rv_iommu_tl_wrap.sv
index e7900820a46f8c2465d2e275f7106ba550c6661f..7a4e08b4d3cb82a1d9b2d817b8dbcf5d68ec8bcf 100644
--- a/rtl/translation_logic/rv_iommu_tl_wrap.sv
+++ b/rtl/translation_logic/rv_iommu_tl_wrap.sv
@@ -657,6 +657,7 @@ module rv_iommu_tl_wrap
     rv_iommu_iotlb #(
         .TouchEnable(NonblockEnable),
         .PolicyEnable(PolicyEnable),
+        .PartitionLocalHistory(PolicyEnable),
         .RVIOMMUCfg     (RVIOMMUCfg)
     ) i_rv_iommu_iotlb (
         .clk_i          (clk_i),
