+        assign e3_capture = 0;
+        assign e3_available = 0;
+        assign e3_consume = 0;
+        assign e3_error = 0;
+        assign e3_extra = 0;
+    end
     rv_iommu_ptw #(
         .RVIOMMUCfg         (RVIOMMUCfg),
         .addr_t             (addr_t),
