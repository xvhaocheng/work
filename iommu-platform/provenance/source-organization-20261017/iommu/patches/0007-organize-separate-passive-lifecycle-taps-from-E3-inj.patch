+
+    // Passive research ABI: two words per IOTLB entry. No tap controls IOATC.
+    // low: VPN[28:0], PSCID[48:29], S1/S2[49:50], valid[51],
+    // S1 1G/2M[52:53], S2 1G/2M[54:55], S1 global[56].
+    // high: GSCID[15:0]. All other bits are zero.
+    typedef struct packed {
+        logic [15:0][127:0] entries, entries_next;
+        logic [31:0] plru;
+        logic [15:0] replace_mask;
+        logic update, invalidate, supported;
+        logic [23:0] did;
+        logic normal, lookup, hit;
+        logic [63:0] iova;
+        logic [19:0] pscid;
+        logic [15:0] gscid;
+        logic stage1, stage2;
+    } research_t;
+
     // ----------------
     //# Address Length
     // ----------------
