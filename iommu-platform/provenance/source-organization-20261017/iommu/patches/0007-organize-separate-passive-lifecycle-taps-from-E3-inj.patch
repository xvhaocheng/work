 package rv_iommu;
 
+    // Bounded FPGA experiment taps. No observer signal participates in arbitration.
+    typedef struct packed {
+        logic select_valid, select_write;
+        logic [7:0] select_id;
+        logic [23:0] select_did;
+        logic [63:0] select_iova;
+        logic [31:0] victim_waiting;
+        logic queue_error;
+        logic head_valid;
