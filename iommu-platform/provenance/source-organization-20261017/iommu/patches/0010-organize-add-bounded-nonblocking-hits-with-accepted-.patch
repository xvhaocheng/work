     assign ats_ddtc_tc_o.en_ats = dc_q.tc.en_ats;
@@ -240,20 +260,82 @@ module rv_iommu_tl_wrap
     rv_iommu::iotlb_up_t            ptw_iotlb_update, msi_iotlb_update;
     rv_iommu::iotlb_up_t            iotlb_update;
