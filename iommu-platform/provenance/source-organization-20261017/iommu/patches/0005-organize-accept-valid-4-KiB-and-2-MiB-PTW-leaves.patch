From 24443a8afadd9302b65f9a411d05dcfb48c996ff Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:48:57 +0900
Subject: [PATCH 05/12] organize: accept valid 4 KiB and 2 MiB PTW leaves

---
 rtl/translation_logic/rv_iommu_ptw.sv | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/rtl/translation_logic/rv_iommu_ptw.sv b/rtl/translation_logic/rv_iommu_ptw.sv
index d8cf3620f524cf2ebed5135afb784bcd5fc75de5..14b554dfdc80886474c9a419fc5df8c5a3f351d3 100644
--- a/rtl/translation_logic/rv_iommu_ptw.sv
+++ b/rtl/translation_logic/rv_iommu_ptw.sv
@@ -423,9 +423,11 @@ module rv_iommu_ptw #(
                                     // superpages
                                     if (main_lvl_q == LVL2)
                                         final_gpa[20:0] = iova_q[20:0];
-                                    if (main_lvl_q == LVL1)
+                                    else if (main_lvl_q == LVL1)
                                         final_gpa[29:0] = iova_q[29:0];
-                                    else begin
+                                    // LVL3 is a valid 4 KiB leaf; keep the PPN
+                                    // and page offset assembled above.
+                                    else if (main_lvl_q != LVL3) begin
                                         pf_excep_n  = 1'b1;
                                         state_n     = ERROR;
                                     end
@@ -460,7 +462,9 @@ module rv_iommu_ptw #(
                                         pptr[20:0] = gpa_x_q[20:0];
                                     else if (main_lvl_q == LVL1)
                                         pptr[29:0] = gpa_x_q[29:0];
-                                    else begin
+                                    // A 4 KiB G-stage leaf also keeps the
+                                    // already assembled PPN and page offset.
+                                    else if (main_lvl_q != LVL3) begin
                                         pf_excep_n  = 1'b1;
                                         state_n     = ERROR;
                                     end
