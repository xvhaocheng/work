+// SPDX-License-Identifier: Solderpad-0.51
+//
+// dma_composition_control
+//
+// New-profile mode/clear control and (open, close] window observer.
+// The module is passive with respect to AXI and the IOTLB data paths: it only
+// exposes the new mode, protected DID and a same-cycle clear pulse on an
+// accepted offset-2 config write.
+//
+// 128-word relative bank, selected by index_i[6:0] where index_i == 0 maps to
+// D20.  Only word 2 is writable.  All other writes are ignored.
+//
+// Entry layout matches rv_iommu_iotlb research_o.entries:
+//   bit 51      : valid
+//   bits 48:29 : PSCID
+//
+// The production array ports are unpacked 16 x 128 bit arrays.  The test top
+// converts its flat Verilator public array into these unpacked arrays.
+//
+// lookup_i is the translation logic's one-cycle first-lookup pulse for each
+// normal request.  Window counters 12:20 count every lookup_i pulse while the
+// window is active; seen_lookup_v/a are only used to latch the first PSCID for
+// offsets 38/39.
+//
+// Test-only compile hook: CVC_TEST_GEN_FULL initializes generation to all ones.
+// It is not a port parameter and default synthesis sees generation = 0.
+//
+module dma_composition_control (
+    input  logic               clk_i,
+    input  logic               rst_ni,
+
+    input  logic               cfg_write_i,
+    input  logic [6:0]         index_i,
+    input  logic [63:0]        wdata_i,
+    output logic [63:0]        rdata_o,
+
+    input  logic               quiet_i,
+    input  logic               supported_i,
+    input  logic               arm_i,
+    input  logic               open_i,
+    input  logic               close_i,
+
+    output logic [1:0]         mode_o,
+    output logic [23:0]        protected_did_o,
+    output logic               clear_o,
+
+    input  logic               lookup_i,
+    input  logic               lookup_hit_i,
+    input  logic               normal_i,
+    input  logic               stage1_i,
+    input  logic               stage2_i,
+    input  logic [23:0]        lookup_did_i,
+    input  logic [19:0]        lookup_pscid_i,
+
+    input  logic               accept_i,
+    input  logic               fast_i,
+    input  logic [23:0]        fast_did_i,
+
+    input  logic [1:0]         gap_active_i,
+
+    input  logic               update_i,
+    input  logic               invalidate_i,
+    input  logic [23:0]        update_did_i,
+    input  logic [15:0]        replace_mask_i,
+    input  logic [127:0]       entries_i [16],
+    input  logic [127:0]       entries_next_i [16],
+    input  logic [31:0]        plru_i
+);
+
+    localparam logic [63:0] COMP_MAGIC = 64'h49444D4143504E01;
+    localparam logic [63:0] COMP_ABI   = 64'd1;
+    localparam logic [63:0] PROT_MASK  = 64'd3;
+
+    localparam logic [1:0] MODE_S  = 2'd0;
+    localparam logic [1:0] MODE_N  = 2'd1;
+    localparam logic [1:0] MODE_P  = 2'd2;
+    localparam logic [1:0] MODE_PN = 2'd3;
+
+    localparam logic [23:0] DID_V = 24'd10;
+    localparam logic [23:0] DID_A = 24'd11;
+
+    localparam int ENTRY_VALID_BIT = 51;
+    localparam int PSCID_LSB = 29;
+    localparam int PSCID_MSB = 48;
+
+    // Counters 12:20 count every lookup_i pulse while the window is active.
+    // lookup_i is the translation logic's one-cycle first-lookup pulse for each
+    // normal request, not a per-window first event.
+    localparam int W_LOOKUP_V = 12;
+    localparam int W_HIT_V    = 13;
+    localparam int W_MISS_V   = 14;
+    localparam int W_LOOKUP_A = 15;
+    localparam int W_HIT_A    = 16;
+    localparam int W_MISS_A   = 17;
+    localparam int W_LOOKUP_O = 18;
+    localparam int W_HIT_O    = 19;
+    localparam int W_MISS_O   = 20;
+    localparam int W_FAST_V   = 21;
+    localparam int W_FAST_A   = 22;
+    localparam int W_FAST_O   = 23;
+    localparam int W_GAP_V    = 24;
+    localparam int W_GAP_A    = 25;
+    localparam int W_FILL_V   = 26;
+    localparam int W_FILL_A   = 27;
+    localparam int W_FILL_O   = 28;
+    localparam int W_REPL     = 29;
+    localparam int W_PART     = 30;
+    localparam int W_INVAL    = 31;
+    localparam int W_FIRST_BAD= 32;
+    localparam int W_FAST_N   = 33;
+
+    typedef enum logic [1:0] {S_OFF, S_ARMED, S_ACTIVE, S_FROZEN} state_e;
+
+    state_e      state_q, state_d;
+    logic [63:0] seq_q, seq_d;
+    logic [63:0] cycles_q, cycles_d;
+    logic [4:0]  err_q, err_d;
+    logic [63:0] cnt_q [40];
+    logic [63:0] cnt_d [40];
+
+    logic [63:0] win_cfg_q, win_cfg_d;
+    logic [63:0] win_gen_q, win_gen_d;
+
+    logic [31:0] plru_open_q, plru_open_d;
+    logic [31:0] plru_close_q, plru_close_d;
+
+    logic [19:0] pscid_v_q, pscid_v_d;
+    logic [19:0] pscid_a_q, pscid_a_d;
+
+    logic        seen_lookup_v_q, seen_lookup_v_d;
+    logic        seen_lookup_a_q, seen_lookup_a_d;
+
+    logic [127:0] entries_open_q [16];
+    logic [127:0] entries_open_d [16];
+    logic [127:0] entries_close_q [16];
+    logic [127:0] entries_close_d [16];
+
+    logic [1:0]  mode_q;
+    logic [23:0] protected_did_q;
+    logic [63:0] generation_q;
+    logic [2:0]  last_status_q;
+
+`ifdef CVC_TEST_GEN_FULL
+    localparam logic [63:0] INIT_GENERATION = {64{1'b1}};
+`else
+    localparam logic [63:0] INIT_GENERATION = 64'd0;
+`endif
+
+    logic cfg_busy;
+    logic cfg_data_legal;
+    logic quiet_obs;
+    logic [3:0] repl_idx;
+    logic lookup_ok;
+
+    always_comb begin
+        cfg_busy = !quiet_i || (state_q == S_ARMED) || (state_q == S_ACTIVE) ||
+                   arm_i || open_i || close_i;
+    end
+
+    always_comb begin
+        cfg_data_legal = (wdata_i[63:32] == 32'd0) &&
+                         (wdata_i[7:2] == 6'd0) &&
+                         ((wdata_i[31:8] == DID_V) || (wdata_i[31:8] == DID_A));
+    end
+
+    always_comb begin
+        quiet_obs = quiet_i && !(state_q == S_ARMED || state_q == S_ACTIVE) &&
+                    !arm_i && !open_i && !close_i;
+    end
+
+    always_comb begin
+        lookup_ok = normal_i && stage1_i && !stage2_i;
+    end
+
+    always_comb begin
+        repl_idx = 4'd0;
+        for (int i = 0; i < 16; i++) begin
+            if (replace_mask_i[i]) repl_idx = i[3:0];
+        end
+    end
+
+    always_comb begin
+        clear_o = rst_ni && cfg_write_i && (index_i == 7'd2) && !cfg_busy &&
+                  supported_i && cfg_data_legal &&
+                  (generation_q != {64{1'b1}});
+    end
+
+    always_ff @(posedge clk_i) begin
+        if (!rst_ni) begin
+            mode_q          <= MODE_S;
+            protected_did_q <= DID_V;
+            generation_q    <= INIT_GENERATION;
+            last_status_q   <= 3'd0;
+        end else if (cfg_write_i && (index_i == 7'd2)) begin
+            if (cfg_busy) begin
+                last_status_q <= 3'd1;
+            end else if (!supported_i || !cfg_data_legal) begin
+                last_status_q <= 3'd2;
+            end else if (generation_q == {64{1'b1}}) begin
+                last_status_q <= 3'd3;
+            end else begin
+                last_status_q   <= 3'd0;
+                mode_q          <= wdata_i[1:0];
+                protected_did_q <= wdata_i[31:8];
+                generation_q    <= generation_q + 64'd1;
+            end
+        end
+    end
+
+    always_comb begin
+        state_d = state_q;
+        seq_d = seq_q;
+        cycles_d = cycles_q;
+        err_d = err_q;
+        for (int i = 0; i < 40; i++) cnt_d[i] = cnt_q[i];
+        win_cfg_d = win_cfg_q;
+        win_gen_d = win_gen_q;
+        plru_open_d = plru_open_q;
+        plru_close_d = plru_close_q;
+        pscid_v_d = pscid_v_q;
+        pscid_a_d = pscid_a_q;
+        seen_lookup_v_d = seen_lookup_v_q;
+        seen_lookup_a_d = seen_lookup_a_q;
+        for (int i = 0; i < 16; i++) begin
+            entries_open_d[i] = entries_open_q[i];
+            entries_close_d[i] = entries_close_q[i];
+        end
+
+        if (arm_i) begin
+            if (open_i || close_i) begin
+                err_d[0] = 1'b1;
+            end else if (state_q == S_ACTIVE) begin
+                err_d[0] = 1'b1;
+            end else begin
+                state_d = S_ARMED;
+                err_d = 5'd0;
+                cycles_d = 64'd0;
+                for (int i = 0; i < 40; i++) cnt_d[i] = 64'd0;
+                seen_lookup_v_d = 1'b0;
+                seen_lookup_a_d = 1'b0;
+                pscid_v_d = 20'd0;
+                pscid_a_d = 20'd0;
+                win_cfg_d = {32'd0, protected_did_q, 6'd0, mode_q};
+                win_gen_d = generation_q;
+                plru_open_d = 32'd0;
+                plru_close_d = 32'd0;
+                for (int i = 0; i < 16; i++) begin
+                    entries_open_d[i] = 128'd0;
+                    entries_close_d[i] = 128'd0;
+                end
+                if (seq_q == {64{1'b1}}) err_d[1] = 1'b1;
+                else seq_d = seq_q + 64'd1;
+            end
+        end
+
+        if (open_i) begin
+            if (arm_i) begin
+                err_d[0] = 1'b1;
+            end else if (state_q == S_ARMED) begin
+                state_d = S_ACTIVE;
+                plru_open_d = plru_i;
+                for (int i = 0; i < 16; i++) entries_open_d[i] = entries_i[i];
+            end else begin
+                err_d[0] = 1'b1;
+            end
+        end
+
+        if (close_i) begin
+            if (arm_i) begin
+                err_d[0] = 1'b1;
+            end else if (state_q == S_ACTIVE) begin
+                state_d = S_FROZEN;
+                plru_close_d = plru_i;
+                for (int i = 0; i < 16; i++) entries_close_d[i] = entries_next_i[i];
+            end else begin
+                err_d[0] = 1'b1;
+            end
+        end
+
+        if (state_q == S_ACTIVE) begin
+            if (cycles_d == {64{1'b1}}) err_d[1] = 1'b1;
+            else cycles_d = cycles_d + 64'd1;
+
+            if (gap_active_i[0]) begin
+                if (cnt_d[W_GAP_V] == {64{1'b1}}) err_d[1] = 1'b1;
+                else cnt_d[W_GAP_V] = cnt_d[W_GAP_V] + 64'd1;
+            end
+            if (gap_active_i[1]) begin
+                if (cnt_d[W_GAP_A] == {64{1'b1}}) err_d[1] = 1'b1;
+                else cnt_d[W_GAP_A] = cnt_d[W_GAP_A] + 64'd1;
+            end
+
+            if (lookup_i) begin
+                if (lookup_did_i == DID_V) begin
+                    if (cnt_d[W_LOOKUP_V] == {64{1'b1}}) err_d[1] = 1'b1;
+                    else cnt_d[W_LOOKUP_V] = cnt_d[W_LOOKUP_V] + 64'd1;
+                    if (lookup_hit_i) begin
+                        if (cnt_d[W_HIT_V] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_HIT_V] = cnt_d[W_HIT_V] + 64'd1;
+                    end else begin
+                        if (cnt_d[W_MISS_V] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_MISS_V] = cnt_d[W_MISS_V] + 64'd1;
+                    end
+                    if (lookup_ok) begin
+                        if (!seen_lookup_v_d) begin
+                            seen_lookup_v_d = 1'b1;
+                            pscid_v_d = lookup_pscid_i;
+                        end
+                    end else begin
+                        if (cnt_d[W_FIRST_BAD] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FIRST_BAD] = cnt_d[W_FIRST_BAD] + 64'd1;
+                        err_d[3] = 1'b1;
+                    end
+                end else if (lookup_did_i == DID_A) begin
+                    if (cnt_d[W_LOOKUP_A] == {64{1'b1}}) err_d[1] = 1'b1;
+                    else cnt_d[W_LOOKUP_A] = cnt_d[W_LOOKUP_A] + 64'd1;
+                    if (lookup_hit_i) begin
+                        if (cnt_d[W_HIT_A] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_HIT_A] = cnt_d[W_HIT_A] + 64'd1;
+                    end else begin
+                        if (cnt_d[W_MISS_A] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_MISS_A] = cnt_d[W_MISS_A] + 64'd1;
+                    end
+                    if (lookup_ok) begin
+                        if (!seen_lookup_a_d) begin
+                            seen_lookup_a_d = 1'b1;
+                            pscid_a_d = lookup_pscid_i;
+                        end
+                    end else begin
+                        if (cnt_d[W_FIRST_BAD] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FIRST_BAD] = cnt_d[W_FIRST_BAD] + 64'd1;
+                        err_d[3] = 1'b1;
+                    end
+                end else begin
+                    if (cnt_d[W_LOOKUP_O] == {64{1'b1}}) err_d[1] = 1'b1;
+                    else cnt_d[W_LOOKUP_O] = cnt_d[W_LOOKUP_O] + 64'd1;
+                    if (lookup_hit_i) begin
+                        if (cnt_d[W_HIT_O] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_HIT_O] = cnt_d[W_HIT_O] + 64'd1;
+                    end else begin
+                        if (cnt_d[W_MISS_O] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_MISS_O] = cnt_d[W_MISS_O] + 64'd1;
+                    end
+                    if (!lookup_ok) begin
+                        if (cnt_d[W_FIRST_BAD] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FIRST_BAD] = cnt_d[W_FIRST_BAD] + 64'd1;
+                        err_d[3] = 1'b1;
+                    end
+                end
+            end
+
+            if (fast_i) begin
+                if (accept_i) begin
+                    if (fast_did_i == DID_V) begin
+                        if (cnt_d[W_FAST_V] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FAST_V] = cnt_d[W_FAST_V] + 64'd1;
+                    end else if (fast_did_i == DID_A) begin
+                        if (cnt_d[W_FAST_A] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FAST_A] = cnt_d[W_FAST_A] + 64'd1;
+                    end else begin
+                        if (cnt_d[W_FAST_O] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FAST_O] = cnt_d[W_FAST_O] + 64'd1;
+                    end
+                    if (!((mode_q == MODE_N) || (mode_q == MODE_PN))) begin
+                        if (cnt_d[W_FAST_N] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FAST_N] = cnt_d[W_FAST_N] + 64'd1;
+                        err_d[2] = 1'b1;
+                    end
+                end else begin
+                    err_d[0] = 1'b1;
+                end
+            end
+
+            if (update_i) begin
+                if ((replace_mask_i != 16'd0) &&
+                    ((replace_mask_i & (replace_mask_i - 16'd1)) == 16'd0)) begin
+                    if (update_did_i == DID_V) begin
+                        if (cnt_d[W_FILL_V] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FILL_V] = cnt_d[W_FILL_V] + 64'd1;
+                    end else if (update_did_i == DID_A) begin
+                        if (cnt_d[W_FILL_A] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FILL_A] = cnt_d[W_FILL_A] + 64'd1;
+                    end else begin
+                        if (cnt_d[W_FILL_O] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_FILL_O] = cnt_d[W_FILL_O] + 64'd1;
+                    end
+
+                    if ((mode_q == MODE_P) || (mode_q == MODE_PN)) begin
+                        if (update_did_i == protected_did_q) begin
+                            if (repl_idx >= 4'd2) begin
+                                if (cnt_d[W_PART] == {64{1'b1}}) err_d[1] = 1'b1;
+                                else cnt_d[W_PART] = cnt_d[W_PART] + 64'd1;
+                                err_d[4] = 1'b1;
+                            end
+                        end else begin
+                            if (repl_idx < 4'd2) begin
+                                if (cnt_d[W_PART] == {64{1'b1}}) err_d[1] = 1'b1;
+                                else cnt_d[W_PART] = cnt_d[W_PART] + 64'd1;
+                                err_d[4] = 1'b1;
+                            end
+                        end
+                    end
+
+                    if (entries_i[repl_idx][ENTRY_VALID_BIT] &&
+                        (entries_i[repl_idx][PSCID_MSB:PSCID_LSB] !=
+                         entries_next_i[repl_idx][PSCID_MSB:PSCID_LSB])) begin
+                        if (cnt_d[W_REPL] == {64{1'b1}}) err_d[1] = 1'b1;
+                        else cnt_d[W_REPL] = cnt_d[W_REPL] + 64'd1;
+                    end
+                end else begin
+                    err_d[3] = 1'b1;
+                end
+            end
+
+            if (invalidate_i) begin
+                if (cnt_d[W_INVAL] == {64{1'b1}}) err_d[1] = 1'b1;
+                else cnt_d[W_INVAL] = cnt_d[W_INVAL] + 64'd1;
+            end
+        end
+    end
+
+    always_ff @(posedge clk_i) begin
+        if (!rst_ni) begin
+            state_q <= S_OFF;
+            seq_q <= 64'd0;
+            cycles_q <= 64'd0;
+            err_q <= 5'd0;
+            for (int i = 0; i < 40; i++) cnt_q[i] <= 64'd0;
+            win_cfg_q <= 64'd0;
+            win_gen_q <= 64'd0;
+            plru_open_q <= 32'd0;
+            plru_close_q <= 32'd0;
+            pscid_v_q <= 20'd0;
+            pscid_a_q <= 20'd0;
+            seen_lookup_v_q <= 1'b0;
+            seen_lookup_a_q <= 1'b0;
+            for (int i = 0; i < 16; i++) begin
+                entries_open_q[i] <= 128'd0;
+                entries_close_q[i] <= 128'd0;
+            end
+        end else begin
+            state_q <= state_d;
+            seq_q <= seq_d;
+            cycles_q <= cycles_d;
+            err_q <= err_d;
+            for (int i = 0; i < 40; i++) cnt_q[i] <= cnt_d[i];
+            win_cfg_q <= win_cfg_d;
+            win_gen_q <= win_gen_d;
+            plru_open_q <= plru_open_d;
+            plru_close_q <= plru_close_d;
+            pscid_v_q <= pscid_v_d;
+            pscid_a_q <= pscid_a_d;
+            seen_lookup_v_q <= seen_lookup_v_d;
+            seen_lookup_a_q <= seen_lookup_a_d;
+            for (int i = 0; i < 16; i++) begin
+                entries_open_q[i] <= entries_open_d[i];
+                entries_close_q[i] <= entries_close_d[i];
+            end
+        end
+    end
+
+    assign mode_o = mode_q;
+    assign protected_did_o = protected_did_q;
+
+    always_comb begin
+        rdata_o = 64'd0;
+        case (index_i)
+            7'd0:  rdata_o = COMP_MAGIC;
+            7'd1:  rdata_o = COMP_ABI;
+            7'd2:  rdata_o = {32'd0, protected_did_q, 6'd0, mode_q};
+            7'd3:  rdata_o = generation_q;
+            7'd4:  rdata_o = {61'd0, last_status_q};
+            7'd5:  rdata_o = {63'd0, quiet_obs};
+            7'd6:  rdata_o = {61'd0, (state_q == S_FROZEN), (state_q == S_ACTIVE), (state_q == S_ARMED)};
+            7'd7:  rdata_o = seq_q;
+            7'd8:  rdata_o = cycles_q;
+            7'd9:  rdata_o = {59'd0, err_q};
+            7'd10: rdata_o = win_cfg_q;
+            7'd11: rdata_o = win_gen_q;
+            7'd12: rdata_o = cnt_q[W_LOOKUP_V];
+            7'd13: rdata_o = cnt_q[W_HIT_V];
+            7'd14: rdata_o = cnt_q[W_MISS_V];
+            7'd15: rdata_o = cnt_q[W_LOOKUP_A];
+            7'd16: rdata_o = cnt_q[W_HIT_A];
+            7'd17: rdata_o = cnt_q[W_MISS_A];
+            7'd18: rdata_o = cnt_q[W_LOOKUP_O];
+            7'd19: rdata_o = cnt_q[W_HIT_O];
+            7'd20: rdata_o = cnt_q[W_MISS_O];
+            7'd21: rdata_o = cnt_q[W_FAST_V];
+            7'd22: rdata_o = cnt_q[W_FAST_A];
+            7'd23: rdata_o = cnt_q[W_FAST_O];
+            7'd24: rdata_o = cnt_q[W_GAP_V];
+            7'd25: rdata_o = cnt_q[W_GAP_A];
+            7'd26: rdata_o = cnt_q[W_FILL_V];
+            7'd27: rdata_o = cnt_q[W_FILL_A];
+            7'd28: rdata_o = cnt_q[W_FILL_O];
+            7'd29: rdata_o = cnt_q[W_REPL];
+            7'd30: rdata_o = cnt_q[W_PART];
+            7'd31: rdata_o = cnt_q[W_INVAL];
+            7'd32: rdata_o = cnt_q[W_FIRST_BAD];
+            7'd33: rdata_o = cnt_q[W_FAST_N];
+            7'd34: rdata_o = PROT_MASK;
+            7'd35: rdata_o = 64'd0;
+            7'd36: rdata_o = {32'd0, plru_open_q};
+            7'd37: rdata_o = {32'd0, plru_close_q};
+            7'd38: rdata_o = {44'd0, pscid_v_q};
+            7'd39: rdata_o = {44'd0, pscid_a_q};
+            default: begin
+                if ((index_i >= 7'd64) && (index_i <= 7'd95)) begin
+                    rdata_o = index_i[0] ? entries_open_q[index_i[4:1]][127:64]
+                                         : entries_open_q[index_i[4:1]][63:0];
+                end else if ((index_i >= 7'd96) && (index_i <= 7'd127)) begin
+                    rdata_o = index_i[0] ? entries_close_q[index_i[4:1]][127:64]
+                                         : entries_close_q[index_i[4:1]][63:0];
+                end
+            end
+        endcase
+    end
+
+endmodule
diff --git a/corev_apu/fpga/src/dma_nonblock_observer.sv b/corev_apu/fpga/src/dma_nonblock_observer.sv
new file mode 100644
index 0000000000000000000000000000000000000000..285d358d4cdd8aaa6649708983236169f6addf40
--- /dev/null
+++ b/corev_apu/fpga/src/dma_nonblock_observer.sv
@@ -0,0 +1,256 @@
+// SPDX-License-Identifier: Solderpad-0.51
+//
+// dma_nonblock_observer
+//
+// Passive, non-blocking (open, close] window observer. The module only samples
+// the DMA monitor bus; no output feeds back into the DMA or AXI data paths, and
+// the register bank is read-only from software.
+//
+// 16-word read-only bank, selected by the 8-bit index port:
+//   0  magic  0x49444D414E424C01
+//   1  version 1
+//   2  Mode
+//   3  flags  {.., frozen, active, armed}
+//   4  seq    monotonic, incremented once per ARM
+//   5  cycles active cycles counted inside (open, close]
+//   6  fast DID10 read
+//   7  fast DID10 write
+//   8  fast DID11 read
+//   9  fast DID11 write
+//  10  fast other
+//  11  normal DID10
+//  12  normal DID11
+//  13  normal other
+//  14  all accepted (== sum of words 6..13)
+//  15  sticky error bits
+//
+// Indices 16..31 expose a separate passive diagnostic bank; the original
+// words 0..15 are unchanged. Other indices read zero. rst is synchronous
+// and active high.
+//
+module dma_nonblock_observer #(
+    parameter int unsigned Mode = 2
+) (
+    input  logic        clk,
+    input  logic        rst,
+    input  logic        arm,
+    input  logic        open,
+    input  logic        close,
+    input  logic [7:0]  index,
+    output logic [63:0] rdata,
+    input  logic        accept,
+    input  logic        fast,
+    input  logic [23:0] did,
+    input  logic [5:0]  ttype,
+    input  logic [15:0] diag_events = 16'd0
+);
+    localparam logic [63:0] NB_MAGIC   = 64'h49444D414E424C01;
+    localparam logic [63:0] NB_VERSION = 64'd1;
+    localparam logic [63:0] DIAG_MAGIC = 64'h49444D414E444701;
+
+    // DID / transaction-type encodings used by the IOMMU.
+    localparam logic [23:0] DID_V = 24'd10;
+    localparam logic [23:0] DID_A = 24'd11;
+    localparam logic [5:0]  TT_R  = 6'b000010; // UNTRANSLATED_R
+    localparam logic [5:0]  TT_W  = 6'b000011; // UNTRANSLATED_W
+
+    // Error bit positions inside word 15.
+    localparam int E_OPEN_NO_ARM  = 0;
+    localparam int E_CLOSE_NO_ACT = 1;
+    localparam int E_OVERLAP      = 2;
+    localparam int E_OVERFLOW     = 3;
+    localparam int E_FAST_NO_ACPT = 4;
+    localparam int E_FAST_MODE1   = 5;
+    localparam int E_FAST_BAD_TT  = 6;
+
+    typedef enum logic [1:0] {S_OFF, S_ARMED, S_ACTIVE, S_FROZEN} state_e;
+
+    state_e      state_q, state_d;
+    logic [63:0] seq_q,   seq_d;
+    logic [63:0] cnt_q [16];
+    logic [63:0] cnt_d [16];
+    logic [63:0] err_q,   err_d;
+    logic [15:0] diag_seen_q, diag_seen_d;
+    logic [63:0] diag_cnt_q [9], diag_cnt_d [9];
+    logic diag_overflow_q, diag_overflow_d;
+
+    // Event classification selects (module scope so always_comb stays simple).
+    logic        ff_r10, ff_w10, ff_r11, ff_w11, ff_other;
+    logic        nn_10, nn_11, nn_other;
+    logic [3:0]  cat;
+    logic        arm_overlap;
+
+    always_comb begin
+        ff_r10   = fast && (did == DID_V) && (ttype == TT_R);
+        ff_w10   = fast && (did == DID_V) && (ttype == TT_W);
+        ff_r11   = fast && (did == DID_A) && (ttype == TT_R);
+        ff_w11   = fast && (did == DID_A) && (ttype == TT_W);
+        ff_other = fast && !(ff_r10 || ff_w10 || ff_r11 || ff_w11);
+        nn_10    = !fast && (did == DID_V);
+        nn_11    = !fast && (did == DID_A);
+        nn_other = !fast && (did != DID_V) && (did != DID_A);
+
+        cat = 4'd0;
+        if (accept) begin
+            if (ff_r10)        cat = 4'd6;
+            else if (ff_w10)   cat = 4'd7;
+            else if (ff_r11)   cat = 4'd8;
+            else if (ff_w11)   cat = 4'd9;
+            else if (fast)     cat = 4'd10;
+            else if (nn_10)    cat = 4'd11;
+            else if (nn_11)    cat = 4'd12;
+            else               cat = 4'd13;
+        end
+
+        arm_overlap = arm && (open || close);
+
+        state_d = state_q;
+        seq_d   = seq_q;
+        err_d   = err_q;
+        diag_seen_d = diag_seen_q;
+        diag_overflow_d = diag_overflow_q;
+        for (int i = 0; i < 9; i++) diag_cnt_d[i] = diag_cnt_q[i];
+        for (int i = 0; i < 16; i++) cnt_d[i] = cnt_q[i];
+
+        // ---- commands ----
+        // ARM clears the window and arms. Invalid while active or when asserted
+        // together with OPEN/CLOSE: set overlap error and preserve the window.
+        if (arm) begin
+            if (arm_overlap) begin
+                err_d[E_OVERLAP] = 1'b1;
+            end else if (state_q == S_ACTIVE) begin
+                err_d[E_OVERLAP] = 1'b1;
+            end else begin
+                state_d = S_ARMED;
+                err_d   = '0;
+                diag_seen_d = '0;
+                diag_overflow_d = 1'b0;
+                for (int i = 0; i < 9; i++) diag_cnt_d[i] = '0;
+                for (int i = 0; i < 16; i++) cnt_d[i] = '0;
+                if (seq_q == {64{1'b1}}) err_d[E_OVERFLOW] = 1'b1;
+                else                     seq_d = seq_q + 64'd1;
+            end
+        end
+
+        // OPEN is only legal from registered ARMED, with no same-cycle ARM.
+        // No open-edge event is counted.
+        if (open) begin
+            if (arm) begin
+                err_d[E_OVERLAP] = 1'b1; // ARM/OPEN overlap is invalid
+            end else if (state_q == S_ARMED) begin
+                state_d = S_ACTIVE;
+            end else if (state_q == S_ACTIVE) begin
+                err_d[E_OVERLAP] = 1'b1; // open while active
+            end else begin
+                err_d[E_OPEN_NO_ARM] = 1'b1; // open without arm
+            end
+        end
+
+        // CLOSE is only legal while registered ACTIVE, with no same-cycle ARM.
+        // Freezes the window.
+        if (close) begin
+            if (arm) begin
+                err_d[E_OVERLAP] = 1'b1; // ARM/CLOSE overlap is invalid
+            end else if (state_q == S_ACTIVE) begin
+                state_d = S_FROZEN;
+            end else begin
+                err_d[E_CLOSE_NO_ACT] = 1'b1;
+            end
+        end
+
+        // ---- window accumulation (open, close] ----
+        // Counting keys off the registered state, so the open-edge cycle is
+        // excluded and the close-edge cycle (state still S_ACTIVE) is included.
+        if (state_q == S_ACTIVE) begin
+            diag_seen_d = diag_seen_d | diag_events;
+            // Counts map to events 3..11. Probe phases can cross the window
+            // boundary; their counts need not form a complete lifecycle here.
+            for (int i = 0; i < 9; i++) begin
+                if (diag_events[i+3]) begin
+                    if (diag_cnt_d[i] == {64{1'b1}}) diag_overflow_d = 1'b1;
+                    else diag_cnt_d[i] = diag_cnt_d[i] + 64'd1;
+                end
+            end
+            if (cnt_d[5] == {64{1'b1}}) err_d[E_OVERFLOW] = 1'b1;
+            else                        cnt_d[5] = cnt_d[5] + 64'd1;
+
+            if (accept) begin
+                if (cnt_d[14] == {64{1'b1}}) err_d[E_OVERFLOW] = 1'b1;
+                else                         cnt_d[14] = cnt_d[14] + 64'd1;
+
+                if (cnt_d[cat] == {64{1'b1}}) err_d[E_OVERFLOW] = 1'b1;
+                else                          cnt_d[cat] = cnt_d[cat] + 64'd1;
+            end
+        end
+
+        // ---- fast protocol errors (sticky), only while a window is open/armed ----
+        if (state_q == S_ARMED || state_q == S_ACTIVE) begin
+            if (fast && !accept)                               err_d[E_FAST_NO_ACPT] = 1'b1;
+            if ((Mode == 1) && fast)                           err_d[E_FAST_MODE1]   = 1'b1;
+            if (fast && !((ttype == TT_R) || (ttype == TT_W))) err_d[E_FAST_BAD_TT]  = 1'b1;
+        end
+    end
+
+    always_comb begin
+        rdata = 64'd0;
+        case (index)
+            8'd0:  rdata = NB_MAGIC;
+            8'd1:  rdata = NB_VERSION;
+            8'd2:  rdata = 64'(Mode);
+            8'd3:  rdata = {61'd0, (state_q == S_FROZEN),
+                                     (state_q == S_ACTIVE),
+                                     (state_q == S_ARMED)};
+            8'd4:  rdata = seq_q;
+            8'd5:  rdata = cnt_q[5];
+            8'd6:  rdata = cnt_q[6];
+            8'd7:  rdata = cnt_q[7];
+            8'd8:  rdata = cnt_q[8];
+            8'd9:  rdata = cnt_q[9];
+            8'd10: rdata = cnt_q[10];
+            8'd11: rdata = cnt_q[11];
+            8'd12: rdata = cnt_q[12];
+            8'd13: rdata = cnt_q[13];
+            8'd14: rdata = cnt_q[14];
+            8'd15: rdata = err_q;
+            // Separate diagnostic bank: original words 0..15 stay unchanged.
+            8'd16: rdata = DIAG_MAGIC;
+            8'd17: rdata = 64'd1;
+            8'd18: rdata = 64'(Mode);
+            8'd19: rdata = {diag_overflow_q, 60'd0, (state_q == S_FROZEN),
+                                     (state_q == S_ACTIVE), (state_q == S_ARMED)};
+            8'd20: rdata = seq_q;
+            8'd21: rdata = cnt_q[5];
+            8'd22: rdata = {48'd0, diag_seen_q};
+            8'd23: rdata = diag_cnt_q[0];
+            8'd24: rdata = diag_cnt_q[1];
+            8'd25: rdata = diag_cnt_q[2];
+            8'd26: rdata = diag_cnt_q[3];
+            8'd27: rdata = diag_cnt_q[4];
+            8'd28: rdata = diag_cnt_q[5];
+            8'd29: rdata = diag_cnt_q[6];
+            8'd30: rdata = diag_cnt_q[7];
+            8'd31: rdata = diag_cnt_q[8];
+            default: rdata = 64'd0;
+        endcase
+    end
+
+    always_ff @(posedge clk) begin
+        if (rst) begin
+            state_q <= S_OFF;
+            seq_q   <= 64'd0;
+            err_q   <= 64'd0;
+            diag_seen_q <= '0;
+            diag_overflow_q <= 1'b0;
+            for (int i = 0; i < 9; i++) diag_cnt_q[i] <= 64'd0;
+            for (int i = 0; i < 16; i++) cnt_q[i] <= 64'd0;
+        end else begin
+            state_q <= state_d;
+            seq_q   <= seq_d;
+            err_q   <= err_d;
+            diag_seen_q <= diag_seen_d;
+            diag_overflow_q <= diag_overflow_d;
+            for (int i = 0; i < 9; i++) diag_cnt_q[i] <= diag_cnt_d[i];
+            for (int i = 0; i < 16; i++) cnt_q[i] <= cnt_d[i];
+        end
+    end
+endmodule
