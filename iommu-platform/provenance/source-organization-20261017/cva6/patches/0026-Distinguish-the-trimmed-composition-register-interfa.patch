From 476c7bfa0d17de4ada37d87d8f189760efd80b02 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:52:05 +0900
Subject: [PATCH 26/27] Distinguish the trimmed composition register interface
 version

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-OBSERVER-V9
Original-source: frozen original working source
Validation scope: source/patch identity only; no build, simulation or experiment.
Magic v9 prevents old drivers accepting the composition profile without legacy path/E3 stores.
---
 corev_apu/fpga/src/dma_observer.sv | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/corev_apu/fpga/src/dma_observer.sv b/corev_apu/fpga/src/dma_observer.sv
index 25ff895d726c545c990b72f393fe60e70c2e4843..97c2d96e19beb344520ff1164ec3d7e21ffa3813 100644
--- a/corev_apu/fpga/src/dma_observer.sv
+++ b/corev_apu/fpga/src/dma_observer.sv
@@ -39,7 +39,12 @@ module dma_observer #(
     output logic research_arm_o, research_open_o, research_close_o
 );
     // Low byte is interface version; a missing observer must never look valid.
-    localparam logic [63:0] Magic = ResearchEnable ? 64'h49444d414f425308 :
+    // V9: composition/P4M bank with neither legacy path timers nor E3.
+    // A distinct version makes old drivers reject this trimmed interface.
+    localparam bit TrimmedComposition = ResearchEnable && P4MEnable &&
+        !PathEnable && !E3Enable && !ControlledEnable;
+    localparam logic [63:0] Magic = TrimmedComposition ? 64'h49444d414f425309 :
+        ResearchEnable ? 64'h49444d414f425308 :
         (P4MEnable ? 64'h49444d414f425307 :
         ((ControlledEnable && E3Enable) ? 64'h49444d414f425306 :
         (E3Enable ? 64'h49444d414f425305 :
