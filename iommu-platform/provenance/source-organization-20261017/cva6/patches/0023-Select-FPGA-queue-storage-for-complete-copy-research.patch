From f4432405308bb27a5708b7bb4b9d2116b78373a2 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:52:05 +0900
Subject: [PATCH 23/27] Select FPGA queue storage for complete-copy research
 buffers

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-FULLBUFFER-RAM
Original-source: frozen original working source
Validation scope: source/patch identity only; no build, simulation or experiment.
Tracked vendor delta; FORCE_FPGA_RAM is selected only for 512 byte-wide lanes. Resource and timing costs are not validated by this organization.
---
 corev_apu/iDMA/src/idma_stream_fifo.sv               |  5 ++++-
 vendor/pulp-platform/common_cells/src/fifo_v3.sv     | 11 +++++++----
 vendor/pulp-platform/common_cells/src/stream_fifo.sv |  6 ++++--
 3 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/corev_apu/iDMA/src/idma_stream_fifo.sv b/corev_apu/iDMA/src/idma_stream_fifo.sv
index 73f7d33593d8c247a4f14d763860b2aa791b43d6..67b8b8a0f44d25ce93e1174bf9f33e33252d0f7f 100644
--- a/corev_apu/iDMA/src/idma_stream_fifo.sv
+++ b/corev_apu/iDMA/src/idma_stream_fifo.sv
@@ -104,7 +104,10 @@ module idma_stream_fifo #(
         // stream fifo
         stream_fifo #(
             .DEPTH        ( Depth  ),
-            .T            ( type_t )
+            .T            ( type_t ),
+            // Full 4 KiB N/S byte lanes use the existing FPGA RAM queue.
+            // Small legacy queues and other payload types keep their storage.
+            .FORCE_FPGA_RAM ( Depth == 32'd512 && $bits(type_t) == 8 )
         ) i_stream_fifo (
             .clk_i,
             .rst_ni,
diff --git a/vendor/pulp-platform/common_cells/src/fifo_v3.sv b/vendor/pulp-platform/common_cells/src/fifo_v3.sv
index 11b77e02583bd4b2da6eec0255b1b0c66f489ad1..417e0ef2205a5f294c9c55033f1640c459a53792 100644
--- a/vendor/pulp-platform/common_cells/src/fifo_v3.sv
+++ b/vendor/pulp-platform/common_cells/src/fifo_v3.sv
@@ -16,7 +16,9 @@ module fifo_v3 #(
     parameter int unsigned DEPTH        = 8,    // depth can be arbitrary from 0 to 2**32
     parameter type dtype                = logic [DATA_WIDTH-1:0],
     // DO NOT OVERWRITE THIS PARAMETER
-    parameter int unsigned ADDR_DEPTH   = (DEPTH > 1) ? $clog2(DEPTH) : 1
+    parameter int unsigned ADDR_DEPTH   = (DEPTH > 1) ? $clog2(DEPTH) : 1,
+    // Local FPGA storage selection; keep existing positional parameters intact.
+    parameter bit          FORCE_FPGA_RAM = 1'b0
 )(
     input  logic  clk_i,            // Clock
     input  logic  rst_ni,           // Asynchronous reset active low
@@ -36,6 +38,7 @@ module fifo_v3 #(
     // local parameter
     // FIFO depth - handle the case of pass-through, synthesizer will do constant propagation
     localparam int unsigned FifoDepth = (DEPTH > 0) ? DEPTH : 1;
+    localparam bit UseFpgaRam = ariane_pkg::FPGA_EN || FORCE_FPGA_RAM;
     // clock gating control
     logic gate_clock;
     // pointer to the read and write section of the queue
@@ -70,7 +73,7 @@ module fifo_v3 #(
         read_pointer_n  = read_pointer_q;
         write_pointer_n = write_pointer_q;
         status_cnt_n    = status_cnt_q;
-        if (ariane_pkg::FPGA_EN) begin
+        if (UseFpgaRam) begin
              fifo_ram_we             = '0;
              fifo_ram_read_address   = read_pointer_q;
              fifo_ram_write_address  = '0;
@@ -84,7 +87,7 @@ module fifo_v3 #(
 
         // push a new element to the queue
         if (push_i && ~full_o) begin
-            if (ariane_pkg::FPGA_EN) begin
+            if (UseFpgaRam) begin
                 fifo_ram_we = 1'b1;
                 fifo_ram_write_address = write_pointer_q;
                 fifo_ram_wdata = data_i;
@@ -149,7 +152,7 @@ module fifo_v3 #(
         end
     end
 
-    if (ariane_pkg::FPGA_EN) begin : gen_fpga_queue
+    if (UseFpgaRam) begin : gen_fpga_queue
         AsyncDpRam #(
             .ADDR_WIDTH (ADDR_DEPTH),
             .DATA_DEPTH (DEPTH),
diff --git a/vendor/pulp-platform/common_cells/src/stream_fifo.sv b/vendor/pulp-platform/common_cells/src/stream_fifo.sv
index e7c60e57e2f82abe691bba138674dba7cdacec76..ecd61140d03905222d21ed04d45ef921af8325b8 100644
--- a/vendor/pulp-platform/common_cells/src/stream_fifo.sv
+++ b/vendor/pulp-platform/common_cells/src/stream_fifo.sv
@@ -19,7 +19,8 @@ module stream_fifo #(
     parameter int unsigned DEPTH        = 8,
     parameter type         T            = logic [DATA_WIDTH-1:0],
     // DO NOT OVERWRITE THIS PARAMETER
-    parameter int unsigned ADDR_DEPTH  = (DEPTH > 1) ? $clog2(DEPTH) : 1
+    parameter int unsigned ADDR_DEPTH  = (DEPTH > 1) ? $clog2(DEPTH) : 1,
+    parameter bit          FORCE_FPGA_RAM = 1'b0
 ) (
     input  logic                  clk_i,      // Clock
     input  logic                  rst_ni,     // Asynchronous reset active low
@@ -48,7 +49,8 @@ module stream_fifo #(
         .FALL_THROUGH   (FALL_THROUGH),
         .DATA_WIDTH     (DATA_WIDTH),
         .DEPTH          (DEPTH),
-        .dtype(T)
+        .dtype(T),
+        .FORCE_FPGA_RAM (FORCE_FPGA_RAM)
     ) fifo_i (
         .clk_i,
         .rst_ni,
