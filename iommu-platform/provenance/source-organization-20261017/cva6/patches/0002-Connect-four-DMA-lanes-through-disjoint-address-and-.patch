From 54c62575ecc5154e009421d59f9778836db50bd3 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:50:15 +0900
Subject: [PATCH 02/27] Connect four DMA lanes through disjoint address and AXI
 ID spaces

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-INTEGRATION
Original-source: b63c5523, 7f642515
Validation scope: source/patch identity only; no build, simulation or experiment.
Each 4 KiB register page selects one DMA; mux source bits distinguish lanes. No scheduling or measurement policy.
---
 .../fpga/src/ariane_peripherals_xilinx.sv     | 143 +++++++++++++-----
 corev_apu/tb/ariane_soc_pkg.sv                |   2 +-
 2 files changed, 106 insertions(+), 39 deletions(-)

diff --git a/corev_apu/fpga/src/ariane_peripherals_xilinx.sv b/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
index 33ee67104f83e56a0e24404a12cb4d904f980709..e370c5bead58b95d744cc4044ce592198cc7f681 100644
--- a/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
+++ b/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
@@ -862,7 +862,11 @@ module ariane_peripherals #(
     typedef logic [ariane_soc::IdWidth-1:0]         iommu_id_t;
     typedef logic [ariane_soc::IdWidthSlave-1:0]    iommu_slv_id_t;
 
-    // AXI Bus between DMA-device and IOMMU TR IF
+    localparam int unsigned NumDMADevices = 4;
+    localparam int unsigned DmaAxiIdWidth =
+        ariane_soc::IdWidth - $clog2(NumDMADevices);
+
+    // AXI Bus between DMA devices and IOMMU TR IF
     // Extended with AXI support for untranslated transactions
     `AXI_TYPEDEF_EXT_ALL(axi_tr, iommu_addr_t, iommu_id_t, 
                             iommu_data_t, iommu_strb_t, iommu_user_t, 
@@ -870,6 +874,13 @@ module ariane_peripherals #(
     axi_tr_req_t axi_iommu_tr_req;
     axi_tr_resp_t axi_iommu_tr_resp;
 
+    typedef logic [DmaAxiIdWidth-1:0] dma_iommu_id_t;
+    `AXI_TYPEDEF_EXT_ALL(axi_dma_tr, iommu_addr_t, dma_iommu_id_t,
+                            iommu_data_t, iommu_strb_t, iommu_user_t,
+                            rv_iommu::device_id_t, logic, rv_iommu::process_id_t)
+    axi_dma_tr_req_t  [NumDMADevices-1:0] axi_dma_tr_req;
+    axi_dma_tr_resp_t [NumDMADevices-1:0] axi_dma_tr_resp;
+
     // AXI Bus between System Interconnect and IOMMU Programming IF
     `AXI_TYPEDEF_ALL(axi_prog, iommu_addr_t, iommu_slv_id_t, 
                      iommu_data_t, iommu_strb_t, iommu_user_t)
@@ -883,44 +894,100 @@ module ariane_peripherals #(
     //------------
     if (InclDMA) begin : gen_dma
 
-		// AXI Bus between iDMA and IOMMU TR IF
+        AXI_BUS #(
+            .AXI_ADDR_WIDTH ( AxiAddrWidth             ),
+            .AXI_DATA_WIDTH ( AxiDataWidth             ),
+            .AXI_ID_WIDTH   ( ariane_soc::IdWidthSlave ),
+            .AXI_USER_WIDTH ( AxiUserWidth             )
+        ) dma_cfg_bus [NumDMADevices-1:0]();
+
+        axi_demux_intf #(
+            .AXI_ID_WIDTH   ( ariane_soc::IdWidthSlave ),
+            .ATOP_SUPPORT   ( 1'b0                     ),
+            .AXI_ADDR_WIDTH ( AxiAddrWidth             ),
+            .AXI_DATA_WIDTH ( AxiDataWidth             ),
+            .AXI_USER_WIDTH ( AxiUserWidth             ),
+            .NO_MST_PORTS   ( NumDMADevices            ),
+            .MAX_TRANS      ( 8                        )
+        ) i_dma_cfg_demux (
+            .clk_i,
+            .rst_ni,
+            .test_i           ( 1'b0                ),
+            .slv_aw_select_i  ( dma_cfg.aw_addr[13:12] ),
+            .slv_ar_select_i  ( dma_cfg.ar_addr[13:12] ),
+            .slv              ( dma_cfg             ),
+            .mst              ( dma_cfg_bus         )
+        );
+
+        // AXI Bus between iDMAs and IOMMU TR IF
         // Extended with IOMMU AXI signals
-		AXI_BUS_EXT #(
-			.AXI_ADDR_WIDTH ( AxiAddrWidth          ),
-			.AXI_DATA_WIDTH ( AxiDataWidth          ),
-			.AXI_ID_WIDTH   ( ariane_soc::IdWidth   ),
-			.AXI_USER_WIDTH ( AxiUserWidth          ),
-			.AXI_SID_WIDTH  ( rv_iommu::DevIdWidth  ),
-			.AXI_SSID_WIDTH ( rv_iommu::ProcIdWidth )
-		) idma_axi_master ();
-
-        `AXI_ASSIGN_TO_REQ_EXT(axi_iommu_tr_req, idma_axi_master)
-        `AXI_ASSIGN_FROM_RESP(idma_axi_master, axi_iommu_tr_resp)
-
-        dma_core_wrap_intf #(
-            .AXI_ADDR_WIDTH     ( AxiAddrWidth             ),
-            .AXI_DATA_WIDTH     ( AxiDataWidth             ),
-            .AXI_ID_WIDTH       ( ariane_soc::IdWidth      ),
-            .AXI_SLV_ID_WIDTH   ( ariane_soc::IdWidthSlave ),
-            .AXI_USER_WIDTH     ( AxiUserWidth             ),
-            .JOB_FIFO_DEPTH     ( 8                        ),
-            .NUM_AX_IN_FLIGHT   ( 8                        ),
-            .MEM_SYS_DEPTH      ( 0                        ),
-            .RAW_COUPLING_AVAIL ( 0                        ),
-            .IS_TWO_D           ( 0                        ),
-
-            .DEVICE_ID          ( 24'd10          ),
-            .PROCESS_ID         ( 20'd20          ),
-            .AxID               ( 4'd0            )
-		) i_dma (
-			.clk_i      		( clk_i           ),
-			.rst_ni     		( rst_ni          ),
-			.testmode_i 		( 1'b0            ),
-			// slave port
-			.axi_slave  		( dma_cfg         ),
-			// master port
-			.axi_master 		( idma_axi_master )
-		);
+        AXI_BUS_EXT #(
+            .AXI_ADDR_WIDTH ( AxiAddrWidth          ),
+            .AXI_DATA_WIDTH ( AxiDataWidth          ),
+            .AXI_ID_WIDTH   ( DmaAxiIdWidth         ),
+            .AXI_USER_WIDTH ( AxiUserWidth          ),
+            .AXI_SID_WIDTH  ( rv_iommu::DevIdWidth  ),
+            .AXI_SSID_WIDTH ( rv_iommu::ProcIdWidth )
+        ) idma_axi_master [NumDMADevices-1:0]();
+
+        for (genvar i = 0; i < NumDMADevices; i++) begin : gen_idma_axi_assign
+            `AXI_ASSIGN_TO_REQ_EXT(axi_dma_tr_req[i], idma_axi_master[i])
+            `AXI_ASSIGN_FROM_RESP(idma_axi_master[i], axi_dma_tr_resp[i])
+        end
+
+        axi_mux #(
+            .SlvAxiIDWidth ( DmaAxiIdWidth        ),
+            .slv_aw_chan_t ( axi_dma_tr_aw_chan_t ),
+            .mst_aw_chan_t ( axi_tr_aw_chan_t     ),
+            .w_chan_t      ( axi_dma_tr_w_chan_t  ),
+            .slv_b_chan_t  ( axi_dma_tr_b_chan_t  ),
+            .mst_b_chan_t  ( axi_tr_b_chan_t      ),
+            .slv_ar_chan_t ( axi_dma_tr_ar_chan_t ),
+            .mst_ar_chan_t ( axi_tr_ar_chan_t     ),
+            .slv_r_chan_t  ( axi_dma_tr_r_chan_t  ),
+            .mst_r_chan_t  ( axi_tr_r_chan_t      ),
+            .slv_req_t     ( axi_dma_tr_req_t     ),
+            .slv_resp_t    ( axi_dma_tr_resp_t    ),
+            .mst_req_t     ( axi_tr_req_t         ),
+            .mst_resp_t    ( axi_tr_resp_t        ),
+            .NoSlvPorts    ( NumDMADevices        ),
+            .MaxWTrans     ( 8                    )
+        ) i_dma_iommu_tr_mux (
+            .clk_i,
+            .rst_ni,
+            .test_i      ( 1'b0              ),
+            .slv_reqs_i  ( axi_dma_tr_req    ),
+            .slv_resps_o ( axi_dma_tr_resp   ),
+            .mst_req_o   ( axi_iommu_tr_req  ),
+            .mst_resp_i  ( axi_iommu_tr_resp )
+        );
+
+        for (genvar i = 0; i < NumDMADevices; i++) begin : gen_dma_inst
+            dma_core_wrap_intf #(
+                .AXI_ADDR_WIDTH     ( AxiAddrWidth             ),
+                .AXI_DATA_WIDTH     ( AxiDataWidth             ),
+                .AXI_ID_WIDTH       ( DmaAxiIdWidth            ),
+                .AXI_SLV_ID_WIDTH   ( ariane_soc::IdWidthSlave ),
+                .AXI_USER_WIDTH     ( AxiUserWidth             ),
+                .JOB_FIFO_DEPTH     ( 8                        ),
+                .NUM_AX_IN_FLIGHT   ( 8                        ),
+                .MEM_SYS_DEPTH      ( 0                        ),
+                .RAW_COUPLING_AVAIL ( 0                        ),
+                .IS_TWO_D           ( 0                        ),
+
+                .DEVICE_ID          ( 24'(10 + i)              ),
+                .PROCESS_ID         ( 20'(20 + i)              ),
+                .AxID               ( '0                       )
+            ) i_dma (
+                .clk_i          ( clk_i              ),
+                .rst_ni         ( rst_ni             ),
+                .testmode_i     ( 1'b0               ),
+                // slave port
+                .axi_slave      ( dma_cfg_bus[i]     ),
+                // master port
+                .axi_master     ( idma_axi_master[i] )
+            );
+        end
     end
 
 	//--------------
diff --git a/corev_apu/tb/ariane_soc_pkg.sv b/corev_apu/tb/ariane_soc_pkg.sv
index 590cfeac2d3e70c0bb95398b6f274421dc45059e..b276574ba84ae8ab999b7ffe08f900f4f7c71bb7 100644
--- a/corev_apu/tb/ariane_soc_pkg.sv
+++ b/corev_apu/tb/ariane_soc_pkg.sv
@@ -59,7 +59,7 @@ package ariane_soc;
   localparam logic[63:0] SPILength      = 64'h800000;
   localparam logic[63:0] EthernetLength = 64'h10000;
   localparam logic[63:0] GPIOLength     = 64'h1000;
-  localparam logic[63:0] DMALength      = 64'h1000;     
+  localparam logic[63:0] DMALength      = 64'h4000;
   localparam logic[63:0] IOMMULength    = 64'h1000;     // Regmap occupies 4kiB of memory address space
   localparam logic[63:0] DRAMLength     = 64'h40000000; // 1GByte of DDR (split between two chips on Genesys2)
   localparam logic[63:0] SRAMLength     = 64'h1800000;  // 24 MByte of SRAM
