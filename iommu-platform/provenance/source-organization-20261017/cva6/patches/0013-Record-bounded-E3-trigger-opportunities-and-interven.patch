+        gate_event[3] = gate_event[1] && ctl_i.victim_waiting == 0;
+        gate_event[4] = gate_event[2] && !head_v;
+        gate_event[5] = active_i && tl_i.a_s1_miss && ctl_i.victim_waiting != 0;
+    end
