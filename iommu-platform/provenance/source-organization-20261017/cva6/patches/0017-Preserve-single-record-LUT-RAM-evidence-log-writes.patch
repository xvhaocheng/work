From 8872abc46fb931b10a6312f74bf174831cc2fd97 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:52:05 +0900
Subject: [PATCH 17/27] Preserve single-record LUT RAM evidence log writes

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-LOG-RAM
Original-source: 2ccb6401
Validation scope: source/patch identity only; no build, simulation or experiment.
---
 corev_apu/fpga/src/dma_research_observer.sv | 47 ++++++++++-----------
 1 file changed, 23 insertions(+), 24 deletions(-)

diff --git a/corev_apu/fpga/src/dma_research_observer.sv b/corev_apu/fpga/src/dma_research_observer.sv
index 486b0dde54ab0bcc7fa736976f6bd5fa053b7c47..0ed2786d069467790fd3df28cf29b044b4ced75e 100644
--- a/corev_apu/fpga/src/dma_research_observer.sv
+++ b/corev_apu/fpga/src/dma_research_observer.sv
@@ -158,10 +158,12 @@ module dma_research_observer #(
     logic [1:0]  fp_done_q;
     logic [2:0]  snapshot_valid_q;
     logic [31:0] plru_snap_q [3];
-    logic [63:0] snap_warm_q [32];
-    logic [63:0] snap_deadline_q [32];
-    logic [63:0] snap_freeze_q [32];
-    logic [63:0] event_ram_q [EventDepth*6];
+    // All snapshot words latch simultaneously: registers, not multiport RAM.
+    logic [31:0][63:0] snap_warm_q;
+    logic [31:0][63:0] snap_deadline_q;
+    logic [31:0][63:0] snap_freeze_q;
+    // One complete record per write port; the external word ABI is unchanged.
+    (* ram_style = "distributed" *) logic [383:0] event_ram_q [EventDepth];
     logic [31:0] e2a_issue_cnt_q, e2a_done_cnt_q;
     logic [63:0] e2a_first_q, e2a_last_q;
     logic        e2a_first_seen_q;
@@ -199,7 +201,7 @@ module dma_research_observer #(
     logic        sample_ovf_q;
     logic [31:0] cur_a_main_q, cur_a_req_q, cur_a_miss_q, cur_a_comp_q, cur_a_dur_q, cur_a_flags_q;
     logic [31:0] cur_v_main_q, cur_v_comp_q;
-    logic [63:0] sample_ram_q [SampleDepth*4];
+    (* ram_style = "distributed" *) logic [255:0] sample_ram_q [SampleDepth];
 
     // next-state (declared once; do not declare *_RAM_n because RAMs are FF-only)
     logic [1:0]  mode_n;
@@ -1253,26 +1255,21 @@ module dma_research_observer #(
                 snapshot_valid_q[2] <= 1'b1;
             end
 
-            // ---- committed update event log (identical old==new still logged)
-            if (evt_push) begin
-                event_ram_q[evt_base]        <= epoch_q;
-                event_ram_q[evt_base + 16'd1]<= evt_meta;
-                event_ram_q[evt_base + 16'd2]<= entries_i[slot_idx][63:0];
-                event_ram_q[evt_base + 16'd3]<= entries_i[slot_idx][127:64];
-                event_ram_q[evt_base + 16'd4]<= entries_next_i[slot_idx][63:0];
-                event_ram_q[evt_base + 16'd5]<= entries_next_i[slot_idx][127:64];
-            end
-
-            // ---- COST sample: every 16th fully contained completed A copy
-            if (sample_push) begin
-                sample_ram_q[smp_base]         <= done_id_i[1];
-                sample_ram_q[smp_base + 16'd1] <= {cur_a_main_n, cur_a_comp_n};
-                sample_ram_q[smp_base + 16'd2] <= {cur_a_req_n,  cur_a_miss_n};
-                sample_ram_q[smp_base + 16'd3] <= {cur_a_dur_n,  cur_a_flags_n};
-            end
         end
     end
 
+    // No RAM reset: reset/CLEAR invalidates counts; unread records return zero.
+    // A synchronous single-record write permits LUT RAM inference in Vivado.
+    always_ff @(posedge clk_i) begin
+        if (rst_ni && evt_push)
+            event_ram_q[event_count_q] <= {entries_next_i[slot_idx],
+                                          entries_i[slot_idx], evt_meta, epoch_q};
+        if (rst_ni && sample_push)
+            sample_ram_q[sample_count_q] <= {cur_a_dur_n, cur_a_flags_n,
+                                            cur_a_req_n, cur_a_miss_n,
+                                            cur_a_main_n, cur_a_comp_n, done_id_i[1]};
+    end
+
     // -------------------------------------------------------------- status
     logic [63:0] status_q, error_combined;
     always_comb begin
@@ -1370,12 +1367,14 @@ module dma_research_observer #(
                 rdata_o = snapshot_valid_q[2] ? snap_freeze_q[index_i - 13'h0140] : 64'd0;
         end else if (index_i >= 13'h0200 && index_i < 13'h0800) begin
             if ((index_i - 13'h0200) < (event_count_q * 16'd6))
-                rdata_o = event_ram_q[index_i - 13'h0200];
+                rdata_o = event_ram_q[(index_i - 13'h0200) / 6]
+                                    [((index_i - 13'h0200) % 6) * 64 +: 64];
             else
                 rdata_o = 64'd0;
         end else if (index_i >= 13'h0800 && index_i < 13'h0C00) begin
             if ((index_i - 13'h0800) < (sample_count_q * 16'd4))
-                rdata_o = sample_ram_q[index_i - 13'h0800];
+                rdata_o = sample_ram_q[(index_i - 13'h0800) / 4]
+                                     [((index_i - 13'h0800) % 4) * 64 +: 64];
             else
                 rdata_o = 64'd0;
         end else if (index_i >= 13'h0C00 && index_i < 13'h0C40) begin
