From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:52:05 +0900
Subject: [PATCH 12/27] Connect optional E3 PTW delay experiment controls

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-E3-ACTIVE
Original-source: 44068498
Validation scope: source/patch identity only; no build, simulation or experiment.
Active fixture: E3Enable and enable/arm/active/delay128 inputs can alter PTW service timing.
---
 corev_apu/fpga/src/ariane_peripherals_xilinx.sv | 3 +++
 corev_apu/riscv-iommu                           | 2 +-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/corev_apu/fpga/src/ariane_peripherals_xilinx.sv b/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
index 6f7e47ae6ed6b4051a80fccfeddf77d9d3af83da..2e9fee3a7d8ade887a69be70c9346f739440cc78 100644
--- a/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
+++ b/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
@@ -1158,6 +1158,7 @@ module ariane_peripherals #(
         //--------------
         rv_iommu_top #(
             .RVIOMMUCfg   (ariane_soc::RVIOMMUCfg),
+            .E3Enable(InclDMA),
 
             .axi_tr_aw_chan_t       (axi_tr_aw_chan_t),
             .axi_tr_w_chan_t        (axi_tr_w_chan_t),
@@ -1202,6 +1203,8 @@ module ariane_peripherals #(
             .prog_req_i   (axi_iommu_prog_req),
             .prog_resp_o  (axi_iommu_prog_resp),
             .wsi_wires_o  (irq_sources[(ariane_soc::RVIOMMUCfg.NumIntVec-1)+7:7]),
+            .e3_enable_i(e3_control[0]), .e3_arm_i(e3_control[1]),
+            .e3_active_i(e3_control[3]), .e3_delay128_i(e3_control[7]),
             .e3_ctl_o(e3_ctl), .e3_tl_o(e3_tl)
         );
 
diff --git a/corev_apu/riscv-iommu b/corev_apu/riscv-iommu
index 5304477888b627546fa5f46ef36735f78f0ee504..027583cd564af8ccb0cc05228756afa8a322d017 160000
--- a/corev_apu/riscv-iommu
+++ b/corev_apu/riscv-iommu
@@ -1 +1 @@
-Subproject commit 5304477888b627546fa5f46ef36735f78f0ee504
+Subproject commit 027583cd564af8ccb0cc05228756afa8a322d017
