From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:52:05 +0900
Subject: [PATCH 21/27] Expose passive batch-gap and complete frontend quiet
 status

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-QUIET-TAPS
Original-source: frozen original working source
Validation scope: source/patch identity only; no build, simulation or experiment.
Frozen dirty source; quiet covers idle state, backend idle, pending valid/issue and same-cycle launch reads. No switching controller yet.
---
 .../frontends/register_64bit/idma_reg64_frontend.sv    |  7 +++++++
 corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv   | 10 ++++++++--
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv b/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
index ab8e9a83c6b62e548d1f977e57d5513c9e447640..bcfb06acb01f5f57e551b98714bc5dddf8d1fc4b 100644
--- a/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
+++ b/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
@@ -31,6 +31,8 @@ module idma_reg64_frontend #(
     // Read-only event taps and optional observer register window.
     output logic obs_issue_o, obs_done_o, obs_poll_o,
     output logic batch_active_o,
+    output logic batch_gap_active_o,
+    output logic job_quiet_o,
     // ResearchPort policy gate (active only when ResearchPort).
     input  logic policy_enable_i, policy_allow_i, policy_abort_i, batch_reverse_i,
     // Optional controlled-launch handshake (active only when LaunchPort).
@@ -141,6 +143,11 @@ module idma_reg64_frontend #(
                              (full_addr >= LauncherBase) && !gap_access;
     assign batch_access = BatchPort && dma_ctrl_req_i.valid && full_addr[7] && !launcher_access;
     assign batch_active_o = BatchPort && batch_enable_q && state_q != IDLE;
+    // Passive observation of actual inserted wait; no control feedback.
+    assign batch_gap_active_o = BatchPort && batch_enable_q && state_q == GAP;
+    // Covers software jobs, queued backend work and a same-cycle launch read.
+    assign job_quiet_o = state_q == IDLE && backend_idle_i && !valid_o &&
+                         !issue && !dma_reg2hw.next_id.re;
     assign locked_write = batch_active_o && dma_ctrl_req_i.valid &&
                           dma_ctrl_req_i.write && !batch_access && !observer_access && !launcher_access;
     assign batch_cfg_ok = !batch_error_q && batch_target_q != 0 && batch_target_q <= 33'h100000000 &&
diff --git a/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv b/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv
index 29290e61b19a4b81f7e6d035218c4429b91ccf76..e648f9c6ae8ef54e670f5fd91e7ce7e38cd78ed2 100644
--- a/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv
+++ b/corev_apu/iDMA/src/systems/cva6_reg/dma_core_wrap.sv
@@ -45,6 +45,8 @@ module dma_core_wrap #(
     // Read-only event taps and optional observer register window.
     output logic obs_issue_o, obs_done_o, obs_poll_o,
   output logic batch_active_o,
+  output logic batch_gap_active_o,
+  output logic job_quiet_o,
   input  logic policy_enable_i, policy_allow_i, policy_abort_i, batch_reverse_i,
   input  logic launch_hold_i, launch_go_i, launch_cancel_i,
   output logic launch_held_o, launch_active_o, launch_cancelled_o, launch_error_o,
@@ -142,7 +144,7 @@ module dma_core_wrap #(
       .AxiIdWidth      ( AxiIdWidth     ),
       .AxID            ( AxID           )
     ) i_dma_frontend (
-      .obs_issue_o, .obs_done_o, .obs_poll_o, .batch_active_o,
+      .obs_issue_o, .obs_done_o, .obs_poll_o, .batch_active_o, .batch_gap_active_o, .job_quiet_o,
       .policy_enable_i, .policy_allow_i, .policy_abort_i, .batch_reverse_i,
       .launch_hold_i, .launch_go_i, .launch_cancel_i,
       .launch_held_o, .launch_active_o, .launch_cancelled_o, .launch_error_o,
@@ -192,6 +194,8 @@ module dma_core_wrap #(
 
   end else begin : gen_two_d
     assign batch_active_o = 1'b0;
+    assign batch_gap_active_o = 1'b0;
+    assign job_quiet_o = 1'b0; // unsupported frontend cannot authorize switching
     assign obs_issue_o = 1'b0;
     assign obs_done_o = 1'b0;
     assign obs_poll_o = 1'b0;
@@ -364,6 +368,8 @@ module dma_core_wrap_intf #(
     // Read-only event taps and optional observer register window.
     output logic obs_issue_o, obs_done_o, obs_poll_o,
   output logic batch_active_o,
+  output logic batch_gap_active_o,
+  output logic job_quiet_o,
   input  logic policy_enable_i, policy_allow_i, policy_abort_i, batch_reverse_i,
   input  logic launch_hold_i, launch_go_i, launch_cancel_i,
   output logic launch_held_o, launch_active_o, launch_cancelled_o, launch_error_o,
@@ -425,7 +431,7 @@ module dma_core_wrap_intf #(
     .PROCESS_ID       ( PROCESS_ID         ),
     .AxID             ( AxID               )
   ) i_dma_core_wrap (
-      .obs_issue_o, .obs_done_o, .obs_poll_o, .batch_active_o,
+      .obs_issue_o, .obs_done_o, .obs_poll_o, .batch_active_o, .batch_gap_active_o, .job_quiet_o,
       .policy_enable_i, .policy_allow_i, .policy_abort_i, .batch_reverse_i,
       .launch_hold_i, .launch_go_i, .launch_cancel_i,
       .launch_held_o, .launch_active_o, .launch_cancelled_o, .launch_error_o,
