From c7531c59b8840df12dde03f768ebee53486c3734 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:50:16 +0900
Subject: [PATCH 06/27] Expose passive DMA backend active-cycle counter

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-ACTIVE-CYCLES
Original-source: b98b0ef7
Validation scope: source/patch identity only; no build, simulation or experiment.
Only counts backend activity and exposes offset 0x50; not a DMA admission policy.
---
 .../register_64bit/idma_reg64_frontend.sv          | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv b/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
index 0a901a0b1931c514c929bccd888c80d8c3d514b6..3af045a80ad029c2b8134b9aeeae633de0abe363 100644
--- a/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
+++ b/corev_apu/iDMA/src/frontends/register_64bit/idma_reg64_frontend.sv
@@ -41,6 +41,8 @@ module idma_reg64_frontend #(
 );
 
     localparam int unsigned DmaRegisterWidth = 64;
+    localparam int unsigned DmaRegisterBlockAw = 7;
+    localparam logic [DmaRegisterBlockAw-1:0] ActiveCyclesOffset = 7'h50;
 
     typedef enum logic [1:0] { 
         IDLE    = 2'b00,
@@ -60,8 +62,10 @@ module idma_reg64_frontend #(
 
     // transaction id
     logic [DmaRegisterWidth-1:0] next_id, done_id;
+    logic [DmaRegisterWidth-1:0] active_cycles_q, active_cycles_n;
     logic issue;
     logic trans_complete;
+    logic active_cycles_read;
 
     dma_regs_rsp_t dma_ctrl_rsp_tmp;
 
@@ -145,8 +149,16 @@ module idma_reg64_frontend #(
         dma_hw2reg.next_id.d = '0;
         dma_hw2reg.done.d    = '0;
         dma_hw2reg.status.d  = ~backend_idle_i;
+        active_cycles_read   = dma_ctrl_req_i.valid &&
+                               !dma_ctrl_req_i.write &&
+                               (dma_ctrl_req_i.addr[DmaRegisterBlockAw-1:0] == ActiveCyclesOffset);
 
         dma_ctrl_rsp_o = dma_ctrl_rsp_tmp;
+        if (active_cycles_read) begin
+            dma_ctrl_rsp_o.rdata = active_cycles_q;
+            dma_ctrl_rsp_o.error = 1'b0;
+            dma_ctrl_rsp_o.ready = 1'b1;
+        end
 
         // use full width id from generator
         dma_hw2reg.done.d = done_id;
@@ -160,6 +172,7 @@ module idma_reg64_frontend #(
         // Counter data
         transf_counter_n  = transf_counter_q;
         transf_offset_n   = transf_offset_q;
+        active_cycles_n   = active_cycles_q + DmaRegisterWidth'(!backend_idle_i);
         state_n           = state_q;
 
         unique case (state_q)
@@ -233,5 +246,6 @@ module idma_reg64_frontend #(
     `FF(state_q,            state_n,            IDLE,   clk_i, rst_ni)
     `FF(transf_counter_q,   transf_counter_n,   '0,     clk_i, rst_ni)
     `FF(transf_offset_q,    transf_offset_n,    '0,     clk_i, rst_ni)
+    `FF(active_cycles_q,    active_cycles_n,    '0,     clk_i, rst_ni)
 
 endmodule : idma_reg64_frontend
