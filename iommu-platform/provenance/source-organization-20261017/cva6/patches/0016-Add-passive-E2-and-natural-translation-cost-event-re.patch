+                13'h0C12: rdata_o = 64'(cost_done_q[0]);
+                13'h0C13: rdata_o = 64'(cost_a_done_all_q);
+                13'h0C14: rdata_o = 64'(eligible_q);
+                13'h0C15: rdata_o = {48'd0, sample_count_q};
+                13'h0C16: rdata_o = {63'd0, sample_ovf_q};
