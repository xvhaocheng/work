+                end else begin
+                    window_closed_n = 1'b1;
+                    carry_out_n = lane_active_n[1];
+                    cost_active_n = 1'b0;
+                end
+            end
+        end
+
+        // p4m_arm dominates: reset and start (requires quiet and MODE_COST)
+        if (p4m_arm_i) begin
