+            if (p4m_open_i) begin
+                if (window_open_q) begin
+                    cost_err_n[4] = 1'b1;
+                end else begin
+                    window_open_n = 1'b1;
+                    window_closed_n = 1'b0;
+                    carry_in_n = lane_active_q[1];
+                end
+            end
+            if (p4m_close_i) begin
+                if (!window_open_q || window_closed_q) begin
