+                cost_err_n           = 16'd0;
+                cost_cycles_n        = '0;
+                cost_owner_err_n     = '0;
+                cost_a_done_all_n    = '0;
+                window_open_n        = 1'b0;
+                window_closed_n      = 1'b0;
+                win_cycles_n         = '0;
+                carry_in_n           = 1'b0;
+                carry_out_n          = 1'b0;
+                eligible_n           = '0;
+                sample_count_n       = 16'd0;
+                sample_ovf_n         = 1'b0;
+                cur_a_main_n         = 32'd0;
+                cur_a_req_n          = 32'd0;
+                cur_a_miss_n         = 32'd0;
+                cur_a_comp_n         = 32'd0;
+                cur_a_dur_n          = 32'd0;
+                cur_a_flags_n        = 32'd0;
+                cur_v_main_n         = 32'd0;
+                cur_v_comp_n         = 32'd0;
