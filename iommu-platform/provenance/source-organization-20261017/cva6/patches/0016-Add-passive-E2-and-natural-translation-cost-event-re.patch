+                end
+            end
+        end
+
+        // ------------------------------------------------------ config writes
+        if (cfg_valid_i && cfg_write_i) begin
+            unique case (index_i)
+                13'h0004: begin
+                    if ((wdata_i[63:2] != 62'd0) || (wdata_i[1:0] == 2'd3) ||
+                        (ph != E2_IDLE) || cost_active_q) begin
+                        e2_err_n[0] = 1'b1;
+                        if (wdata_i[1:0] == 2'd3) cost_err_n[6] = 1'b1;
