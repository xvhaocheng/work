+                13'h0C2B: rdata_o = {32'd0, cur_v_comp_q};
+                13'h0C2C: rdata_o = {62'd0, lane_active_q};
+                13'h0C2D: rdata_o = {16'd0, DID_A, DID_V};
+                default: rdata_o = 64'd0;
+            endcase
+        end
+    end
+
+endmodule
