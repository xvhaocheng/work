+                13'h0025: rdata_o = {32'd0, e2a_issue_cnt_q};
+                13'h0026: rdata_o = {32'd0, e2a_done_cnt_q};
+                13'h0027: rdata_o = e2a_first_q;
+                13'h0028: rdata_o = e2a_last_q;
+                13'h0030: rdata_o = src_iova_q;
+                13'h0031: rdata_o = dst_iova_q;
