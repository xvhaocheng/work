From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:50:16 +0900
Subject: [PATCH 03/27] Retain SC response byte offset until completion

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-SC-FIX
Original-source: 7f086b73
Validation scope: source/patch identity only; no build, simulation or experiment.
---
 core/cache_subsystem/wt_axi_adapter.sv | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/core/cache_subsystem/wt_axi_adapter.sv b/core/cache_subsystem/wt_axi_adapter.sv
index dd4cafb43399837bd58a1d7a8c9d63b12e9bcc60..64cf882f94c3692fad5c5af60a28ef41db405d08 100644
--- a/core/cache_subsystem/wt_axi_adapter.sv
+++ b/core/cache_subsystem/wt_axi_adapter.sv
@@ -136,7 +136,9 @@ module wt_axi_adapter import ariane_pkg::*; import wt_cache_pkg::*; #(
     axi_wr_be    = '0;
     axi_wr_lock  = '0;
     axi_wr_atop  = '0;
-    amo_off_d    = '0;
+    // Keep the SC byte lane until its delayed B response is consumed.
+    // The request FIFO can be empty for many cycles after the grant.
+    amo_off_d    = amo_off_q;
     amo_gen_r_d  = amo_gen_r_q;
 
     // read channel
