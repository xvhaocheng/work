From 844c603027b75f18c91605335342ec90d5c34016 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:50:16 +0900
Subject: [PATCH 05/27] Add explicit experimental DS service delay with 50/50
 defaults

Source-organization: 2026-10-17; new commit authored at actual current time.
Feature-ID: CVA6-DS-DELAY
Original-source: b98b0ef7
Validation scope: source/patch identity only; no build, simulation or experiment.
Active fixture: inserts axi_delayer and changes DS service timing. Excluded from both ordinary source baseline anchors.
---
 .../fpga/src/ariane_peripherals_xilinx.sv     | 32 +++++++++++++++++--
 corev_apu/fpga/src/ariane_xilinx.sv           |  6 ++++
 .../common_cells/src/stream_delay.sv          | 12 ++++---
 3 files changed, 43 insertions(+), 7 deletions(-)

diff --git a/corev_apu/fpga/src/ariane_peripherals_xilinx.sv b/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
index e370c5bead58b95d744cc4044ce592198cc7f681..9658c5e606f04ea50c131f87f74af5b25d0d2491 100644
--- a/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
+++ b/corev_apu/fpga/src/ariane_peripherals_xilinx.sv
@@ -28,7 +28,9 @@ module ariane_peripherals #(
     parameter bit InclGPIO     =  0,
     parameter bit InclTimer    =  1,
     parameter bit InclDMA      =  0,
-    parameter bit InclIOMMU    =  0
+    parameter bit InclIOMMU    =  0,
+    parameter int unsigned IOMMUDSFixedDelayInput  = 0,
+    parameter int unsigned IOMMUDSFixedDelayOutput = 0
 ) (
     input  logic       clk_i           , // Clock
     input  logic       clk_200MHz_i    ,
@@ -1034,8 +1036,32 @@ module ariane_peripherals #(
                             iommu_data_t, iommu_strb_t, iommu_user_t)
         axi_ds_req_t  axi_iommu_ds_req;
         axi_ds_resp_t axi_iommu_ds_resp;
-        `AXI_ASSIGN_FROM_REQ(iommu_ds, axi_iommu_ds_req)
-        `AXI_ASSIGN_TO_RESP(axi_iommu_ds_resp, iommu_ds)
+        axi_ds_req_t  axi_iommu_ds_delayed_req;
+        axi_ds_resp_t axi_iommu_ds_delayed_resp;
+
+        axi_delayer #(
+            .aw_chan_t          ( axi_ds_aw_chan_t          ),
+            .w_chan_t           ( axi_ds_w_chan_t           ),
+            .b_chan_t           ( axi_ds_b_chan_t           ),
+            .ar_chan_t          ( axi_ds_ar_chan_t          ),
+            .r_chan_t           ( axi_ds_r_chan_t           ),
+            .req_t              ( axi_ds_req_t              ),
+            .resp_t             ( axi_ds_resp_t             ),
+            .StallRandomInput   ( 1'b0                      ),
+            .StallRandomOutput  ( 1'b0                      ),
+            .FixedDelayInput    ( IOMMUDSFixedDelayInput    ),
+            .FixedDelayOutput   ( IOMMUDSFixedDelayOutput   )
+        ) i_iommu_ds_delayer (
+            .clk_i      ( clk_i                     ),
+            .rst_ni     ( rst_ni                    ),
+            .slv_req_i  ( axi_iommu_ds_req          ),
+            .slv_resp_o ( axi_iommu_ds_resp         ),
+            .mst_req_o  ( axi_iommu_ds_delayed_req  ),
+            .mst_resp_i ( axi_iommu_ds_delayed_resp )
+        );
+
+        `AXI_ASSIGN_FROM_REQ(iommu_ds, axi_iommu_ds_delayed_req)
+        `AXI_ASSIGN_TO_RESP(axi_iommu_ds_delayed_resp, iommu_ds)
 
         // AXI Bus between IOMMU Completion IF and System Interconnect
         `AXI_TYPEDEF_ALL(axi_comp, iommu_addr_t, iommu_id_t, 
diff --git a/corev_apu/fpga/src/ariane_xilinx.sv b/corev_apu/fpga/src/ariane_xilinx.sv
index 19c2e520c829a6d07f5693eb88dd1600982a0dbc..8877441d151a8d334f9dd5ea49af5234afbdcc7c 100644
--- a/corev_apu/fpga/src/ariane_xilinx.sv
+++ b/corev_apu/fpga/src/ariane_xilinx.sv
@@ -160,6 +160,10 @@ localparam AxiDataWidth = 64;
 localparam AxiIdWidthMaster = 4;
 localparam AxiIdWidthSlaves = AxiIdWidthMaster + $clog2(NBSlave);
 localparam AxiUserWidth = ariane_pkg::AXI_USER_WIDTH;
+// Extra delay cycles on IOMMU data-structure memory accesses.
+// At 50 MHz, 100 cycles model about 2 us of additional remote-memory latency.
+localparam int unsigned IOMMUDSFixedDelayInput = 50;
+localparam int unsigned IOMMUDSFixedDelayOutput = 50;
 
 `AXI_TYPEDEF_ALL(axi_slave,
                  logic [    AxiAddrWidth-1:0],
@@ -806,6 +810,8 @@ ariane_peripherals #(
     .InclGPIO     ( 1'b1             ),
     .InclDMA      ( 1'b1             ),
     .InclIOMMU    ( 1'b1             ),
+    .IOMMUDSFixedDelayInput  ( IOMMUDSFixedDelayInput  ),
+    .IOMMUDSFixedDelayOutput ( IOMMUDSFixedDelayOutput ),
     `ifdef KINTEX7
     .InclSPI      ( 1'b1         ),
     .InclEthernet ( 1'b1         )
diff --git a/vendor/pulp-platform/common_cells/src/stream_delay.sv b/vendor/pulp-platform/common_cells/src/stream_delay.sv
index 5051b6c24bf4ca94d41f816414c0ca73b21bd803..a0fe4ff124b86d5fda620ad90666d1fc8c9cca87 100644
--- a/vendor/pulp-platform/common_cells/src/stream_delay.sv
+++ b/vendor/pulp-platform/common_cells/src/stream_delay.sv
@@ -13,7 +13,7 @@
 
 module stream_delay #(
     parameter bit   StallRandom = 0,
-    parameter int   FixedDelay  = 1,
+    parameter int unsigned FixedDelay  = 1,
     parameter type  payload_t  = logic
 )(
     input  logic     clk_i,
@@ -34,7 +34,11 @@ module stream_delay #(
         assign payload_o = payload_i;
     end else begin : gen_delay
 
-        localparam int unsigned CounterBits = 4;
+        localparam int unsigned FixedDelayCounterBits = (FixedDelay > 1) ? $clog2(FixedDelay + 1) : 1;
+        localparam int unsigned CounterBits = StallRandom ?
+                                              ((FixedDelayCounterBits > 4) ? FixedDelayCounterBits : 4) :
+                                              FixedDelayCounterBits;
+        localparam logic [CounterBits-1:0] FixedDelayValue = CounterBits'(FixedDelay);
 
         typedef enum logic [1:0] {
             Idle, Valid, Ready
@@ -43,7 +47,7 @@ module stream_delay #(
         state_e state_d, state_q;
 
         logic       load;
-        logic [3:0] count_out;
+        logic [CounterBits-1:0] count_out;
         logic       en;
 
         logic [CounterBits-1:0] counter_load;
@@ -103,7 +107,7 @@ module stream_delay #(
                 .refill_way_bin ( counter_load )
             );
         end else begin : gen_fixed_delay
-            assign counter_load = FixedDelay;
+            assign counter_load = FixedDelayValue;
         end
 
         counter #(
