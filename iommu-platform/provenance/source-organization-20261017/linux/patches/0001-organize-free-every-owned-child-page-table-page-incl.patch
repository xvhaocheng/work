From 4bd68b42c79fd7e7363d2e32151156f24123abe6 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:58:13 +0900
Subject: [PATCH 1/9] organize: free every owned child page-table page
 including lowest-level tables

---
 drivers/iommu/riscv/io_pgtable.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/iommu/riscv/io_pgtable.c b/drivers/iommu/riscv/io_pgtable.c
index 85767588a741dfc2df457d9097e83ef668abf3f9..6492bf829df50a40632ea8d2c98cee92f7caa807 100644
--- a/drivers/iommu/riscv/io_pgtable.c
+++ b/drivers/iommu/riscv/io_pgtable.c
@@ -45,7 +45,7 @@ static void riscv_iommu_pt_walk_free(pmd_t * ptp, unsigned shift, bool root)
 	pmd_t *pte, *pt_base;
 	int i;
 
-	if (shift == PAGE_SHIFT)
+	if (WARN_ON(shift < PAGE_SHIFT))
 		return;
 
 	if (root)
@@ -57,12 +57,14 @@ static void riscv_iommu_pt_walk_free(pmd_t * ptp, unsigned shift, bool root)
 	/* Recursively free all sub page table pages */
 	for (i = 0; i < PTRS_PER_PMD; i++) {
 		pte = pt_base + i;
-		if (pmd_present(*pte) && !pmd_leaf(*pte))
+		if (shift > PAGE_SHIFT && pmd_present(*pte) && !pmd_leaf(*pte))
 			riscv_iommu_pt_walk_free(pte, shift - 9, false);
 	}
 
 	/* Now free the current page table page */
-	if (!root && pmd_present(*pt_base))
+	/* A child table is owned even when entry zero is empty. The caller
+	 * reached it only through a present non-leaf parent entry. */
+	if (!root)
 		free_page((unsigned long)pt_base);
 }
 
