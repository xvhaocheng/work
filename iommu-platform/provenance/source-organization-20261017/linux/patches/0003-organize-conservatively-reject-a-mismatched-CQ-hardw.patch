From 1ae4817d975a49127616361ffba9aa01fbef3d67 Mon Sep 17 00:00:00 2001
From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:58:29 +0900
Subject: [PATCH 3/9] organize: conservatively reject a mismatched CQ hardware
 tail before posting

---
 drivers/iommu/riscv/iommu.c | 12 +-----------
 1 file changed, 1 insertion(+), 11 deletions(-)

diff --git a/drivers/iommu/riscv/iommu.c b/drivers/iommu/riscv/iommu.c
index 5e9f8d936f6c0cc99ebb59daec78f433fa81914f..a7bb545d53def1f165539d333e4b75af6a8f67d1 100644
--- a/drivers/iommu/riscv/iommu.c
+++ b/drivers/iommu/riscv/iommu.c
@@ -489,17 +489,7 @@ static bool riscv_iommu_post_sync(struct riscv_iommu_device *iommu,
 	last = iommu->cmdq.lui;
 	if (tail != last) {
 		spin_unlock_irqrestore(&iommu->cq_lock, flags);
-		/* TRY AGAIN */
-		dev_err(iommu->dev, "IOMMU CQT: %x != %x (1st)\n", last, tail);
-		spin_lock_irqsave(&iommu->cq_lock, flags);
-		tail =
-		    riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQT) & (iommu->cmdq.cnt - 1);
-		last = iommu->cmdq.lui;
-		if (tail != last) {
-			spin_unlock_irqrestore(&iommu->cq_lock, flags);
-			dev_err(iommu->dev, "IOMMU CQT: %x != %x (2nd)\n", last, tail);
-			spin_lock_irqsave(&iommu->cq_lock, flags);
-		}
+		return false;
 	}
 
 	next = (last + 1) & (iommu->cmdq.cnt - 1);
