From: xvhaocheng <xvhaocheng@gmail.com>
Date: Sat, 17 Oct 2026 14:58:13 +0900
Subject: [PATCH 2/9] organize: initialize the endpoint domain-list node

---
 drivers/iommu/riscv/iommu.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/iommu/riscv/iommu.c b/drivers/iommu/riscv/iommu.c
index 51cb7e2db136727613913f3784ef2b3a6757d9c2..5e9f8d936f6c0cc99ebb59daec78f433fa81914f 100644
--- a/drivers/iommu/riscv/iommu.c
+++ b/drivers/iommu/riscv/iommu.c
@@ -1298,7 +1298,7 @@ static struct iommu_device *riscv_iommu_probe_device(struct device *dev)
 
 	mutex_init(&ep->lock);
 	INIT_LIST_HEAD(&ep->regions);
-	INIT_LIST_HEAD(&ep->regions);
+	INIT_LIST_HEAD(&ep->domains);
 
 	if (dev_is_pci(dev)) {
 		ep->devid = pci_dev_id(to_pci_dev(dev));
