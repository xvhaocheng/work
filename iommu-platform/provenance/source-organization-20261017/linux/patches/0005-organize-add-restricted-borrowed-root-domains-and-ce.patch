+	/* Never discard a root that an endpoint (or uncertain CQ) can use. */
+	if (WARN_ON(!list_empty(&domain->endpoints)) ||
+	    (domain->research_domain && !reclaim_id)) {
+		mutex_unlock(&domain->lock);
+		mutex_unlock(&riscv_iommu_domain_mutex);
