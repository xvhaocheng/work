 EXPORT_SYMBOL_GPL(riscv_iommu_research_supported);
 
+struct iommu_domain *riscv_iommu_research_domain_alloc(struct device *dev,
+						     struct mm_struct *mm)
+{
+	struct riscv_iommu_endpoint *ep = riscv_iommu_hpm_endpoint(dev);
+	struct riscv_iommu_domain *domain;
+	struct iommu_domain *core;
+	int ret;
+
+	if (!research || !IS_ENABLED(CONFIG_64BIT) ||
+	    IS_ENABLED(CONFIG_CPU_BIG_ENDIAN) ||
+	    (satp_mode >> 60) != RISCV_IOMMU_DC_FSC_IOSATP_MODE_SV39 ||
+	    !riscv_iommu_research_ep_ok(ep))
+		return ERR_PTR(-EOPNOTSUPP);
+	if (mm && (mm != current->mm || !mm->pgd))
+		return ERR_PTR(-EINVAL);
+	core = iommu_domain_alloc(dev->bus);
+	if (!core)
+		return ERR_PTR(-ENOMEM);
+	domain = iommu_domain_to_riscv(core);
+	domain->research_domain = true;
+	if (mm) {
+		mmap_assert_locked(mm);
+		mmget(mm);
+		domain->borrowed_mm = mm;
+		domain->pgd_borrowed = true;
+		domain->pgd_root = mm->pgd;
+	}
+	mutex_lock(&domain->lock);
+	ret = riscv_iommu_domain_finalize(domain, ep->iommu);
+	mutex_unlock(&domain->lock);
+	if (ret) {
+		iommu_domain_free(core);
+		return ERR_PTR(ret);
+	}
+	return core;
+}
+EXPORT_SYMBOL_GPL(riscv_iommu_research_domain_alloc);
+
+int riscv_iommu_research_domain_release(struct iommu_domain *core)
+{
+	struct riscv_iommu_domain *domain;
+	int ret = 0;
+
+	if (!core || core->ops != &riscv_iommu_domain_ops)
+		return -EINVAL;
+	domain = iommu_domain_to_riscv(core);
+	mutex_lock(&riscv_iommu_domain_mutex);
+	mutex_lock(&domain->lock);
+	if (!domain->research_domain)
+		ret = -EINVAL;
+	else if (!list_empty(&domain->endpoints))
+		ret = -EBUSY;
+	else if (domain->ever_attached &&
+		 (READ_ONCE(domain->iommu->research_cq_poisoned) ||
+		  READ_ONCE(domain->iommu->research_epoch) <=
+					domain->retired_epoch))
+		ret = -EIO;
+	mutex_unlock(&domain->lock);
+	mutex_unlock(&riscv_iommu_domain_mutex);
+	/* Caller owns this unattached domain and serializes any future attach. */
+	if (!ret)
+		iommu_domain_free(core);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(riscv_iommu_research_domain_release);
+
