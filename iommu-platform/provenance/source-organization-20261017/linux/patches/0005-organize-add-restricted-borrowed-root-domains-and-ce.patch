+fail_root:
+	free_pages((unsigned long)domain->pgd_root, domain->g_stage ? 2 : 0);
+	domain->pgd_root = NULL;
+fail_id:
+	ida_free(domain->g_stage ? &riscv_iommu_gscids : &riscv_iommu_pscids, id);
+	domain->id_allocated = false;
+	domain->id = 0;
+	domain->mode = RISCV_IOMMU_DC_FSC_MODE_BARE;
+	return -ENOMEM;
 }
 
