-
-	/* TODO: Fix this for RV32 */
+	id = domain->g_stage ? ida_alloc_range(&riscv_iommu_gscids, 1,
+						  GENMASK(15, 0), GFP_KERNEL) :
+		ida_alloc_range(&riscv_iommu_pscids, RISCV_IOMMU_DOMAIN_PSCID_MIN,
+				RISCV_IOMMU_DOMAIN_PSCID_MAX, GFP_KERNEL);
