-static void riscv_iommu_detach_endpoint(struct riscv_iommu_endpoint *ep)
+static int riscv_iommu_detach_endpoint(struct riscv_iommu_endpoint *ep)
 {
+	struct riscv_iommu_domain *old;
+	int ret = 0;
+
+	mutex_lock(&riscv_iommu_domain_mutex);
+	old = ep->domain;
+	if (old)
+		mutex_lock(&old->lock);
 	mutex_lock(&ep->lock);
+	if (ep->dc) {
+		ep->dc->tc = 0;
+		wmb();
