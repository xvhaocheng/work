  "scope_disclaimers": [
    "pure static geometry over byte offsets; not a DUT, not RTL, not a simulation run",
    "no real request lookahead, no multiple W-head ordering, no shared spill parking and no translation blocking are modelled (contract line 13)",
    "no real independent-stop capacity is claimed; B=24/1024 are assumed static capacities only (contract line 32)",
    "no TL/PTW request counts, timing, cycles, area, CPU supply cost or macrocopy cost are computed or claimed",
    "H only bounds the distance between selected destination checkpoints; it is not a cycle budget or a DDR/TC/translation budget (contract line 50)",
    "the two enumeration groups are two deliberately different input covers, not independent DUT repetitions (contract line 30)",
    "source 24 / AW 17 and the 9-subjob tiling are ideal static legalizer segmentation counts, not measured request counts (contract line 33)",
    "geometric feasibility here does not imply that real RTL can stop at those byte offsets (contract lines 5-13 and 134-145)"
  ],
  "model_definition": {
    "scope": "pure_static_geometry_not_rtl",
    "coordinates": "byte offsets inside one byte-preserving copy [0, N]; source and destination physical addresses are not modelled",
    "N": "positive integer length in byte units",
    "R0": "mandatory source endpoints, contains 0 and N; never modified or deleted",
    "D": "destination completion endpoints, contains 0 and N",
    "A": "legal new source cut endpoints, contains 0 and N and covers R0",
    "C": "new cuts, subset of A minus R0, each new cut costs exactly 1",
    "B": "assumed static independent stop capacity in the same byte units; no real independent-stop capacity is claimed (contract line 34)",
    "H": "upper bound on the distance between consecutive selected destination checkpoints only; no backpressure or pre-accepted lookahead is modelled (contract lines 9 and 50)",
    "support": "q in D is supported by endpoint set R iff some p in R satisfies q <= p <= min(q+B, N)",
    "closure": "walk sorted supported checkpoints from 0 while the next is within H of the last reachable one; return the largest reachable endpoint",
    "greedy": "close the free prefix; if it reaches N stop; otherwise pick the largest SUPPORTABLE destination checkpoint q* inside (x, x+H] and add the right-most legal cut of I(q*) = [q*, min(q*+B, N)] (contract line 19)",
    "brute": "independent oracle: enumerate all subsets of A minus R0 by increasing size and test feasibility with an independent checkpoint-DAG reachability scan; never calls greedy and never reuses a greedy decision (contract line 23)",
    "naive_node_cost": "old control model only: node cost 0 if a mandatory R0 endpoint supports the checkpoint, else 1 if any legal A endpoint supports it; shortest path over the gap<=H DAG; it does not carry the support range of already chosen cuts and may over-count (contract line 25)"
  },
