+static int iommu_finite_pa_cmp(const void *a, const void *b)
+{
+	u64 pa = *(const u64 *)a, pb = *(const u64 *)b;
+
+	return (pa > pb) - (pa < pb);
+}
+
+/*
+ * Only the finite kernel owner's GFP_KERNEL dma_alloc_attrs records are
+ * admissible. CPU/IOVA identity checks do not establish atomic-pool provenance.
+ * No old allocation/free/unmap callback is changed by this additive path.
+ */
+int iommu_dma_free_finite_checked(struct device *dev,
+				  struct iommu_finite_allocation *items,
+				  unsigned int nr,
+				  int (*checked_sync)(void *), void *sync_data)
+{
+	struct iommu_domain *domain;
+	struct iommu_dma_cookie *cookie;
+	struct iova_domain *iovad;
+	struct iommu_finite_leaf *leaves = NULL, leaf;
+	struct iommu_iotlb_gather gather;
+	u64 *pas = NULL;
+	size_t total_pages = 0, nr_leaves = 0, nr_pas = 0, off, n;
+	unsigned int i, j;
+	int ret = -EINVAL;
+
+	if (!dev || !items || !nr || nr > 8 || !checked_sync)
+		return -EINVAL;
+	if (irqs_disabled() || in_interrupt())
+		return -EWOULDBLOCK;
+	if (get_dma_ops(dev) != &iommu_dma_ops)
+		return -EOPNOTSUPP;
+#ifdef CONFIG_DMA_OPS_BYPASS
+	if (dev->dma_ops_bypass)
+		return -EOPNOTSUPP;
+#endif
+#ifdef CONFIG_DMA_DECLARE_COHERENT
+	if (dev->dma_mem)
+		return -EOPNOTSUPP;
+#endif
+	domain = iommu_get_dma_domain(dev);
+	if (!domain || domain != iommu_get_domain_for_dev(dev) ||
+	    domain->type != IOMMU_DOMAIN_DMA || !domain->iova_cookie)
+		return -EOPNOTSUPP;
+	cookie = domain->iova_cookie;
+	if (cookie->type != IOMMU_DMA_IOVA_COOKIE ||
+	    READ_ONCE(cookie->fq_domain))
+		return -EOPNOTSUPP;
+	iovad = &cookie->iovad;
+	if (iovad->granule != PAGE_SIZE || iovad->granule != SZ_4K)
+		return -EOPNOTSUPP;
+
+	/* Check every allocation before revoking even one PTE. */
+	for (i = 0; i < nr; i++) {
+		struct iommu_finite_allocation *item = &items[i];
+		struct iova *reservation;
+		unsigned long cpu_end, iova_end;
+		size_t pages;
+
+		if (!item->cpu_addr || !item->size ||
+		    !IS_ALIGNED(item->size, PAGE_SIZE) ||
+		    !IS_ALIGNED((unsigned long)item->cpu_addr, PAGE_SIZE) ||
+		    !IS_ALIGNED(item->handle, PAGE_SIZE) ||
+		    item->handle > ULONG_MAX ||
+		    check_add_overflow((unsigned long)item->cpu_addr,
+				       item->size, &cpu_end) ||
+		    check_add_overflow((unsigned long)item->handle,
+				       item->size, &iova_end))
+			goto out;
+		pages = item->size >> PAGE_SHIFT;
+		/* __iommu_dma_free uses an int page count. */
+		if (pages > INT_MAX ||
+		    check_add_overflow(total_pages, pages, &total_pages)) {
+			ret = -E2BIG;
+			goto out;
+		}
+		for (j = 0; j < i; j++)
+			if (((unsigned long)item->cpu_addr <
+			     (unsigned long)items[j].cpu_addr + items[j].size &&
+			     (unsigned long)items[j].cpu_addr < cpu_end) ||
+			    (item->handle < items[j].handle + items[j].size &&
+			     items[j].handle < iova_end))
+				goto out;
+		if (is_vmalloc_addr(item->cpu_addr)) {
+			struct vm_struct *area = find_vm_area(item->cpu_addr);
+
+			if (!area || area->addr != item->cpu_addr ||
+			    area->flags != VM_DMA_COHERENT ||
+			    get_vm_area_size(area) != item->size)
+				goto out;
+		} else if (!virt_addr_valid(item->cpu_addr)) {
+			goto out;
+		}
+		reservation = find_iova(iovad, item->handle >> PAGE_SHIFT);
+		/* Narrow interface: reject allocator padding, not foreign extents. */
+		if (!reservation || reservation->pfn_lo !=
+		    item->handle >> PAGE_SHIFT || iova_size(reservation) != pages)
+			goto out;
+	}
+	leaves = kvcalloc(total_pages, sizeof(*leaves), GFP_KERNEL);
+	pas = kvcalloc(total_pages, sizeof(*pas), GFP_KERNEL);
+	if (!leaves || !pas) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	for (i = 0; i < nr; i++) {
+		struct iommu_finite_allocation *item = &items[i];
+
+		for (off = 0; off < item->size; off += leaf.bytes) {
+			ret = riscv_iommu_finite_leaf(dev, item->handle + off,
+						      &leaf);
+			if (ret)
+				goto out;
+			if (leaf.iova != item->handle + off || !leaf.bytes ||
+			    !IS_ALIGNED(leaf.bytes, PAGE_SIZE) ||
+			    leaf.bytes > item->size - off ||
+			    (leaf.pte & (BIT_ULL(0) | BIT_ULL(1) | BIT_ULL(2))) !=
+				 (BIT_ULL(0) | BIT_ULL(1) | BIT_ULL(2)) ||
+			    (leaf.pte & BIT_ULL(3))) {
+				ret = -EPROTO;
+				goto out;
+			}
+			if (!(domain->pgsize_bitmap & leaf.bytes)) {
+				ret = -EOPNOTSUPP;
+				goto out;
+			}
+			leaves[nr_leaves++] = leaf;
+			for (n = 0; n < leaf.bytes; n += PAGE_SIZE) {
+				void *addr = item->cpu_addr + off + n;
+				struct page *page;
+
+				if (!is_vmalloc_addr(addr) && !virt_addr_valid(addr)) {
+					ret = -EINVAL;
+					goto out;
+				}
+				page = is_vmalloc_addr(addr) ? vmalloc_to_page(addr) :
+								 virt_to_page(addr);
+				if (!page || page_to_phys(page) != leaf.pa + n) {
+					ret = -ESTALE;
+					goto out;
+				}
+				pas[nr_pas++] = page_to_phys(page);
+			}
+		}
+	}
+	sort(pas, nr_pas, sizeof(*pas), iommu_finite_pa_cmp, NULL);
+	for (n = 1; n < nr_pas; n++)
+		if (pas[n] == pas[n - 1]) {
+			ret = -EXDEV;
+			goto out;
+		}
+
+	/* IOVA reservations and all CPU/backing objects remain owned here. */
+	for (n = 0; n < nr_leaves; n++) {
+		ret = riscv_iommu_finite_leaf(dev, leaves[n].iova, &leaf);
+		if (ret)
+			goto out;
+		if (memcmp(&leaf, &leaves[n], sizeof(leaf))) {
+			ret = -ESTALE;
+			goto out;
+		}
+		iommu_iotlb_gather_init(&gather);
+		if (iommu_unmap_fast(domain, leaf.iova, leaf.bytes, &gather) !=
+		    leaf.bytes) {
+			ret = -EIO;
+			goto out;
+		}
+		/* The validated RISC-V leaf callback never retires table pages. */
+		if (WARN_ON_ONCE(!list_empty(&gather.freelist))) {
+			ret = -EOPNOTSUPP;
+			goto out;
+		}
+	}
+	for (i = 0; i < nr; i++)
+		for (off = 0; off < items[i].size; off += PAGE_SIZE) {
+			ret = riscv_iommu_finite_leaf(dev, items[i].handle + off,
+						      &leaf);
+			if (ret != -ENOENT) {
+				if (!ret)
+					ret = -EBUSY;
+				goto out;
+			}
+		}
+	ret = checked_sync(sync_data);
+	if (ret)
+		goto out;
+	if (iommu_get_dma_domain(dev) != domain ||
+	    iommu_get_domain_for_dev(dev) != domain ||
+	    get_dma_ops(dev) != &iommu_dma_ops || READ_ONCE(cookie->fq_domain)) {
+		ret = -ESTALE;
+		goto out;
+	}
+
+	/* Checked invalidation succeeded AFTER the PTE revocations. No second unmap. */
+	for (i = 0; i < nr; i++) {
+		iommu_dma_free_iova(cookie, items[i].handle, items[i].size, NULL);
+		debug_dma_free_coherent(dev, items[i].size,
+					items[i].cpu_addr, items[i].handle);
+		__iommu_dma_free(dev, items[i].size, items[i].cpu_addr);
+	}
+	ret = 0;
+out:
+	kvfree(pas);
+	kvfree(leaves);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(iommu_dma_free_finite_checked);
+#endif /* IS_BUILTIN(CONFIG_RISCV_IOMMU) */
