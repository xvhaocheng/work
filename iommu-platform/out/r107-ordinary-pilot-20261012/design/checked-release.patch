+++ b/drivers/iommu/dma-iommu.c
@@ -31,6 +31,13 @@
 #include <linux/vmalloc.h>
 
 #include "dma-iommu.h"
+
+#if IS_BUILTIN(CONFIG_RISCV_IOMMU)
+#include <linux/iommu-finite.h>
+#include <linux/overflow.h>
+#include <linux/sort.h>
