printf 'R111_BOOT='; cat /proc/sys/kernel/random/boot_id; printf 'R111_KERNEL='; uname -r; printf 'R111_NETWORK\n'; ip addr show eth0; printf 'R111_ROUTE\n'; ip route; printf 'R111_PARTITION\n'; cat /sys/class/block/mmcblk0p1/start /sys/class/block/mmcblk0p1/size; printf 'R111_MOUNTS\n'; cat /proc/mounts; printf 'R111_TOOLS\n'; command -v wget; command -v busybox; command -v sha256sum; command -v nc; printf 'R111_MEMORY\n'; head -n 5 /proc/meminfo
