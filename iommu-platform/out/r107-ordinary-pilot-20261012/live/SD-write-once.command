( printf 'R111_SD_WRITE_BEGIN\n'; platform-sd-update --device /dev/mmcblk0p1 --image /tmp/r107-stage111/fw_payload-stage111.bin; task_sd_rc=$?; printf 'R111_SD_WRITE_RETURN=%s\n' "$task_sd_rc"; if test "$task_sd_rc" -ne 0; then exit "$task_sd_rc"; fi; printf 'R111_PADDED_PARTITION_SHA='; sha256sum /dev/mmcblk0p1; task_sha_rc=$?; printf 'R111_PARTITION_HASH_RETURN=%s\n' "$task_sha_rc"; exit "$task_sha_rc" )
