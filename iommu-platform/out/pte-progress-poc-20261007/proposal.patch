     );
 
+    // ========================================================================
+    // Test-only completion-AR ingress proxy.  AW/W/R/B are untouched.
+    // ========================================================================
+    nonblock_read_admission #(
+        .BankIdBit (2),
+        .IdWidth   (4),
+        .AddrWidth (64),
+        .LenWidth  (8),
+        .ar_chan_t (slv_ar_chan_t)
+    ) i_read_admission (
+        .clk_i,
+        .rst_ni,
+        .mode_i   (read_admit_mode_i),
+        .budget_i (read_budget_i),
+        .period_i (read_period_i),
+
+        .s_ar_valid (u_comp_ar_valid),
+        .s_ar_ready (u_comp_ar_ready),
+        .s_ar_chan  (u_comp_ar_chan),
