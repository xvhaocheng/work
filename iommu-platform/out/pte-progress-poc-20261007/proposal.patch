diff --git a/tests/nonblock_read_admission.sv b/tests/nonblock_read_admission.sv
new file mode 100644
--- /dev/null
+++ b/tests/nonblock_read_admission.sv
@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: Apache-2.0 WITH SHL-2.1
+//
+// tests/nonblock_read_admission.sv
+//
+// TEST-ONLY ingress proxy for the completion AR channel. NOT PRODUCTION RTL.
+// It sits between the inner harness completion AR port and the system-top
+// crossbar slave port 2. AW/W/R/B paths are untouched.
+//
+// Modes (input, runtime):
+//   0 none        : passthrough, no buffer, no policy.
+//   1 buffer      : one-entry registered buffer, no admission policy.
+//   2 ingress     : confirm current PTE passed the shared DDR entry.
+//   3 period      : confirm + Q-beat budget, refilled by a fixed period.
+//   4 progress    : confirm + Q-beat budget, refilled on PTW R fire.
+//   5 walk        : confirm + Q-beat budget, refilled on new walk rising.
+//   6 outstanding : confirm + Q-beat outstanding cap; R returns restore.
+//
+// The proxy only restricts a NEW offer when:
+//   dbg_tl_ptw_active && bufferFast && bufferbank != dbg_main_bank
+// Once an offer is formed, its VALID/payload is held until the downstream
+// ready handshake, independent of later phase changes.
+
+module nonblock_read_admission #(
+    parameter int unsigned BankIdBit = 2,
+    parameter int unsigned IdWidth   = 4,
+    parameter int unsigned AddrWidth = 64,
+    parameter int unsigned LenWidth  = 8,
+    parameter type ar_chan_t = logic
+) (
+    input  logic clk_i,
+    input  logic rst_ni,
+
+    input  logic [2:0]  mode_i,
+    input  logic [31:0] budget_i,
+    input  logic [31:0] period_i,
+
+    // upstream: from inner harness completion AR
+    input  logic        s_ar_valid,
+    output logic        s_ar_ready,
+    input  ar_chan_t    s_ar_chan,
+
+    // downstream: to crossbar slave port 2 AR
+    output logic        m_ar_valid,
+    input  logic        m_ar_ready,
+    output ar_chan_t    m_ar_chan,
+
+    // observation / policy
+    input  logic        ptw_active_i,
+    input  logic        ptw_r_fire_i,
+    input  logic        main_bank_i,
+    input  logic        fast_resp_valid_i,
+    input  logic        fast_resp_ready_i,
+    input  logic        fast_resp_bank_i,
+    input  logic [1:0]  bank_is_read_i,
+    input  logic [1:0]  bank_trans_resp_valid_i,
+    input  logic [1:0]  bank_trans_resp_ready_i,
+
+    input  logic        ddr_ar_valid_i,
+    input  logic        ddr_ar_ready_i,
+    input  logic [5:0]  ddr_ar_id_i,
+
+    // AW exemption / fast-tag clear
+    input  logic [1:0][31:0] aw_pending_i,
+    input  logic        comp_aw_valid_i,
+    input  logic        comp_aw_bank_i,
+    input  logic        comp_b_fire_i,
+    input  logic        comp_b_bank_i,
+
+    // R beat return for debt decrement
+    input  logic        comp_r_fire_i,
+
+    // debug / observation
+    output logic        dbg_captured,
+    output logic        dbg_first_offer,
+    output logic        dbg_ar_fire,
+    output logic        dbg_blocked,
+    output logic [2:0]  dbg_blocked_reason,
+    output logic        dbg_buffer_empty,
+    output logic        dbg_fastread_capture,
+    output logic        dbg_phase_reset,
+    output logic        dbg_payload_fast,
+    output logic        dbg_payload_bank,
+    output logic [IdWidth-1:0]   dbg_payload_id,
+    output logic [AddrWidth-1:0] dbg_payload_addr,
+    output logic [LenWidth-1:0]  dbg_payload_len,
+    output logic [31:0] dbg_phaseused,
+    output logic        dbg_confirm,
+    output logic [31:0] dbg_debt,
+    output logic [31:0] dbg_first_offers,
+    output logic [31:0] dbg_fastread_captures,
+    output logic [31:0] dbg_gate_stall,
+    output logic [31:0] dbg_ingress_stall,
+    output logic [31:0] dbg_budget_stall,
+    output logic [31:0] dbg_phase_resets,
+    output logic [31:0] dbg_exempt_offers,
+    output logic [31:0] dbg_oversize_escape,
+    output logic [31:0] dbg_debt_max,
+    output logic [31:0] dbg_fast_gated_offers,
+    output logic [31:0] dbg_capture_count,
+    output logic [31:0] dbg_offer_handshake_count
+);
+
+    localparam logic [2:0] RA_NONE        = 3'd0;
+    localparam logic [2:0] RA_BUFFER      = 3'd1;
+    localparam logic [2:0] RA_INGRESS     = 3'd2;
+    localparam logic [2:0] RA_PERIOD      = 3'd3;
+    localparam logic [2:0] RA_PROGRESS    = 3'd4;
+    localparam logic [2:0] RA_WALK        = 3'd5;
+    localparam logic [2:0] RA_OUTSTANDING = 3'd6;
+
+    typedef enum logic [1:0] {ST_EMPTY, ST_CAPTURED, ST_OFFER} state_e;
+    state_e state_q;
+
+    ar_chan_t   buf_q;
+    logic       buf_fast_q;
+    logic       buf_bank_q;
+
+    logic       confirm_q;
+    logic       prev_ptw_active_q;
+    logic [31:0] stage_used_q;
+    logic [31:0] debt_q;
+    logic [31:0] period_cnt_q;
+    logic [1:0]  fast_pending_q;
+
+    logic [31:0] first_offers_q;
+    logic [31:0] fastread_captures_q;
+    logic [31:0] gate_stall_q;
+    logic [31:0] ingress_stall_q;
+    logic [31:0] budget_stall_q;
+    logic [31:0] phase_resets_q;
+    logic [31:0] exempt_offers_q;
+    logic [31:0] oversize_escape_q;
+    logic [31:0] debt_max_q;
+    logic [31:0] fast_gated_offers_q;
+    logic [31:0] capture_count_q;
+    logic [31:0] offer_handshake_count_q;
+
+    // ---- fast-read tag set events: only on a real read TC transaction ----
+    wire fast_set_b0 =
+        bank_trans_resp_valid_i[0] && bank_trans_resp_ready_i[0] &&
+        bank_is_read_i[0] &&
+        fast_resp_valid_i && fast_resp_ready_i &&
+        (fast_resp_bank_i == 1'b0);
+
+    wire fast_set_b1 =
+        bank_trans_resp_valid_i[1] && bank_trans_resp_ready_i[1] &&
+        bank_is_read_i[1] &&
+        fast_resp_valid_i && fast_resp_ready_i &&
+        (fast_resp_bank_i == 1'b1);
+
+    // ---- capture event ----
+    wire capture_bank = s_ar_chan.id[BankIdBit];
+    wire capture_fast = fast_pending_q[capture_bank];
+    wire capture_fire = (mode_i != RA_NONE) &&
+                        (state_q == ST_EMPTY) &&
+                        s_ar_valid;
+
+    // ---- admission ----
+    wire [31:0] beats = {23'b0, buf_q.len} + 32'd1;
+
+    wire restricted =
+        (mode_i != RA_NONE) && (mode_i != RA_BUFFER) &&
+        ptw_active_i && buf_fast_q && (buf_bank_q != main_bank_i);
+
+    wire exempt =
+        (aw_pending_i[buf_bank_q] != 32'd0) ||
+        (comp_aw_valid_i && (comp_aw_bank_i == buf_bank_q));
+
+    wire oversize =
+        (mode_i inside {RA_PERIOD, RA_PROGRESS, RA_WALK, RA_OUTSTANDING}) &&
+        (beats > budget_i);
+
+    wire confirm_ok = confirm_q;
+    wire period_ok  = (stage_used_q + beats <= budget_i);
+    wire debt_ok    = (debt_q + beats <= budget_i);
+    wire budget_ok  =
+        (mode_i == RA_INGRESS)     ? 1'b1 :
+        (mode_i == RA_OUTSTANDING) ? debt_ok :
+        (mode_i inside {RA_PERIOD, RA_PROGRESS, RA_WALK}) ? period_ok :
+        1'b1;
+
+    wire admit = !restricted || exempt || oversize || (confirm_ok && budget_ok);
+
+    wire first_offer =
+        (mode_i != RA_NONE) && (state_q == ST_CAPTURED) && admit;
+
+    wire ar_fire =
+        (mode_i == RA_NONE) ? (s_ar_valid && m_ar_ready) :
+                              (state_q == ST_OFFER && m_ar_ready);
+
+    wire blocked =
+        (mode_i != RA_NONE) && (mode_i != RA_BUFFER) &&
+        (state_q == ST_CAPTURED) && restricted && !admit;
+
+    // PTW real shared-DDR AR: PTW ID0, DDTW ID1.
+    wire pte_ar_confirm =
+        ddr_ar_valid_i && ddr_ar_ready_i &&
+        (ddr_ar_id_i[5:4] == 2'b11) &&
+        (ddr_ar_id_i[3:0] == 4'd0);
+
+    wire new_walk_rising = ptw_active_i && !prev_ptw_active_q;
+    wire walk_falling    = !ptw_active_i && prev_ptw_active_q;
+    wire phase_reset     = ptw_r_fire_i || new_walk_rising || walk_falling;
+
+    wire period_expire =
+        (mode_i == RA_PERIOD) && (period_i != 32'd0) && (period_cnt_q == 32'd0);
+
+    // ---- outputs ----
+    assign s_ar_ready = (mode_i == RA_NONE) ? m_ar_ready : (state_q == ST_EMPTY);
+    assign m_ar_valid = (mode_i == RA_NONE) ? s_ar_valid : (state_q == ST_OFFER);
+    assign m_ar_chan  = (mode_i == RA_NONE) ? s_ar_chan : buf_q;
+
+    assign dbg_captured       = capture_fire;
+    assign dbg_first_offer    = first_offer;
+    assign dbg_ar_fire        = ar_fire;
+    assign dbg_blocked        = blocked;
+    assign dbg_blocked_reason = { budget_ok ? 1'b0 : 1'b1,
+                                  confirm_ok ? 1'b0 : 1'b1,
+                                  1'b0 };
+    assign dbg_buffer_empty   = (state_q == ST_EMPTY);
+    assign dbg_fastread_capture = capture_fire && capture_fast;
+    assign dbg_phase_reset    = phase_reset;
+    assign dbg_payload_fast   = buf_fast_q;
+    assign dbg_payload_bank   = buf_bank_q;
+    assign dbg_payload_id     = buf_q.id;
+    assign dbg_payload_addr   = buf_q.addr;
+    assign dbg_payload_len    = buf_q.len;
+    assign dbg_phaseused      = stage_used_q;
+    assign dbg_confirm        = confirm_q;
+    assign dbg_debt           = debt_q;
+    assign dbg_first_offers   = first_offers_q;
+    assign dbg_fastread_captures = fastread_captures_q;
+    assign dbg_gate_stall     = gate_stall_q;
+    assign dbg_ingress_stall  = ingress_stall_q;
+    assign dbg_budget_stall   = budget_stall_q;
+    assign dbg_phase_resets   = phase_resets_q;
+    assign dbg_exempt_offers  = exempt_offers_q;
+    assign dbg_oversize_escape= oversize_escape_q;
+    assign dbg_debt_max       = debt_max_q;
+    assign dbg_fast_gated_offers = fast_gated_offers_q;
+    assign dbg_capture_count  = capture_count_q;
+    assign dbg_offer_handshake_count = offer_handshake_count_q;
+
+    always_ff @(posedge clk_i or negedge rst_ni) begin : ra_seq
+        if (!rst_ni) begin
+            state_q <= ST_EMPTY;
+            buf_q <= '0;
+            buf_fast_q <= 1'b0;
+            buf_bank_q <= 1'b0;
+            confirm_q <= 1'b0;
+            prev_ptw_active_q <= 1'b0;
+            stage_used_q <= 32'd0;
+            debt_q <= 32'd0;
+            period_cnt_q <= 32'd0;
+            fast_pending_q <= 2'b00;
+            first_offers_q <= 32'd0;
+            fastread_captures_q <= 32'd0;
+            gate_stall_q <= 32'd0;
+            ingress_stall_q <= 32'd0;
+            budget_stall_q <= 32'd0;
+            phase_resets_q <= 32'd0;
+            exempt_offers_q <= 32'd0;
+            oversize_escape_q <= 32'd0;
+            debt_max_q <= 32'd0;
+            fast_gated_offers_q <= 32'd0;
+            capture_count_q <= 32'd0;
+            offer_handshake_count_q <= 32'd0;
+        end else begin
+            // ---- fast-read tag lifecycle ----
+            // Same-cycle set wins over clear; clear wins over consume.
+            if (fast_set_b0) fast_pending_q[0] <= 1'b1;
+            else if (comp_b_fire_i && (comp_b_bank_i == 1'b0)) fast_pending_q[0] <= 1'b0;
+            else if (capture_fire && (capture_bank == 1'b0) && fast_pending_q[0])
+                fast_pending_q[0] <= 1'b0;
+
+            if (fast_set_b1) fast_pending_q[1] <= 1'b1;
+            else if (comp_b_fire_i && (comp_b_bank_i == 1'b1)) fast_pending_q[1] <= 1'b0;
+            else if (capture_fire && (capture_bank == 1'b1) && fast_pending_q[1])
+                fast_pending_q[1] <= 1'b0;
+
+            // ---- capture upstream AR ----
+            if (capture_fire) begin
+                state_q <= ST_CAPTURED;
+                buf_q <= s_ar_chan;
+                buf_fast_q <= capture_fast;
+                buf_bank_q <= capture_bank;
+                capture_count_q <= capture_count_q + 32'd1;
+            end
+
+            // ---- first downstream offer / reservation ----
+            if (first_offer) begin
+                state_q <= ST_OFFER;
+                first_offers_q <= first_offers_q + 32'd1;
+                if (restricted) fast_gated_offers_q <= fast_gated_offers_q + 32'd1;
+                if (restricted && exempt) exempt_offers_q <= exempt_offers_q + 32'd1;
+                if (oversize) oversize_escape_q <= oversize_escape_q + 32'd1;
+
+                if (mode_i inside {RA_PERIOD, RA_PROGRESS, RA_WALK})
+                    stage_used_q <= stage_used_q + beats;
+
+                if ((debt_q + beats) > debt_max_q) debt_max_q <= debt_q + beats;
+                debt_q <= debt_q + beats - (comp_r_fire_i ? 32'd1 : 32'd0);
+            end else if (comp_r_fire_i) begin
+                if (debt_q != 32'd0) debt_q <= debt_q - 32'd1;
+            end
+
+            // ---- downstream offer handshake ----
+            if (ar_fire && (mode_i != RA_NONE)) begin
+                state_q <= ST_EMPTY;
+                offer_handshake_count_q <= offer_handshake_count_q + 32'd1;
+            end
+
+            // ---- PTE confirm / phase reset ----
+            // Same-cycle confirm is intentionally allowed to survive reset and
+            // become usable next cycle.
+            if (pte_ar_confirm) confirm_q <= 1'b1;
+            else if (ptw_r_fire_i || new_walk_rising || walk_falling)
+                confirm_q <= 1'b0;
+
+            if (phase_reset) phase_resets_q <= phase_resets_q + 32'd1;
+
+            // ---- phase budget reset ----
+            if (mode_i == RA_PERIOD) begin
+                if (period_expire) begin
+                    stage_used_q <= 32'd0;
+                    period_cnt_q <= period_i - 32'd1;
+                end else if (period_cnt_q != 32'd0) begin
+                    period_cnt_q <= period_cnt_q - 32'd1;
+                end
+            end
+            if ((mode_i == RA_PROGRESS) && ptw_r_fire_i) stage_used_q <= 32'd0;
+            if ((mode_i == RA_WALK) && new_walk_rising) stage_used_q <= 32'd0;
+            if (walk_falling) stage_used_q <= 32'd0;
+
+            // ---- blocked counters ----
+            if (blocked) begin
+                gate_stall_q <= gate_stall_q + 32'd1;
+                if (!confirm_ok) ingress_stall_q <= ingress_stall_q + 32'd1;
+                else if (!budget_ok) budget_stall_q <= budget_stall_q + 32'd1;
+            end
+
+            if (capture_fire && capture_fast)
+                fastread_captures_q <= fastread_captures_q + 32'd1;
+
+            prev_ptw_active_q <= ptw_active_i;
+        end
+    end
+
+endmodule

