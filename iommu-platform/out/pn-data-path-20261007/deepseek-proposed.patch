+        // ================= measurement window (pre-edge) ==================
+        // Gated by win_open; see the counter block in class Tb.  Nothing is
+        // counted during warm-up, the A drain, drain-to-quiet or the byte
+        // verification, because win_open is false there.
+        if (win_open) {
+            ++w_cycles;
+
+            const uint32_t w_iss = (uint32_t)top->dbg_dma_issue & 3u;
+            const uint32_t w_dnn = (uint32_t)top->dbg_dma_done  & 3u;
+            // done before issue, same convention as the warm scoreboard.
+            if (w_dnn & 1u) { ++w_v_done; w_v_busy = false; }
+            if (w_iss & 1u) { w_v_busy = true; }
+            if (w_dnn & 2u) { ++w_a_done; w_a_busy = false; }
+            if (w_iss & 2u) { w_a_busy = true; }
+            if (w_v_busy && w_a_busy) ++w_both_pending;
+
+            if (top->dbg_tl_req_valid && top->dbg_tl_req_ready) {
+                ++w_tl_accept;
+                ++w_req_bank[top->dbg_tl_req_bank & 1];
+            }
+            if (top->dbg_tl_resp_valid && top->dbg_tl_resp_ready) {
+                ++w_tl_resp;
+                ++w_resp_bank[top->dbg_tl_resp_bank & 1];
+            }
+            if (top->dbg_fast_resp_valid && top->dbg_fast_resp_ready) {
+                ++w_fast;
+                ++w_fast_bank[top->dbg_fast_resp_bank & 1];
+            }
+            if (top->dbg_tl_iotlb_lookup) {
+                ++w_iotlb_lookup;
+                if (top->dbg_tl_iotlb_hit) ++w_iotlb_hit;
+            }
+            // ptw_active is a LEVEL (counted per cycle, like the existing
+            // whole-scenario counter); ptw_r_fire is a pulse.
+            if (top->dbg_tl_ptw_active) ++w_ptw_active;
+            if (top->dbg_tl_ptw_r_fire) ++w_ptw_r_fire;
+#ifdef ACTUAL_DMA_SYSTEM
+            // Shared DDR port.  f_ddr_* are this tick's PRE-EDGE fire flags;
+            // the stall counters use the PRE-EDGE valid/ready sample.
+            // NOTE: drive_ddr() drives ddr_aw_ready / ddr_w_ready to 1
+            // permanently, so w_ddr_aw_stall / w_ddr_w_stall are structurally
+            // 0 in this model.  They must NOT be read as "the board never
+            // backpressures shared AW": this DDR model has no AW backpressure
+            // at all.
+            if (f_ddr_ar) { ++w_ddr_ar; ++w_ddr_ar_slv[(s_ddr_ar_i >> 4) & 3]; }
+            if (f_ddr_aw) {
+                ++w_ddr_aw;
+                ++w_ddr_aw_slv[(s_ddr_aw_i >> 4) & 3];
+                // Destination region: the A ring lives at A_SRC_PA_BASE
+                // (0x9000_0000+) and V at V_SRC_PA (0x8000_0000+); everything
+                // below the synthetic CPU scratch (0x8100_0000) is V.
+                if (s_ddr_aw_a >= A_SRC_PA_BASE)      ++w_ddr_aw_a;
+                else if (s_ddr_aw_a >= V_SRC_PA &&
+                         s_ddr_aw_a <  CPU_WR_ADDR)   ++w_ddr_aw_v;
+            }
+            if (f_ddr_w) ++w_ddr_w;
+            if (f_ddr_r) ++w_ddr_r;
+            if (f_ddr_b) ++w_ddr_b;
+            if (top->ddr_ar_valid && !top->ddr_ar_ready) ++w_ddr_ar_stall;
+            if (top->ddr_r_valid  && !top->ddr_r_ready)  ++w_ddr_r_stall;
+            if (top->ddr_aw_valid && !top->ddr_aw_ready) ++w_ddr_aw_stall;
+            if (top->ddr_w_valid  && !top->ddr_w_ready)  ++w_ddr_w_stall;
+            if (top->dbg_comp_ar_fire) ++w_comp_ar_fire;
+            if (top->dbg_comp_aw_fire) ++w_comp_aw_fire;
+            if (top->dbg_comp_w_fire)  ++w_comp_w_fire;
+            if (top->dbg_ddtw_ar_fire) ++w_ddtw_ar_fire;
+            if (top->dbg_ptw_ar_fire)  ++w_ptw_ar_fire;
+            if (top->dbg_ds_ar_valid && !top->dbg_ds_ar_ready) ++w_ds_ar_stall;
+            if (top->dbg_ds_r_valid  && !top->dbg_ds_r_ready)  ++w_ds_r_stall;
+#endif
+        }

