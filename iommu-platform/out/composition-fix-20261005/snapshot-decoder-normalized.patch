+                       % (doc.get("idcode"),))
+    elif (idcode & IDCODE_LOW28_MASK) != IDCODE_LOW28_EXPECTED:
+        reasons.append(
+            "input 'idcode' low 28 bits are 0x%07X, expected 0x%07X"
+            % (idcode & IDCODE_LOW28_MASK, IDCODE_LOW28_EXPECTED))
