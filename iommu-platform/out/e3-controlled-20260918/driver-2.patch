+	       !(status & IDMA_LAUNCHER_STATUS_RUNNING) &&
+	       !((status >> IDMA_LAUNCHER_HELD_SHIFT) & 0xf) &&
+	       !((status >> IDMA_LAUNCHER_ACTIVE_SHIFT) & 0xf);
