+	    c->pair.reserved)
+		return -EINVAL;
+	if (c->prep_mode > 1 || c->pair_mode > 1 ||
+	    memchr_inv(c->reserved, 0, sizeof(c->reserved)))
+		return -EINVAL;
+	if (e->abi_version != IDMA_EXPERIMENT_ABI || e->struct_size != sizeof(*e) ||
+	    e->flags || memchr_inv(e->reserved, 0, sizeof(e->reserved)))
+		return -EINVAL;
