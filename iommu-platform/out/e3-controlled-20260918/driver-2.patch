+	if (a && e->aggressor_id != 1)
+		return -EINVAL;
+	if (!a && c->prep_mode)
+		return -EINVAL;
+	if (victim->id != 0 || victim->did != 10)
+		return -EINVAL;
+	if (e->victim_pages != 1 || (a && e->aggressor_pages != 1))
+		return -EINVAL;
+	if (e->chunk_bytes != 64 || e->victim_transfers != 1 ||
+	    e->warmup_transfers || !e->run_timeout_ms || e->run_timeout_ms > 60000)
