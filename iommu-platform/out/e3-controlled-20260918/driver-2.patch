+		return -EOPNOTSUPP;
+	for (i = 0; i < IDMA_E3_CONTROLLED_WORDS; i++) {
+		writeq(i, launcher->reg + IDMA_LAUNCHER_INDEX_OFFSET);
+		words[i] = readq(launcher->reg + IDMA_LAUNCHER_DATA_OFFSET);
+	}
+	return 0;
