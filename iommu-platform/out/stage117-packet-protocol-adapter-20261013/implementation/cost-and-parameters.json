    "production RRESP/BRESP/IOMMU fault-to-packet success receipt",
    "FPGA frequency/timing/area/power/board performance"
  ],
  "same_original_latency_configuration": true,
  "new_pressure_arrivals_deadlines_or_extra_packets": false
