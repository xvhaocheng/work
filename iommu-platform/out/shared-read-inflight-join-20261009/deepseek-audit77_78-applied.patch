+def check_run_cardinality(root: Path, runs):
+    found = sorted(p.name for p in root.glob("run??-result.json"))
+    expected = sorted(f"{n}-result.json" for n in runs)
+    if found != expected:
+        raise AssertionError(f"{root}: run result cardinality {found} != {expected}")
+
+
+def source_r_consistency(tag, phys, nat, share, co, inflight=None):
+    if nat.get("pr_total") != phys:
+        raise AssertionError(f"{tag}: nat.pr_total {nat.get('pr_total')} != nat v/a R sum {phys}")
+    if share.get("src_r_beats") != phys:
+        raise AssertionError(f"{tag}: SHARE50.src_r_beats {share.get('src_r_beats')} != {phys}")
+    for key in ("actual_source_r_beats", "derived_expected_source_r_beats"):
+        if co.get(key) != phys:
+            raise AssertionError(f"{tag}: SOURCE {key} {co.get(key)} != {phys}")
+    if inflight is not None:
+        for key in ("actual_source_r_beats", "derived_expected_source_r_beats"):
+            if inflight.get(key) != phys:
+                raise AssertionError(f"{tag}: INFLIGHT {key} {inflight.get(key)} != {phys}")
+
+
