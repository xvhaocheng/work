    "lines": [
      {
        "line": 1,
        "text": "PYTHON ?= python3"
      },
      {
        "line": 2,
        "text": "PROFILE ?= migration-4dma"
      },
      {
        "line": 3,
        "text": "JOBS ?= 12"
      },
      {
        "line": 13,
        "text": "doctor check bench rootfs kernel firmware software hpm-test fpga bundle:"
      },
      {
        "line": 14,
        "text": "\t$(PYTHON) scripts/platform.py $@ --profile $(PROFILE) --jobs $(JOBS)"
      }
    ]
  },
  {
    "path": "/home/xvhaocheng/work/iommu-platform/scripts/platform.py",
    "sha256": "ce43582b09af3b10e7364e5ca69ca182f8defa32447c6c567935bf2d8caf640d",
    "lines": [
      {
        "line": 228,
        "text": "def fpga(profile, stage=None):"
      },
      {
        "line": 229,
        "text": "    cfg = json.loads((ROOT/'configs'/f'{profile}.json').read_text())"
      },
      {
        "line": 230,
        "text": "    if cfg['num_dma'] != 4 or cfg['device_ids'] != [10,11,12,13]:"
      },
      {
        "line": 231,
        "text": "        raise RuntimeError('This builder supports only the migrated four-DMA wiring/DTS')"
      },
      {
        "line": 232,
        "text": "    if cfg['board'] != 'genesys2' or cfg['cpu_hz'] != 50000000 or cfg['timebase_hz'] != 25000000:"
      },
      {
        "line": 233,
        "text": "        raise RuntimeError('Clock/board changes require matching clock IP, DTS and OpenSBI changes')"
      },
      {
        "line": 234,
        "text": "    if stage is None:"
      },
      {
        "line": 235,
        "text": "        stage = ROOT/'out'/profile/'fpga-src'"
      },
      {
        "line": 236,
        "text": "    else:"
      },
      {
        "line": 237,
        "text": "        stage = Path(stage)"
      },
      {
        "line": 238,
        "text": "        if not stage.is_absolute():"
      },
      {
        "line": 239,
        "text": "            stage = ROOT/stage"
      },
      {
        "line": 240,
        "text": "    stage = stage.resolve()"
      },
      {
        "line": 241,
        "text": "    out_root = (ROOT/'out').resolve()"
      },
      {
        "line": 242,
        "text": "    if stage == out_root or not stage.is_relative_to(out_root):"
      },
      {
        "line": 243,
        "text": "        raise RuntimeError(f'--fpga-stage must be inside {out_root}')"
      },
      {
        "line": 244,
        "text": "    BUILD_CONTEXT['fpga_stage'] = str(stage.relative_to(ROOT))"
      },
      {
        "line": 245,
        "text": "    if stage.exists():"
      },
      {
        "line": 246,
        "text": "        raise RuntimeError(f'{stage} exists. Use a fresh output directory/profile for a new hardware build.')"
      },
      {
        "line": 289,
        "text": "    fpga_root = cva6/'corev_apu/fpga'"
      },
      {
        "line": 290,
        "text": "    for tcl in [fpga_root/'scripts/prologue.tcl', *fpga_root.glob('xilinx/*/tcl/run.tcl')]:"
      },
      {
        "line": 291,
        "text": "        tcl.write_text('set_param board.repoPaths [list $::env(IOMMU_BOARD_REPO)]\\n'+tcl.read_text())"
      },
      {
        "line": 292,
        "text": "    (stage/'build-inputs.json').write_text(json.dumps(BUILD_CONTEXT,indent=2)+'\\n')"
      },
      {
        "line": 293,
        "text": "    run(['make', '-C', cva6, f'BOARD={cfg[\"board\"]}', 'fpga'])"
      },
      {
        "line": 294,
        "text": "    for name in ['ariane_xilinx.bit', 'ariane_xilinx.mcs']:"
      },
      {
        "line": 295,
        "text": "        artifact = fpga_root/'work-fpga'/name"
      },
      {
        "line": 296,
        "text": "        if not artifact.is_file() or artifact.stat().st_size == 0:"
      },
      {
        "line": 297,
        "text": "            raise RuntimeError(f'FPGA build did not produce {artifact}')"
      },
      {
        "line": 339,
        "text": "def manifest(action, profile, status):"
      },
      {
        "line": 340,
        "text": "    dest=ROOT/'out/manifests'"
      },
      {
        "line": 341,
        "text": "    dest.mkdir(parents=True, exist_ok=True)"
      },
      {
        "line": 342,
        "text": "    fpga_stage = BUILD_CONTEXT.get('fpga_stage', f'out/{profile}/fpga-src')"
      },
      {
        "line": 343,
        "text": "    paths=['out/rootfs.cpio','out/linux/arch/riscv/boot/Image','out/linux/platform.dtb',"
      },
      {
        "line": 344,
        "text": "           'out/opensbi/platform/fpga/ariane/firmware/fw_payload.bin',"
      },
      {
        "line": 345,
        "text": "           f'{fpga_stage}/cva6/corev_apu/fpga/work-fpga/ariane_xilinx.bit']"
      },
      {
        "line": 346,
        "text": "    data={'timestamp':datetime.now(timezone.utc).isoformat(),'action':action,'status':status,"
      },
      {
        "line": 347,
        "text": "          'profile':json.loads((ROOT/'configs'/f'{profile}.json').read_text()),"
      },
      {
        "line": 348,
        "text": "          'platform_commit':capture(['git','rev-parse','HEAD']),"
      },
      {
        "line": 349,
        "text": "          'platform_dirty':bool(capture(['git','status','--porcelain'])),"
      },
      {
        "line": 350,
        "text": "          'sources_lock_sha256':sha(ROOT/'sources.lock.json'),"
      },
      {
        "line": 351,
        "text": "          'artifacts':{p:sha(ROOT/p) for p in paths if (ROOT/p).exists()}}"
      },
      {
        "line": 352,
        "text": "    data['build_start'] = BUILD_CONTEXT"
      },
      {
        "line": 353,
        "text": "    data['tools']={}"
      },
      {
        "line": 354,
        "text": "    for tool in [CC+'gcc', BARE_CC+'gcc', 'verilator']:"
      },
      {
        "line": 355,
        "text": "        if shutil.which(tool):"
      },
      {
        "line": 356,
        "text": "            data['tools'][tool]=capture([tool,'--version']).splitlines()[0]"
      },
      {
        "line": 357,
        "text": "    data['python']=sys.version.split()[0]"
      },
      {
        "line": 358,
        "text": "    data['license_server']=ENV.get('XILINXD_LICENSE_FILE', 'Vivado default configuration')"
      },
      {
        "line": 359,
        "text": "    (dest/f'{action}-{profile}.json').write_text(json.dumps(data,indent=2)+'\\n')"
      },
      {
        "line": 364,
        "text": "    parser.add_argument('action',choices=['doctor','check','bench','rootfs','kernel','firmware','software','hpm-test','fpga','bundle'])"
      },
      {
        "line": 365,
        "text": "    parser.add_argument('--profile',default='migration-4dma',choices=['migration-4dma','baseline-4dma','migration-4dma-scfix','migration-4dma-observe','migration-4dma-batch','baseline-4dma-batch','migration-4dma-path','migration-4dma-e3','migration-4dma-e3-queue','migration-4dma-e3-controlled','migration-4dma-p4m','migration-4dma-research-v1','migration-4dma-research-e2-v2','migration-4dma-research-method-v2','migration-4dma-n-serial','migration-4dma-n-hit','migration-4dma-composition'])"
      },
      {
        "line": 366,
        "text": "    parser.add_argument('--workspace-overlay', type=Path, default=None)"
      },
      {
        "line": 367,
        "text": "    parser.add_argument('--fpga-stage', type=Path, default=None)"
      }
    ]
