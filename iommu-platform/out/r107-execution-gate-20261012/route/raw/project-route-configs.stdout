FILE configs/local.json exists= False
FILE local.json exists= False
FILE config/local.json exists= False
FILE configs/board-network.interfaces exists= True
configs/board-network.interfaces:1:# interface file auto-generated by buildroot
configs/board-network.interfaces:2:
configs/board-network.interfaces:3:auto lo
configs/board-network.interfaces:4:iface lo inet loopback
configs/board-network.interfaces:5:
configs/board-network.interfaces:6:# Static link to the Mac helper. Keep it local: no gateway.
configs/board-network.interfaces:7:auto eth0
configs/board-network.interfaces:8:iface eth0 inet static
configs/board-network.interfaces:9:    address 192.168.77.2
configs/board-network.interfaces:10:    netmask 255.255.255.0
FILE configs/board-dhcpcd.conf exists= True
configs/board-dhcpcd.conf:1:# A sample configuration for dhcpcd.
configs/board-dhcpcd.conf:2:# See dhcpcd.conf(5) for details.
configs/board-dhcpcd.conf:3:
configs/board-dhcpcd.conf:4:# Allow users of this group to interact with dhcpcd via the control socket.
configs/board-dhcpcd.conf:5:#controlgroup wheel
configs/board-dhcpcd.conf:6:
configs/board-dhcpcd.conf:7:# Inform the DHCP server of our hostname for DDNS.
configs/board-dhcpcd.conf:8:#hostname
configs/board-dhcpcd.conf:9:
configs/board-dhcpcd.conf:10:# Use the hardware address of the interface for the Client ID.
configs/board-dhcpcd.conf:11:#clientid
configs/board-dhcpcd.conf:12:# or
configs/board-dhcpcd.conf:13:# Use the same DUID + IAID as set in DHCPv6 for DHCPv4 ClientID as per RFC4361.
configs/board-dhcpcd.conf:14:# Some non-RFC compliant DHCP servers do not reply with this set.
configs/board-dhcpcd.conf:15:# In this case, comment out duid and enable clientid above.
configs/board-dhcpcd.conf:16:duid
configs/board-dhcpcd.conf:17:
configs/board-dhcpcd.conf:18:# Persist interface configuration when dhcpcd exits.
configs/board-dhcpcd.conf:19:persistent
configs/board-dhcpcd.conf:20:
configs/board-dhcpcd.conf:21:# Do not let DHCP touch the static Mac link.
configs/board-dhcpcd.conf:22:denyinterfaces eth0
configs/board-dhcpcd.conf:23:
configs/board-dhcpcd.conf:24:# vendorclassid is set to blank to avoid sending the default of
configs/board-dhcpcd.conf:25:# dhcpcd-<version>:<os>:<machine>:<platform>
configs/board-dhcpcd.conf:26:vendorclassid
configs/board-dhcpcd.conf:27:
configs/board-dhcpcd.conf:28:# A list of options to request from the DHCP server.
configs/board-dhcpcd.conf:29:option domain_name_servers, domain_name, domain_search
configs/board-dhcpcd.conf:30:option classless_static_routes
configs/board-dhcpcd.conf:31:# Respect the network MTU. This is applied to DHCP routes.
configs/board-dhcpcd.conf:32:option interface_mtu
configs/board-dhcpcd.conf:33:
configs/board-dhcpcd.conf:34:# Request a hostname from the network
configs/board-dhcpcd.conf:35:option host_name
configs/board-dhcpcd.conf:36:
configs/board-dhcpcd.conf:37:# Most distributions have NTP support.
configs/board-dhcpcd.conf:38:#option ntp_servers
configs/board-dhcpcd.conf:39:
configs/board-dhcpcd.conf:40:# Rapid commit support.
configs/board-dhcpcd.conf:41:# Safe to enable by default because it requires the equivalent option set
configs/board-dhcpcd.conf:42:# on the server to actually work.
configs/board-dhcpcd.conf:43:option rapid_commit
configs/board-dhcpcd.conf:44:
configs/board-dhcpcd.conf:45:# A ServerID is required by RFC2131.
configs/board-dhcpcd.conf:46:require dhcp_server_identifier
configs/board-dhcpcd.conf:47:
configs/board-dhcpcd.conf:48:# Generate SLAAC address using the Hardware Address of the interface
configs/board-dhcpcd.conf:49:#slaac hwaddr
configs/board-dhcpcd.conf:50:# OR generate Stable Private IPv6 Addresses based from the DUID
configs/board-dhcpcd.conf:51:slaac private
