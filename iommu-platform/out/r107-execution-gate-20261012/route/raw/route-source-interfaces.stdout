scripts/mac_update_reboot.py:113:    '-o', 'PreferredAuthentications=password',
scripts/mac_update_reboot.py:114:    '-o', 'NumberOfPasswordPrompts=1',
scripts/mac_update_reboot.py:234:def build_ssh_argv(*, key, password_mode, board_host, remote_command):
