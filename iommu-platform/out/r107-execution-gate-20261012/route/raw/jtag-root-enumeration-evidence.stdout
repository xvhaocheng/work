out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:1:# One diagnostic enumeration. No target opening, programming, reset or refresh.
out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:2:open_hw_manager
out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:3:connect_hw_server -url 127.0.0.1:3123
out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:4:set targets [get_hw_targets -quiet]
out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:5:puts "R109_ALL_TARGET_COUNT=[llength $targets]"
