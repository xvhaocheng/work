out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:8:puts "R109_SERIAL_MATCH_COUNT=[llength $exact]"
out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:9:foreach target $exact {puts "R109_SERIAL_MATCH_OBJECT=$target"}
out/r107-execution-gate-20261012/route/enumerate_current_jtag_targets.tcl:10:disconnect_hw_server
