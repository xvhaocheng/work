/tools/Xilinx/Vivado/2023.1/bin/hw_server:128:#######################################
/tools/Xilinx/Vivado/2023.1/bin/hw_server:129:# Search and set DIGILENT_DATA_DIR location
/tools/Xilinx/Vivado/2023.1/bin/hw_server:130:
/tools/Xilinx/Vivado/2023.1/bin/hw_server:131:if [ -z "$DIGILENT_DATA_DIR" ]; then
/tools/Xilinx/Vivado/2023.1/bin/hw_server:132:  IFS=$':'
/tools/Xilinx/Vivado/2023.1/bin/hw_server:133:  for SUB_RDI_DATA in $RDI_DATADIR; do
/tools/Xilinx/Vivado/2023.1/bin/hw_server:134:    if [ -d "$SUB_RDI_DATA/xicom/cable_data/digilent/$RDI_PLATFORM" ]; then
/tools/Xilinx/Vivado/2023.1/bin/hw_server:135:      DIGILENT_DATA_DIR="$SUB_RDI_DATA/xicom/cable_data/digilent/$RDI_PLATFORM"
/tools/Xilinx/Vivado/2023.1/bin/hw_server:136:      export DIGILENT_DATA_DIR
/tools/Xilinx/Vivado/2023.1/bin/hw_server:137:      break
/tools/Xilinx/Vivado/2023.1/bin/hw_server:138:    fi
/tools/Xilinx/Vivado/2023.1/bin/hw_server:139:  done
/tools/Xilinx/Vivado/2023.1/bin/hw_server:140:  IFS=$' \t\n'
/tools/Xilinx/Vivado/2023.1/bin/hw_server:141:fi
/tools/Xilinx/Vivado/2023.1/bin/hw_server:142:
/tools/Xilinx/Vivado/2023.1/bin/hw_server:143:if [ -z "$DIGILENT_DATA_DIR" ]; then
/tools/Xilinx/Vivado/2023.1/bin/hw_server:144:    echo "WARNING: DIGILENT_DATA_DIR was not found therefore digilent cable"
/tools/Xilinx/Vivado/2023.1/bin/hw_server:145:    echo "         drivers will not be loaded by hw_server."
/tools/Xilinx/Vivado/2023.1/bin/hw_server:146:else
/tools/Xilinx/Vivado/2023.1/bin/hw_server:147:  if [ "$RDI_VERBOSE" = "True" ]; then
/tools/Xilinx/Vivado/2023.1/bin/hw_server:148:    echo "     **** hw_server ENVIRONMENT DEBUG INFO ****"
/tools/Xilinx/Vivado/2023.1/bin/hw_server:149:    echo "   DIGILENT_DATA_DIR: \"$DIGILENT_DATA_DIR\""
/tools/Xilinx/Vivado/2023.1/bin/hw_server:150:  fi
/tools/Xilinx/Vivado/2023.1/bin/hw_server:151:fi
/tools/Xilinx/Vivado/2023.1/bin/hw_server:152:
/tools/Xilinx/Vivado/2023.1/bin/hw_server:153:
/tools/Xilinx/Vivado/2023.1/bin/hw_server:154:#######################################
/tools/Xilinx/Vivado/2023.1/bin/hw_server:155:"$RDI_BINROOT"/loader -exec $RDI_PROG "$@"
/tools/Xilinx/Vivado/2023.1/bin/loader:273:#Add patch lib areas before %RDI_APPROOT%/lib
/tools/Xilinx/Vivado/2023.1/bin/loader:274:RDI_LIBDIR="$($RDI_BINROOT/ldlibpath.sh $RDI_APPROOT/lib/$RDI_PLATFORM$RDI_OPT_EXT)"
/tools/Xilinx/Vivado/2023.1/bin/loader:275:IFS=$':'
/tools/Xilinx/Vivado/2023.1/bin/loader:276:for SUB_PATCH in $RDI_PATCHROOT; do
/tools/Xilinx/Vivado/2023.1/bin/loader:277:    if [ -d "$SUB_PATCH/lib/$RDI_PLATFORM$RDI_OPT_EXT" ]; then
/tools/Xilinx/Vivado/2023.1/bin/loader:278:        RDI_LIBDIR="$($RDI_BINROOT/ldlibpath.sh $SUB_PATCH/lib/$RDI_PLATFORM$RDI_OPT_EXT):$RDI_LIBDIR"
/tools/Xilinx/Vivado/2023.1/bin/loader:279:    fi
/tools/Xilinx/Vivado/2023.1/bin/loader:280:done
/tools/Xilinx/Vivado/2023.1/bin/loader:281:IFS=$' \t\n'
/tools/Xilinx/Vivado/2023.1/bin/loader:282:export RDI_LIBDIR
/tools/Xilinx/Vivado/2023.1/bin/loader:317:if [ -z "$LD_LIBRARY_PATH" ]; then
/tools/Xilinx/Vivado/2023.1/bin/loader:318:  # This variable is used to restore the LD_LIBRARY_PATH when executables are invoked from planAhead.
/tools/Xilinx/Vivado/2023.1/bin/loader:319:  if [ ! -z "$RDI_PREPEND_LD_LIBRARY_PATH" ]; then
/tools/Xilinx/Vivado/2023.1/bin/loader:320:    HDIPRELDPATH=$RDI_PREPEND_LD_LIBRARY_PATH
/tools/Xilinx/Vivado/2023.1/bin/loader:321:  fi
/tools/Xilinx/Vivado/2023.1/bin/loader:322:  if [ -d "$RDI_JAVAROOT" ]; then
