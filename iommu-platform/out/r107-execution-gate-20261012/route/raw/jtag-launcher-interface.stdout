/tools/Xilinx/Vivado/2023.1/bin/loader:329:  fi
/tools/Xilinx/Vivado/2023.1/bin/loader:330:  if [[ -n "$RDI_JAVACEFROOT" ]] && [[ -d "$RDI_JAVACEFROOT" ]]; then
/tools/Xilinx/Vivado/2023.1/bin/loader:331:    LD_LIBRARY_PATH=$RDI_JAVACEFROOT/bin/lib/linux64:$LD_LIBRARY_PATH
/tools/Xilinx/Vivado/2023.1/bin/loader:332:  fi
/tools/Xilinx/Vivado/2023.1/bin/loader:333:else
/tools/Xilinx/Vivado/2023.1/bin/loader:334:  # This variable is used to restore the LD_LIBRARY_PATH when executables are invoked from planAhead.
/tools/Xilinx/Vivado/2023.1/bin/loader:335:  if [ ! -z "$RDI_PREPEND_LD_LIBRARY_PATH" ]; then
