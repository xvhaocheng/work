/tools/Xilinx/Vivado/2023.1/bin/loader:326:  fi
/tools/Xilinx/Vivado/2023.1/bin/loader:327:  if [[ -n "$RDI_JAVAFXROOT" ]] && [[ -d "$RDI_JAVAFXROOT" ]]; then
