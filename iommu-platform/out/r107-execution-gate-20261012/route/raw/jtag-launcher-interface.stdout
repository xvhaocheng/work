/tools/Xilinx/Vivado/2023.1/bin/loader:342:  else
/tools/Xilinx/Vivado/2023.1/bin/loader:343:    LD_LIBRARY_PATH=$RDI_LIBDIR:$LD_LIBRARY_PATH
/tools/Xilinx/Vivado/2023.1/bin/loader:344:  fi
/tools/Xilinx/Vivado/2023.1/bin/loader:345:  if [[ -n "$RDI_JAVAFXROOT" ]] && [[ -d "$RDI_JAVAFXROOT" ]]; then
/tools/Xilinx/Vivado/2023.1/bin/loader:346:    LD_LIBRARY_PATH=$RDI_JAVAFXROOT/lib:$LD_LIBRARY_PATH
/tools/Xilinx/Vivado/2023.1/bin/loader:347:  fi
/tools/Xilinx/Vivado/2023.1/bin/loader:348:  if [[ -n "$RDI_JAVACEFROOT" ]] && [[ -d "$RDI_JAVACEFROOT" ]]; then
