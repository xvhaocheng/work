+class CostFollowupPlanTest(unittest.TestCase):
+    """The fixed cost-followup selection of the frozen 84-case plan.
+
+    Host-side only.  Appended as an independent class so the frozen short/all
+    expectations above and build_plan() itself stay untouched.
+    """
+
+    def test_frozen_plan_still_has_eighty_four_unchanged_cases(self):
+        plan = research_plan.build_plan()
+        self.assertEqual(len(plan["cases"]), 84)
+        self.assertEqual([c["ordinal"] for c in plan["cases"]], list(range(1, 85)))
+        text = research_plan.to_tsv(plan)
+        self.assertEqual(text, FROZEN_TSV.read_text(encoding="utf-8"))
+        self.assertEqual(
+            plan["tsv_sha256"], hashlib.sha256(text.encode("utf-8")).hexdigest()
+        )
+        self.assertEqual(plan["counts"]["total"], 84)
+        self.assertEqual(
+            research_plan.select_cases(plan["cases"], "short"), plan["cases"][:6]
+        )
+        self.assertEqual(len(research_plan.select_cases(plan["cases"], "all")), 84)
+
+    def test_followup_selection_keeps_ids_ordinals_and_plan_order(self):
+        plan = research_plan.build_plan()
+        selected = research_plan.select_cases(plan["cases"], "cost-followup")
+        self.assertEqual([c["id"] for c in selected], list(FOLLOWUP_IDS))
+        self.assertEqual([c["ordinal"] for c in selected], list(FOLLOWUP_ORDINALS))
+        self.assertEqual(len(selected), 11)
+        self.assertEqual(research_plan.FOLLOWUP_CASE_COUNT, 11)
+        self.assertNotEqual(
+            [c["id"] for c in selected], [c["id"] for c in plan["cases"][:11]]
+        )
+        originals = {c["id"]: c for c in plan["cases"]}
+        for case in selected:
+            self.assertIs(case, originals[case["id"]])
+            self.assertEqual(case["mode"], "cost")
+        main = [c for c in selected if c["stage"] == "main"]
+        self.assertEqual(len(main), 9)
+        for condition in ("solo", "a8g0", "a8g2000"):
+            self.assertEqual(sum(1 for c in main if c["condition"] == condition), 3)
+        for block in (1, 2, 3):
+            order = [c["condition"] for c in main if c["block"] == block]
+            self.assertEqual(
+                order,
+                [
+                    condition
+                    for condition in research_plan.rotate(
+                        research_plan.COST_CONDITIONS, block
+                    )
+                    if condition in ("solo", "a8g0", "a8g2000")
+                ],
+            )
