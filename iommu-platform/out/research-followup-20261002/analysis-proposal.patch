+    def test_dst_probe_first_refill_before_src_probe_is_not_a_false_alarm(self):
+        # Observed order on the board: the dst target is probed first, a dst refill
+        # is committed, and only then is the src target probed.  The presence-change
+        # check must use each target's own probe time, so the later src probe's view
+        # of the dst target must not be reported as "changed with no update record".
+        warm = {0: self.t0, 1: self.t1, 5: self.other}
+        deadline = dict(warm)
+        refill = {"ts": 5_010_040, "slot": 1, "old": self.t1, "new": plain(0x700),
+                  "phase": PHASE_PROBE, "did": DID_V}
+        probe_state = {0: apply_events(deadline, [refill]), 1: dict(deadline)}
+        words, mapping = build_e2(
+            targets=self.targets, warm=warm, deadline=deadline,
+            freeze=apply_events(deadline, [refill]), probe_state=probe_state,
+            probe_times=(5_010_060, 5_010_020), events=[refill], astart=10_000,
+            window=5_000_000, a_count=self.case["acount"])
+        evidence, problems, unknowns = self.analyze(words, mapping)
+        self.assertEqual(problems, [])
+        self.assertFalse(any("presence changed" in item for item in unknowns))
+        dst = evidence["targets"][1]
+        self.assertEqual(dst["presence_cross_check"]["own_probe_index"], 1)
+        self.assertTrue(dst["presence_cross_check"]["own_probe_live_bitmap"])
+        self.assertEqual(dst["presence_cross_check"]["probe0_live_bitmap"], 0)
+
