+#define RISCV_IOMMU_RESEARCH_CQ_ERRORS (RISCV_IOMMU_CQCSR_CQMF | \
+	RISCV_IOMMU_CQCSR_CMD_TO | RISCV_IOMMU_CQCSR_CMD_ILL)
+#define RISCV_IOMMU_RESEARCH_CQ_ON (RISCV_IOMMU_CQCSR_CQEN | RISCV_IOMMU_CQCSR_CQON)
+
+int riscv_iommu_research_barrier(struct device *dev0, struct device *dev1,
+				void (*sync_cache)(void *), void *sync_arg,
+				struct riscv_iommu_research_certificate *cert)
+{
+	struct riscv_iommu_endpoint *ep0, *ep1, *first, *second;
+	struct riscv_iommu_device *iommu;
+	struct riscv_iommu_command cmd[5], *ring;
+	unsigned long flags;
+	unsigned long fresh_page;
+	cycles_t start;
+	u64 cqb, value, posted;
+	u32 count, mask, head, tail, end, ctrl, token, i;
+	s64 error_seq;
+	int ret = -EIO;
+
+	if (!sync_cache || !cert)
+		return -EINVAL;
+	memset(cert, 0, sizeof(*cert));
+	if (!riscv_iommu_research_supported(dev0, dev1))
+		return -EOPNOTSUPP;
+	/* Allocation before locks; never share the 8-byte cell with another user. */
+	fresh_page = get_zeroed_page(GFP_KERNEL);
+	if (!fresh_page)
+		return -ENOMEM;
+	ep0 = riscv_iommu_hpm_endpoint(dev0);
+	ep1 = riscv_iommu_hpm_endpoint(dev1);
+	iommu = ep0->iommu;
+	first = ep0->devid < ep1->devid ? ep0 : ep1;
+	second = first == ep0 ? ep1 : ep0;
+	mutex_lock(&first->lock);
+	mutex_lock_nested(&second->lock, SINGLE_DEPTH_NESTING);
+	if (!riscv_iommu_research_ep_ok(ep0) ||
+	    !riscv_iommu_research_ep_ok(ep1) || ep1->iommu != iommu)
+		goto unlock_endpoints;
+	/* Core and endpoint identities must agree even on the restored default. */
+	if (!ep0->domain || !ep1->domain ||
+	    iommu_get_domain_for_dev(dev0) != &ep0->domain->domain ||
+	    iommu_get_domain_for_dev(dev1) != &ep1->domain->domain)
+		goto unlock_endpoints;
+
+	spin_lock_irqsave(&iommu->cq_lock, flags);
+	if (iommu->research_cq_owned || iommu->research_cq_poisoned) {
+		ret = -EBUSY;
+		goto unlock_cq;
+	}
+	count = iommu->cmdq.cnt;
+	if (!iommu->cmdq.base || iommu->cmdq.in_iomem || count < 8 ||
+	    !is_power_of_2(count) || iommu->cmdq.lui >= count)
+		goto unlock_cq;
+	mask = count - 1;
+	cqb = riscv_iommu_readq(iommu, RISCV_IOMMU_REG_CQB);
+	if (FIELD_GET(RISCV_IOMMU_QUEUE_SIZE_FIELD, cqb) >= 31 ||
+	    (1ULL << (FIELD_GET(RISCV_IOMMU_QUEUE_SIZE_FIELD, cqb) + 1)) != count ||
+	    ppn_to_phys(cqb) != iommu->cmdq.base_dma)
+		goto unlock_cq;
+	ctrl = riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQCSR);
+	if ((ctrl & RISCV_IOMMU_RESEARCH_CQ_ON) != RISCV_IOMMU_RESEARCH_CQ_ON ||
+	    (ctrl & (RISCV_IOMMU_RESEARCH_CQ_ERRORS | RISCV_IOMMU_CQCSR_BUSY)))
+		goto unlock_cq;
+	head = riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQH);
+	tail = riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQT);
+	if (head >= count || tail != iommu->cmdq.lui ||
+	    (iommu->cq_posted & mask) != tail ||
+	    ((head - tail - 1) & mask) < ARRAY_SIZE(cmd)) {
+		ret = -EBUSY;
+		goto unlock_cq;
+	}
+	if (iommu->research_token == U32_MAX || iommu->research_epoch == U64_MAX ||
+	    iommu->cq_posted > U64_MAX - ARRAY_SIZE(cmd)) {
+		ret = -EOVERFLOW;
+		goto unlock_cq;
+	}
+	if (!iommu->research_marker) {
+		iommu->research_marker = (void *)fresh_page;
+		fresh_page = 0;
+	}
+	token = ++iommu->research_token;
+	error_seq = atomic64_read(&iommu->cq_error_seq);
+	posted = iommu->cq_posted;
+	iommu->research_cq_owned = true;
+	spin_unlock_irqrestore(&iommu->cq_lock, flags);
+
+	riscv_iommu_cmd_iodir_inval_ddt(&cmd[0]);
+	riscv_iommu_cmd_iodir_set_did(&cmd[0], 10);
+	riscv_iommu_cmd_iodir_inval_ddt(&cmd[1]);
+	riscv_iommu_cmd_iodir_set_did(&cmd[1], 11);
+	/* All host first-stage entries, including global entries. */
+	riscv_iommu_cmd_inval_vma(&cmd[2]);
+	riscv_iommu_cmd_iofence_set_av(&cmd[3],
+					virt_to_phys(iommu->research_marker), token);
+	riscv_iommu_cmd_iofence(&cmd[4]);
+	WRITE_ONCE(*(u64 *)iommu->research_marker, cpu_to_le64(~(u64)token));
+	ring = iommu->cmdq.base;
+	for (i = 0; i < ARRAY_SIZE(cmd); i++)
+		ring[(tail + i) & mask] = cmd[i];
+	/* Accepted cache profile must make DC/PTE/commands/marker visible first. */
+	sync_cache(sync_arg);
+	wmb();
+	end = (tail + ARRAY_SIZE(cmd)) & mask;
+	spin_lock_irqsave(&iommu->cq_lock, flags);
+	iommu->cmdq.lui = end;
+	iommu->cq_posted += ARRAY_SIZE(cmd);
+	riscv_iommu_writel(iommu, RISCV_IOMMU_REG_CQT, end);
+	spin_unlock_irqrestore(&iommu->cq_lock, flags);
+
+	start = get_cycles();
+	for (;;) {
+		sync_cache(sync_arg);
+		value = le64_to_cpu(READ_ONCE(*(u64 *)iommu->research_marker));
+		rmb();
+		head = riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQH);
+		ctrl = riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQCSR);
+		if ((ctrl & RISCV_IOMMU_RESEARCH_CQ_ON) != RISCV_IOMMU_RESEARCH_CQ_ON ||
+		    (ctrl & RISCV_IOMMU_RESEARCH_CQ_ERRORS) ||
+		    atomic64_read(&iommu->cq_error_seq) != error_seq ||
+		    riscv_iommu_readq(iommu, RISCV_IOMMU_REG_CQB) != cqb ||
+		    riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQT) != end) {
+			ret = -EIO;
+			break;
+		}
+		if (value == (u64)token && head == end) {
+			ret = 0;
+			break;
+		}
+		if (get_cycles() - start > RISCV_IOMMU_TIMEOUT) {
+			ret = -ETIMEDOUT;
+			break;
+		}
+		cpu_relax();
+	}
+	spin_lock_irqsave(&iommu->cq_lock, flags);
+	/* Keep error recovery excluded through the last acceptance observation. */
+	ctrl = riscv_iommu_readl(iommu, RISCV_IOMMU_REG_CQCSR);
+	if (!ret && ((ctrl & RISCV_IOMMU_RESEARCH_CQ_ERRORS) ||
+	    (ctrl & RISCV_IOMMU_RESEARCH_CQ_ON) != RISCV_IOMMU_RESEARCH_CQ_ON ||
+	    atomic64_read(&iommu->cq_error_seq) != error_seq))
+		ret = -EIO;
+	if (ret)
+		iommu->research_cq_poisoned = true;
+	else
+		WRITE_ONCE(iommu->research_epoch, iommu->research_epoch + 1);
+	cert->epoch = iommu->research_epoch;
+	cert->posted = posted;
+	cert->cqb = cqb;
+	cert->marker_phys = virt_to_phys(iommu->research_marker);
+	cert->marker_value = value;
+	cert->token = token;
+	cert->first = tail;
+	cert->head = head;
+	cert->count = count;
+	cert->cqcsr = ctrl;
+	iommu->research_cq_owned = false;
+unlock_cq:
+	spin_unlock_irqrestore(&iommu->cq_lock, flags);
+unlock_endpoints:
+	mutex_unlock(&second->lock);
+	mutex_unlock(&first->lock);
+	if (fresh_page)
+		free_page(fresh_page);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(riscv_iommu_research_barrier);
