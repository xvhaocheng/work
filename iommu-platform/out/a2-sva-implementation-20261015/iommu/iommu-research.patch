+#ifndef _LINUX_RISCV_IOMMU_RESEARCH_H
+#define _LINUX_RISCV_IOMMU_RESEARCH_H
+
+#include <linux/types.h>
+#include <linux/kconfig.h>
+#include <linux/err.h>
+#include <linux/errno.h>
+
+struct device;
+struct iommu_domain;
+struct mm_struct;
+
+struct riscv_iommu_research_certificate {
+	u64 epoch;
+	u64 posted;
+	u64 cqb;
+	u64 marker_phys;
+	u64 marker_value;
+	u32 token;
+	u32 first;
+	u32 head;
+	u32 count;
+	u32 cqcsr;
+};
