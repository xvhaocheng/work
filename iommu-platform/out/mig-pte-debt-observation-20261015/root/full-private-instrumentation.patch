@@ -0,0 +1,86 @@
+// PRIVATE passive readback mailbox. No AXI ready/valid outputs.
+// Bundled index/data stay stable until the synchronized toggle is acknowledged.
+module mig_capture_cdc (
+  input logic src_clk_i, src_rst_ni,
+  input logic [12:0] index_i,
+  input logic invalidate_i, arm_i, open_i, close_i,
+  output logic [63:0] data_o, status_o,
+  input logic dst_clk_i, dst_rst_ni,
+  output logic arm_o, window_o,
+  output logic rd_req_o,
+  output logic [11:0] rd_index_o,
+  input logic rd_valid_i,
+  input logic [63:0] rd_data_i
+);
+  logic request_q, response_q, pending_q, valid_q;
+  logic [11:0] index_hold_q, cached_index_q;
+  logic [63:0] result_hold_q, cached_data_q;
+  logic arm_toggle_q, window_q;
+  (* ASYNC_REG = "TRUE" *) logic req_meta_q, req_sync_q;
+  (* ASYNC_REG = "TRUE" *) logic rsp_meta_q, rsp_sync_q;
+  (* ASYNC_REG = "TRUE" *) logic arm_meta_q, arm_sync_q;
+  (* ASYNC_REG = "TRUE" *) logic win_meta_q, win_sync_q;
+  logic req_seen_q, arm_seen_q, waiting_q;
+  wire query = index_i >= 13'h1000 && index_i < 13'h1e00;
+  assign data_o = valid_q && cached_index_q == index_i[11:0] ? cached_data_q : '0;
+  always_comb begin
+    status_o = '0;
+    status_o[0] = valid_q;
+    status_o[1] = pending_q;
+    status_o[27:16] = cached_index_q;
+    status_o[63:32] = 32'h4d434301;
+  end
+  always_ff @(posedge src_clk_i or negedge src_rst_ni) begin
+    if (!src_rst_ni) begin
+      request_q <= 0; pending_q <= 0; valid_q <= 0;
+      index_hold_q <= 0; cached_index_q <= 0; cached_data_q <= 0;
+      rsp_meta_q <= 0; rsp_sync_q <= 0;
+      arm_toggle_q <= 0; window_q <= 0;
+    end else begin
+      rsp_meta_q <= response_q;
+      rsp_sync_q <= rsp_meta_q;
+      if (arm_i) begin arm_toggle_q <= !arm_toggle_q; window_q <= 0; end
+      if (open_i) window_q <= 1;
+      if (close_i) window_q <= 0;
+      if (invalidate_i) valid_q <= 0;
+      if (pending_q && rsp_sync_q == request_q) begin
+        cached_data_q <= result_hold_q;
+        cached_index_q <= index_hold_q;
+        valid_q <= 1;
+        pending_q <= 0;
+      end
+      if (query && !pending_q && (!valid_q || cached_index_q != index_i[11:0])) begin
+        index_hold_q <= index_i[11:0];
+        request_q <= !request_q;
+        pending_q <= 1;
+        valid_q <= 0;
+      end
+    end
+  end
+  always_ff @(posedge dst_clk_i or negedge dst_rst_ni) begin
+    if (!dst_rst_ni) begin
+      req_meta_q <= 0; req_sync_q <= 0; req_seen_q <= 0;
+      response_q <= 0; waiting_q <= 0; result_hold_q <= 0;
+      arm_meta_q <= 0; arm_sync_q <= 0; arm_seen_q <= 0;
+      win_meta_q <= 0; win_sync_q <= 0;
+      arm_o <= 0; window_o <= 0; rd_req_o <= 0; rd_index_o <= 0;
+    end else begin
+      req_meta_q <= request_q; req_sync_q <= req_meta_q;
+      arm_meta_q <= arm_toggle_q; arm_sync_q <= arm_meta_q;
+      arm_seen_q <= arm_sync_q; arm_o <= arm_sync_q != arm_seen_q;
+      win_meta_q <= window_q; win_sync_q <= win_meta_q; window_o <= win_sync_q;
+      rd_req_o <= 0;
+      if (req_sync_q != req_seen_q && !waiting_q) begin
+        rd_index_o <= index_hold_q;
+        rd_req_o <= 1;
+        waiting_q <= 1;
+        req_seen_q <= req_sync_q;
+      end
+      if (waiting_q && rd_valid_i) begin
+        result_hold_q <= rd_data_i;
+        response_q <= req_seen_q;
+        waiting_q <= 0;
+      end
+    end
+  end
+endmodule
--- a/corev_apu/fpga/src/mig_read_debt_observer.sv
+++ b/corev_apu/fpga/src/mig_read_debt_observer.sv
@@ -0,0 +1,554 @@
+// SPDX-License-Identifier: Solderpad-0.51
+// PRIVATE passive observer. Every input is in the actual MIG ui_clk domain.
+// No observer output may drive an AXI handshake, scheduler or memory request.
+module mig_read_debt_observer #(
+  parameter int unsigned LiveSlots = 32,
+  parameter int unsigned EventDepth = 1536
+) (
+  input logic clk_i, rst_ni,
+  input logic epoch_start_i, known_empty_i, calibrated_i,
+  input logic [31:0] epoch_i,
+  input logic arm_i, window_i, abort_i, external_loss_i,
+  input logic ar_eligible_i,
+  input logic arvalid_i, arready_i,
+  input logic [5:0] arid_i,
+  input logic [29:0] araddr_i,
+  input logic [7:0] arlen_i,
+  input logic [2:0] arsize_i,
+  input logic [1:0] arburst_i,
+  input logic rvalid_i, rready_i,
+  input logic [5:0] rid_i,
+  input logic rlast_i,
+  input logic [1:0] rresp_i,
+  input logic [63:0] rdata_i,
+  input logic rd_req_i,
+  input logic [11:0] rd_index_i,
+  output logic rd_valid_o,
+  output logic [63:0] rd_data_o,
+  output logic selected_toggle_o,
+  output logic selected_o, frozen_o,
+  output logic [31:0] errors_o
+);
+  localparam logic [63:0] Magic = 64'h4d49474445425402;
+  localparam int EventBase = 'h200;
+  localparam int EventIndexW = $clog2(EventDepth);
+  localparam int SlotWidth = LiveSlots > 1 ? $clog2(LiveSlots) : 1;
+  typedef struct packed {
+    logic valid;
+    logic [5:0] id;
+    logic [29:0] addr;
+    logic [7:0] len;
+    logic [2:0] size;
+    logic [1:0] burst;
+    logic [31:0] ordinal, rid_occ;
+    logic [8:0] remaining;
+    logic [63:0] t_ar, held;
+  } live_t;
+  typedef struct packed {
+    logic valid, completed;
+    logic [5:0] id;
+    logic [29:0] addr;
+    logic [7:0] len;
+    logic [2:0] size;
+    logic [1:0] burst;
+    logic [31:0] ordinal, rid_occ;
+    logic [8:0] at_p, remaining;
+    logic [63:0] t_ar;
+    logic [31:0] fires_after_p;
+  } pred_t;
+  typedef struct packed {
+    logic tracking, calibration_seen, armed, window_seen, window_closed, window_prev;
+    logic selected, episode_done, frozen, selected_toggle;
+    logic p_first_valid, p_first_fire, p_last;
+    logic [31:0] errors, epoch, ordinal, head_ordinal;
+    logic [SlotWidth-1:0] head, tail;
+    logic [5:0] occupancy;
+    logic [13:0] total_debt;
+    logic [63:0] tick, start_tick, open_tick, close_tick, freeze_tick;
+    logic [63:0] accepted, r_fires, eligible;
+    logic [31:0] p_ordinal, p_rid_occ;
+    logic [5:0] p_id;
+    logic [29:0] p_addr;
+    logic [7:0] p_len;
+    logic [2:0] p_size;
+    logic [1:0] p_burst;
+    logic [8:0] p_remaining;
+    logic [63:0] p_t_ar, p_t_valid, p_t_fire, p_t_last, p_held;
+    logic [31:0] pred_count, pred_debt, max_live, event_count;
+    logic [18:0] pending_held;
+    logic [31:0] frozen_errors, frozen_max_live, frozen_ordinal;
+    logic [63:0] frozen_accepted, frozen_r_fires;
+    logic [63:0] held_cycles, no_valid_cycles;
+    logic ar_held, r_held;
+    logic [48:0] held_ar;
+    logic [72:0] held_r;
+  } state_t;
+  state_t q, n;
+  live_t live_q [LiveSlots], live_n [LiveSlots];
+  pred_t pred_q [LiveSlots], pred_n [LiveSlots];
+  logic [31:0] rid_occ_q [64], rid_occ_n [64];
+  (* ram_style = "block" *) logic [127:0] event_mem [EventDepth];
+  (* ram_style = "block" *) logic [127:0] completion_mem [LiveSlots];
+  logic completion_we, rd_completion_q, completion_valid_q;
+  logic [127:0] completion_wdata, completion_rdata_q;
+  logic r_id_match;
+  logic event_we;
+  logic [EventIndexW-1:0] event_waddr;
+  logic [127:0] event_wdata, event_rdata_q;
+  logic [63:0] static_data, static_data_q;
+  logic [63:0] pred_word [LiveSlots];
+  logic [63:0] pred_group_q [4];
+  logic [1:0] rd_group_q;
+  logic [4:0] pred_read_slot;
+  logic rd_event_q, rd_half_q, rd_pred_q, rd_pending_q;
+  logic ar_fire, r_fire, select_now;
+  int rslot, free_slot;
+  logic [48:0] ar_tuple;
+  logic [72:0] r_tuple;
+  assign ar_fire = arvalid_i && arready_i;
+  assign r_fire = rvalid_i && rready_i;
+  assign ar_tuple = {arburst_i, arsize_i, arlen_i, arid_i, araddr_i};
+  assign r_tuple = {rdata_i, rresp_i, rlast_i, rid_i};
+  assign selected_o = q.selected;
+  assign frozen_o = q.frozen;
+  assign selected_toggle_o = q.selected_toggle;
+  assign errors_o = q.frozen ? q.frozen_errors : q.errors;
+  assign pred_read_slot = 5'((int'(rd_index_i)-32)/8);
+
+  initial begin
+    assert (LiveSlots > 0 && LiveSlots <= 32);
+    assert (EventDepth >= 2 && EventDepth <= 1536);
+  end
+
+  // This private monitor binds the already verified generated MIG NORM AXI
+  // service, whose accepted reads retire in global FIFO order. Validate that
+  // invariant at every RVALID; a different RID at the head invalidates capture.
+  // This is not a generic AXI out-of-order monitor or a new service policy.
+  always_comb begin
+    n = q;
+    for (int i = 0; i < LiveSlots; i++) begin
+      live_n[i] = live_q[i];
+      pred_n[i] = pred_q[i];
+    end
+    for (int i = 0; i < 64; i++) rid_occ_n[i] = rid_occ_q[i];
+    completion_we = 0;
+    completion_wdata = '0;
+    r_id_match = 0;
+    event_we = 0;
+    event_waddr = EventIndexW'(q.event_count);
+    event_wdata = '0;
+    rslot = -1;
+    free_slot = -1;
+    select_now = q.tracking && q.armed && !q.frozen && !q.selected &&
+                 window_i && ar_fire && ar_eligible_i;
+
+    // A later ARM never clears accepted transactions or sticky track errors.
+    // epoch_start is accepted only once after the real MIG aresetn release,
+    // before any AR/R. Start before calibration so the first calibrated AR
+    // cannot escape. Calibration completion is a separate monotonic condition.
+    if (epoch_start_i) begin
+      if (!q.tracking && known_empty_i && !ar_fire && !rvalid_i) begin
+        n.tracking = 1;
+        n.calibration_seen = calibrated_i;
+        n.epoch = epoch_i;
+        n.head_ordinal = 1;
+        n.start_tick = q.tick;
+      end else n.errors[0] = 1;
+    end
+    if (q.tracking) begin
+      n.tick = q.tick + 1;
+      // Every 64-bit event/held counter starts at zero in this epoch (or
+      // later) and increments at most once per UI edge, hence cannot wrap
+      // before tick. Per-read fires_after_p is bounded by LEN+1 <= 256;
+      // length/RLAST checking retires that occurrence. Independent 32-bit
+      // accepted ordinals/occurrences retain their explicit overflow checks.
+      if (&q.tick) n.errors[6] = 1;
+      if (calibrated_i) n.calibration_seen = 1;
+      if ((q.calibration_seen && !calibrated_i) || epoch_i != q.epoch ||
+          (!calibrated_i && (ar_fire || rvalid_i))) n.errors[1] = 1;
+      if (external_loss_i) n.errors[9] = 1;
+
+      if (arm_i) begin
+        if (!calibrated_i) n.errors[1] = 1;
+        if (window_i || (q.armed && !q.frozen)) n.errors[10] = 1;
+        n.armed = 1;
+        n.window_seen = 0;
+        n.window_closed = 0;
+        n.window_prev = 0;
+        n.selected = 0;
+        n.episode_done = 0;
+        n.frozen = 0;
+        n.p_first_valid = 0;
+        n.p_first_fire = 0;
+        n.p_last = 0;
+        n.open_tick = 0;
+        n.close_tick = 0;
+        n.freeze_tick = 0;
+        n.eligible = 0;
+        n.p_ordinal = 0;
+        n.p_rid_occ = 0;
+        n.p_id = 0;
+        n.p_addr = 0;
+        n.p_len = 0;
+        n.p_size = 0;
+        n.p_burst = 0;
+        n.p_remaining = 0;
+        n.p_t_ar = 0;
+        n.p_t_valid = 0;
