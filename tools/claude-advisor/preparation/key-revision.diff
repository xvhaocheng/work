+def _is_table_header(line: str) -> bool:
+    stripped = line.strip()
+    if not stripped or stripped.startswith('#'):
+        return False
+    return stripped.startswith('[') and stripped.endswith(']')
+
+
+TIMEOUT_KEY_RE = re.compile(r'^(tool_timeout_sec|startup_timeout_sec)\s*=')
+
+
+def _timeout_key(line: str) -> Optional[str]:
+    stripped = line.lstrip()
+    if stripped.startswith('#'):
+        return None
+    match = TIMEOUT_KEY_RE.match(stripped)
+    return match.group(1) if match else None
+
+
+def render_server_timeouts(text: str, tool_timeout: int, startup_timeout: int) -> Optional[str]:
+    '''Return text with the two MCP timeouts set, or None when unsafe.
+
+    Only the exact, unique table header written by the Codex CLI
+    ([mcp_servers.claude-advisor], quoted or not) is accepted; every other
+    byte of the file, including all other tables and comments, is preserved.
+    A missing or ambiguous header returns None so the caller reports pending
+    instead of guessing at a string that merely looks like a table.
+    '''
+    lines = text.splitlines(keepends=True)
+    headers = [index for index, line in enumerate(lines) if line.strip() in MCP_TABLE_HEADERS]
+    if len(headers) != 1:
+        return None
+    header = headers[0]
+    end = len(lines)
+    for index in range(header + 1, len(lines)):
+        if _is_table_header(lines[index]):
+            end = index
+            break
+    head = lines[header]
+    if not head.endswith('\n'):
+        head = head + '\n'
+    wanted = [('tool_timeout_sec', tool_timeout), ('startup_timeout_sec', startup_timeout)]
+    body = [key + ' = ' + str(value) + '\n' for key, value in wanted]
+    for line in lines[header + 1:end]:
+        if _timeout_key(line) is not None:
+            continue
+        body.append(line)
+    return ''.join([head] + body + lines[end:])
+
+
+def write_server_timeouts(config_path: Path) -> None:
+    '''Atomically persist the MCP timeouts, preserving every other setting.'''
+    try:
+        info = config_path.lstat()
+    except FileNotFoundError:
+        raise InstallerError('mcp_config_error', '未找到 Codex 配置文件；超时配置待人工完成。')
+    except OSError:
+        raise InstallerError('mcp_config_error', '无法检查 Codex 配置文件。')
+    if stat.S_ISLNK(info.st_mode):
+        raise InstallerError('mcp_config_error', 'Codex 配置文件是符号链接，已拒绝写入。')
+    if not stat.S_ISREG(info.st_mode):
+        raise InstallerError('mcp_config_error', 'Codex 配置文件不是普通文件，已拒绝写入。')
+    uid = current_uid()
+    if uid is not None and info.st_uid != uid:
+        raise InstallerError('mcp_config_error', 'Codex 配置文件不属于当前用户，已拒绝写入。')
+    try:
+        text = config_path.read_text(encoding='utf-8')
+    except (OSError, UnicodeDecodeError):
+        raise InstallerError('mcp_config_error', '无法读取 Codex 配置文件。')
+    rendered = render_server_timeouts(text, MCP_TOOL_TIMEOUT_SEC, MCP_STARTUP_TIMEOUT_SEC)
+    if rendered is None:
+        raise InstallerError('mcp_config_error', '未能唯一定位 claude-advisor 配置表，未做任何猜测写入。')
+    if rendered == text:
+        return
+    mode = stat.S_IMODE(info.st_mode) or 0o600
+    atomic_write_bytes(config_path, rendered.encode('utf-8'), mode)
+
