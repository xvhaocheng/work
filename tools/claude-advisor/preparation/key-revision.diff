+def codex_config_path() -> Path:
+    '''~/.codex/config.toml: where the Codex CLI keeps MCP server entries.'''
+    try:
+        home = Path.home()
+    except (RuntimeError, OSError):
+        raise InstallerError('mcp_config_error', '无法确定 Codex 配置目录。')
+    return home / '.codex' / 'config.toml'
+
