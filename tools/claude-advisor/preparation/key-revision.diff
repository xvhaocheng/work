+def mcp_entry_matches_bridge(entry: Dict[str, Any]) -> bool:
+    transport = entry.get('transport')
+    if not isinstance(transport, dict):
+        return False
+    expected = expected_transport()
+    if transport.get('command') != expected['command']:
+        return False
+    args = transport.get('args')
+    if not isinstance(args, list):
+        return False
+    return [str(item) for item in args] == expected['args']
+
+
+def _is_number(value: Any) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def mcp_entry_timeouts_ok(entry: Dict[str, Any]) -> bool:
+    tool = entry.get('tool_timeout_sec')
+    startup = entry.get('startup_timeout_sec')
+    return (
+        _is_number(tool) and tool >= MCP_TOOL_TIMEOUT_SEC
+        and _is_number(startup) and startup >= MCP_STARTUP_TIMEOUT_SEC
+    )
+
+
+def mcp_entry_enabled(entry: Dict[str, Any]) -> bool:
+    return entry.get('enabled') is not False
+
+
+def mcp_not_found(result: Optional[subprocess.CompletedProcess]) -> bool:
+    '''True only for the known no-such-server error reported on stderr.'''
+    if result is None or result.returncode == 0:
+        return False
+    stderr = result.stderr if isinstance(result.stderr, str) else ''
+    return MCP_NOT_FOUND_MARKER in stderr.lower()
+
+
+def get_mcp_entry() -> Optional[Dict[str, Any]]:
