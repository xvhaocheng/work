+def assert_no_symlink_components(directory: Path) -> None:
+    '''Reject an absolute directory path whose existing parts include a symlink.
+
+    The walk is lexical: the path is never resolved first, so a symlink is
+    still observable when it is inspected. Parts that do not exist yet are
+    created later by mkdir(), and the whole chain is re-checked straight after
+    that creation.
+    '''
+    if not directory.is_absolute():
+        raise InstallerError('bad_key_dir', '密钥目录必须是绝对路径。')
+    current = Path(directory.parts[0])
+    for part in directory.parts[1:]:
+        current = current / part
+        try:
+            info = current.lstat()
+        except FileNotFoundError:
+            return
+        except OSError:
+            raise InstallerError('bad_key_dir', '无法检查密钥目录的上级路径。')
