+def parse_mcp_get(result: Optional[subprocess.CompletedProcess]) -> Optional[Dict[str, Any]]:
+    '''Parse codex mcp get <NAME> --json output; the output is never echoed.'''
+    if result is None or result.returncode != 0:
+        return None
+    stdout = result.stdout if isinstance(result.stdout, str) else ''
+    try:
+        data = json.loads(stdout)
+    except ValueError:
+        return None
+    return data if isinstance(data, dict) else None
+
