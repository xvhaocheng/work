+def expected_transport() -> Dict[str, Any]:
+    '''The exact key-free transport this bridge must be registered with.'''
+    return {
+        'command': PYTHON_BIN,
+        'args': [str(BRIDGE_PATH), '--serve', '--config', str(CONFIG_PATH)],
+    }
+
