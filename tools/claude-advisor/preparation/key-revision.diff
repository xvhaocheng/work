+def write_timeouts_and_recheck() -> Tuple[bool, List[str]]:
+    '''Persist the timeouts, then re-check with the CLI before claiming done.'''
+    try:
+        write_server_timeouts(codex_config_path())
+    except InstallerError:
+        return False, [MCP_TIMEOUT_PENDING]
+    entry = get_mcp_entry()
+    if (
+        entry is None
+        or not mcp_entry_matches_bridge(entry)
+        or not mcp_entry_enabled(entry)
+        or not mcp_entry_timeouts_ok(entry)
+    ):
+        return False, [MCP_TIMEOUT_PENDING]
+    return True, [MCP_REGISTERED_OK]
+
