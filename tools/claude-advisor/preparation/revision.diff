+class ExplicitInvocationTests(BaseCase):
+    def test_missing_user_request_raises_before_config_key_or_opener(self):
+        opener = FakeOpener(payload=_message_payload())
+        with mock.patch.object(bridge, 'load_config') as load_config_mock, \
+             mock.patch.object(bridge, 'load_api_key') as load_api_key_mock:
+            with self.assertRaises(bridge.BridgeError) as ctx:
+                bridge.run_consult(
+                    Path('absent-config.json'), 'x', 'review', None, None, None,
+                    opener=opener,
+                )
+        self.assertEqual(ctx.exception.category, 'explicit_invocation_required')
+        self.assertEqual(load_config_mock.call_count, 0)
+        self.assertEqual(load_api_key_mock.call_count, 0)
+        self.assertEqual(opener.requests, [])
+
