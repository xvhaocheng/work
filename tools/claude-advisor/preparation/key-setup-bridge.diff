+def validate_effort(value: Any) -> List[str]:
+    '''Return errors unless effort is null or one of EFFORT_LEVELS.
+
+    The rejected value is never echoed back: the error only lists the allowed
+    levels, so an illegal input can never be reflected into a report.
+    '''
+    if value is None:
+        return []
+    if not isinstance(value, str) or value not in EFFORT_LEVELS:
+        return ['effort must be null or one of: ' + ', '.join(EFFORT_LEVELS)]
+    return []
+
